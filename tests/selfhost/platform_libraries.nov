module platform_libraries;
import ../../lib/std;
import ../../lib/file_io;
import ../../lib/process;

fn main(argc: i32, argv: u64) -> i32 {
    if (argc != 2) { return 1; }
    let folder: str = "build/library-test/nested";
    if (create_directories(folder) != "") { return 2; }
    let path: str = path_join_all([folder, "binary data.bin"]);
    let bytes: ByteBuffer = new ByteBuffer();
    for (let i: i32 = 0; i < 33000; i++) { bytes.append(i % 256); }
    if (write_all_bytes(path, bytes) != "") { return 3; }
    let read: FileReadResult = read_all_bytes(path);
    if (read.error != "" || !bytes.equals(read.data)) { return 4; }
    let info: FileInfo = file_info(path);
    if (!info.exists || info.directory || info.size != 33000) { return 5; }
    if (!file_info(folder).directory || file_info(path + ".missing").exists) { return 6; }
    let resolved: PathResult = canonical_path(path);
    if (resolved.error != "" || !file_info(resolved.path).exists) { return 7; }
    let cwd: PathResult = working_directory();
    if (cwd.error != "" || !file_info(cwd.path).directory) { return 8; }
    let started: i64 = get_time_ns();
    let process: ProcessCommand = process_command(argv_get(argv, 1), ["space in argument", "quote\"and\\slash\\", "", "semicolon; dollar$ ampersand&"]);
    let result: ProcessResult = command_run(process, true);
    if (result.status != 23 || result.error == "") { print(result.error); return 9; }
    if (len(result.output) != 85000 || !starts_with(result.output, "0123456789abcdef\n")) { return 10; }
    if (get_time_ns() < started) { return 11; }
    if (file_delete(path) != 0 || file_info(path).exists) { return 12; }
    print("platform libraries passed");
    return 0;
}

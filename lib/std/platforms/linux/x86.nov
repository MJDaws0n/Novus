// ---------------------------------------------------------------------------
// std/linux_x86 - Linux i386 platform layer
// Linux syscall convention: eax=syscall#, ebx/ecx/edx/esi/edi/ebp=args
// ---------------------------------------------------------------------------

module std_linux_x86;

import ../../core/core;

fn i32_to_u64(val: i32) -> u64 {
    mov(eax, val);
    let low: u64 = getreg(eax);
    if (val < 0) { return low | 18446744069414584320; }
    return low;
}

fn i64_to_u64(val: i64) -> u64 {
    let lo: i32 = load32(&val);
    let hi: i32 = load32(&val + 4);
    mov(eax, lo); let low: u64 = getreg(eax);
    mov(eax, hi); let high: u64 = getreg(eax);
    return low | (high << 32);
}

fn u64_to_i64(val: u64) -> i64 { return load64(&val); }

fn array_len(arr: []i32) -> i32 {
    mov(ebx, arr);
    let hdr: u64 = getreg(ebx);
    return load32(hdr + 4);
}

fn array_len_u64(arr: []u64) -> i32 {
    mov(ebx, arr);
    let hdr: u64 = getreg(ebx);
    return load32(hdr + 4);
}

fn array_len_str(arr: []str) -> i32 {
    mov(ebx, arr);
    let hdr: u64 = getreg(ebx);
    return load32(hdr + 4);
}

fn array_len_i64(arr: []i64) -> i32 {
    mov(ebx, arr);
    let hdr: u64 = getreg(ebx);
    return load32(hdr + 4);
}

fn array_len_u32(arr: []u32) -> i32 {
    mov(ebx, arr);
    let hdr: u64 = getreg(ebx);
    return load32(hdr + 4);
}

fn array_len_bool(arr: []bool) -> i32 {
    mov(ebx, arr);
    let hdr: u64 = getreg(ebx);
    return load32(hdr + 4);
}

fn array_len_f32(arr: []f32) -> i32 {
    mov(ebx, arr);
    let hdr: u64 = getreg(ebx);
    return load32(hdr + 4);
}

fn array_len_f64(arr: []f64) -> i32 {
    mov(ebx, arr);
    let hdr: u64 = getreg(ebx);
    return load32(hdr + 4);
}

fn array_data_ptr_i32(arr: []i32) -> i64 {
    mov(ebx, arr);
    let hdr: u64 = getreg(ebx);
    return u64_to_i64(i32_to_u64(load32(hdr)) & 4294967295);
}

fn array_data_ptr_str(arr: []str) -> i64 {
    mov(ebx, arr);
    let hdr: u64 = getreg(ebx);
    return u64_to_i64(i32_to_u64(load32(hdr)) & 4294967295);
}

fn array_data_ptr_i64(arr: []i64) -> i64 {
    mov(ebx, arr);
    let hdr: u64 = getreg(ebx);
    return u64_to_i64(i32_to_u64(load32(hdr)) & 4294967295);
}

fn print(msg: str) -> void {
    msg = msg + "\n";
    mov(eax, 4);       // SYS_write
    mov(ebx, 1);       // fd = stdout
    mov(ecx, msg);
    mov(edx, len(msg));
    int(128);
}

fn print_raw(msg: str) -> void {
    mov(eax, 4);       // SYS_write
    mov(ebx, 1);       // fd = stdout
    mov(ecx, msg);
    mov(edx, len(msg));
    int(128);
}

fn exit(code: i32) -> void {
    mov(eax, 1);      // SYS_exit
    mov(ebx, code);
    int(128);
}

fn get_time_ns() -> i64 {
    let buf: str = "0123456789abcdef";
    mov(eax, 403);     // SYS_clock_gettime
    mov(ebx, 0);       // CLOCK_REALTIME
    mov(ecx, buf);
    int(128);
    mov(ebx, buf);
    let base: u64 = getreg(ebx);
    let tv_sec: i64 = load64(base);
    let tv_nsec: i64 = load64(base + 8);
    return tv_sec * 1000000000 + tv_nsec;
}

fn input(prompt: str, buf_len: i32 = 128) -> str {
    mov(eax, 4);
    mov(ebx, 1);
    mov(ecx, prompt);
    mov(edx, len(prompt));
    int(128);
    let buf: str = "";
    while(len(buf) < buf_len) {
        buf = buf + " ";
    }
    mov(eax, 3);       // SYS_read
    mov(ebx, 0);       // fd = stdin
    mov(ecx, buf);
    mov(edx, buf_len);
    int(128);
    let nread: i32 = u64_to_i32(getreg(eax));
    let out: str = "";
    let i: i32 = 0;
    while (i < nread) {
        if (buf[i] == '\n') {
            break;
        }
        out = out + buf[i];
        i = i + 1;
    }
    return out;
}

fn ptr(s: str) -> u64 {
    mov(ebx, s);
    return getreg(ebx);
}

fn array_data_ptr_u64(arr: []u64) -> i64 {
    mov(ebx, arr);
    let hdr: u64 = getreg(ebx);
    return u64_to_i64(i32_to_u64(load32(hdr)) & 4294967295);
}

fn execve_raw(path: str, argv: []u64) -> i32 {
    let packed: str = make_buffer(len(argv) * 4);
    let address: u64 = ptr(packed);
    for (let i: i32 = 0; i < len(argv); i++) { store32(address + i32_to_u64(i) * 4, u64_to_i32(argv[i])); }
    let envp_ptr: u64 = __novus_envp;
    mov(ebx, path); mov(ecx, address); mov(edx, envp_ptr); mov(eax, 11);
    int(128);
    return u64_to_i32(getreg(eax));
}

fn fork() -> i32 {
    mov(eax, 2);      // SYS_fork
    int(128);
    return u64_to_i32(getreg(eax));
}

fn spawn_execve(path: str, argv: []u64) -> i32 {
    let pid: i32 = fork();
    if (pid == 0) {
        execve_raw(path, argv);
        exit(1);
        return 1;
    }
    return pid;
}

// ---------------------------------------------------------------------------
// User info: get_home_dir / get_username
// Reads /etc/passwd and matches on current UID (via SYS_getuid)
// ---------------------------------------------------------------------------

fn get_home_dir() -> str {
    // Get current UID
    mov(eax, 199);     // SYS_getuid
    int(128);
    let uid: i32 = u64_to_i32(getreg(eax));
    let uid_str: str = i32_to_str(uid);

    // Open /etc/passwd
    let path: str = "/etc/passwd\0";
    mov(eax, 5);       // SYS_open
    mov(ebx, path);
    mov(ecx, 0);       // O_RDONLY
    mov(edx, 0);
    int(128);
    let fd: i32 = u64_to_i32(getreg(eax));
    if (fd < 0) { return ""; }

    // Read file contents
    let buf: str = "";
    let k: i32 = 0;
    while (k < 4096) { buf = buf + " "; k = k + 1; }
    mov(eax, 3);       // SYS_read
    mov(ebx, fd);
    mov(ecx, buf);
    mov(edx, 4096);
    int(128);
    let nread: i32 = u64_to_i32(getreg(eax));

    // Close file
    mov(eax, 6);       // SYS_close
    mov(ebx, fd);
    int(128);

    if (nread <= 0) { return ""; }

    // Parse /etc/passwd: each line is username:x:uid:gid:gecos:home:shell
    let i: i32 = 0;
    while (i < nread) {
        // Extract current line
        let line_start: i32 = i;
        while (i < nread && buf[i] != '\n') { i = i + 1; }
        let line: str = substr_len(buf, line_start, i - line_start);
        i = i + 1; // skip newline

        // Parse fields separated by ':'
        // Field 0: username, Field 2: uid, Field 5: home
        let field: i32 = 0;
        let field_start: i32 = 0;
        let line_len: i32 = len(line);
        let found_uid: str = "";
        let found_home: str = "";
        let j: i32 = 0;
        while (j <= line_len) {
            if (j == line_len || line[j] == ':') {
                if (field == 2) {
                    found_uid = substr_len(line, field_start, j - field_start);
                }
                if (field == 5) {
                    found_home = substr_len(line, field_start, j - field_start);
                }
                field = field + 1;
                field_start = j + 1;
            }
            j = j + 1;
        }
        if (str_equals(found_uid, uid_str)) {
            return found_home;
        }
    }
    return "";
}

fn get_username() -> str {
    // Get current UID
    mov(eax, 199);     // SYS_getuid
    int(128);
    let uid: i32 = u64_to_i32(getreg(eax));
    let uid_str: str = i32_to_str(uid);

    // Open /etc/passwd
    let path: str = "/etc/passwd\0";
    mov(eax, 5);       // SYS_open
    mov(ebx, path);
    mov(ecx, 0);       // O_RDONLY
    mov(edx, 0);
    int(128);
    let fd: i32 = u64_to_i32(getreg(eax));
    if (fd < 0) { return ""; }

    // Read file contents
    let buf: str = "";
    let k: i32 = 0;
    while (k < 4096) { buf = buf + " "; k = k + 1; }
    mov(eax, 3);       // SYS_read
    mov(ebx, fd);
    mov(ecx, buf);
    mov(edx, 4096);
    int(128);
    let nread: i32 = u64_to_i32(getreg(eax));

    // Close file
    mov(eax, 6);       // SYS_close
    mov(ebx, fd);
    int(128);

    if (nread <= 0) { return ""; }

    // Parse /etc/passwd: each line is username:x:uid:gid:gecos:home:shell
    let i: i32 = 0;
    while (i < nread) {
        let line_start: i32 = i;
        while (i < nread && buf[i] != '\n') { i = i + 1; }
        let line: str = substr_len(buf, line_start, i - line_start);
        i = i + 1;

        let field: i32 = 0;
        let field_start: i32 = 0;
        let line_len: i32 = len(line);
        let found_uid: str = "";
        let found_user: str = "";
        let j: i32 = 0;
        while (j <= line_len) {
            if (j == line_len || line[j] == ':') {
                if (field == 0) {
                    found_user = substr_len(line, field_start, j - field_start);
                }
                if (field == 2) {
                    found_uid = substr_len(line, field_start, j - field_start);
                }
                field = field + 1;
                field_start = j + 1;
            }
            j = j + 1;
        }
        if (str_equals(found_uid, uid_str)) {
            return found_user;
        }
    }
    return "";
}

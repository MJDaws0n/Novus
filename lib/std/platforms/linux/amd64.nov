// ---------------------------------------------------------------------------
// std/linux_amd64 - Linux x86_64 platform layer
// Linux syscall convention: rax=syscall#, rdi/rsi/rdx/r10/r8/r9=args
// ---------------------------------------------------------------------------

module std_linux_amd64;

import ../../core/core;

fn i32_to_u64(val: i32) -> u64 {
    mov(rdi, val);
    return getreg(rdi);
}

fn i64_to_u64(val: i64) -> u64 {
    mov(rdi, val);
    return getreg(rdi);
}

fn u64_to_i64(val: u64) -> i64 { return load64(&val); }

fn array_len(arr: []i32) -> i32 {
    mov(rdi, arr);
    let hdr: u64 = getreg(rdi);
    return load32(hdr + 8);
}

fn array_len_u64(arr: []u64) -> i32 {
    mov(rdi, arr);
    let hdr: u64 = getreg(rdi);
    return load32(hdr + 8);
}

fn array_len_str(arr: []str) -> i32 {
    mov(rdi, arr);
    let hdr: u64 = getreg(rdi);
    return load32(hdr + 8);
}

fn array_len_i64(arr: []i64) -> i32 {
    mov(rdi, arr);
    let hdr: u64 = getreg(rdi);
    return load32(hdr + 8);
}

fn array_len_u32(arr: []u32) -> i32 {
    mov(rdi, arr);
    let hdr: u64 = getreg(rdi);
    return load32(hdr + 8);
}

fn array_len_bool(arr: []bool) -> i32 {
    mov(rdi, arr);
    let hdr: u64 = getreg(rdi);
    return load32(hdr + 8);
}

fn array_len_f32(arr: []f32) -> i32 {
    mov(rdi, arr);
    let hdr: u64 = getreg(rdi);
    return load32(hdr + 8);
}

fn array_len_f64(arr: []f64) -> i32 {
    mov(rdi, arr);
    let hdr: u64 = getreg(rdi);
    return load32(hdr + 8);
}

fn array_data_ptr_i32(arr: []i32) -> i64 {
    mov(rdi, arr);
    let hdr: u64 = getreg(rdi);
    return load64(hdr);
}

fn array_data_ptr_str(arr: []str) -> i64 {
    mov(rdi, arr);
    let hdr: u64 = getreg(rdi);
    return load64(hdr);
}

fn array_data_ptr_i64(arr: []i64) -> i64 {
    mov(rdi, arr);
    let hdr: u64 = getreg(rdi);
    return load64(hdr);
}

fn print(msg: str) -> void {
    msg = msg + "\n";
    mov(rax, 1);       // SYS_write
    mov(rdi, 1);       // fd = stdout
    mov(rsi, msg);
    mov(rdx, len(msg));
    syscall();
}

fn print_raw(msg: str) -> void {
    mov(rax, 1);       // SYS_write
    mov(rdi, 1);       // fd = stdout
    mov(rsi, msg);
    mov(rdx, len(msg));
    syscall();
}

fn exit(code: i32) -> void {
    mov(rax, 60);      // SYS_exit
    mov(rdi, code);
    syscall();
}

fn get_time_ns() -> i64 {
    let buf: str = "0123456789abcdef";
    mov(rax, 228);     // SYS_clock_gettime
    mov(rdi, 0);       // CLOCK_REALTIME
    mov(rsi, buf);
    syscall();
    mov(rdi, buf);
    let base: u64 = getreg(rdi);
    let tv_sec: i64 = load64(base);
    let tv_nsec: i64 = load64(base + 8);
    return tv_sec * 1000000000 + tv_nsec;
}

fn input(prompt: str, buf_len: i32 = 128) -> str {
    mov(rax, 1);
    mov(rdi, 1);
    mov(rsi, prompt);
    mov(rdx, len(prompt));
    syscall();
    let buf: str = "";
    while(len(buf) < buf_len) {
        buf = buf + " ";
    }
    mov(rax, 0);       // SYS_read
    mov(rdi, 0);       // fd = stdin
    mov(rsi, buf);
    mov(rdx, buf_len);
    syscall();
    let nread: i32 = u64_to_i32(getreg(rax));
    let out: str = "";
    let i: i32 = 0;
    while (i < nread) {
        if (buf[i] == '\n') {
            break;
        }
        out = out + buf[i];
        i = i + 1;
    }
    return out;
}

fn ptr(s: str) -> u64 {
    mov(rdi, s);
    return getreg(rdi);
}

fn array_data_ptr_u64(arr: []u64) -> i64 {
    mov(rdi, arr);
    let hdr: u64 = getreg(rdi);
    return load64(hdr);
}

fn execve_raw(path: str, argv: []u64) -> i32 {
    let argv_ptr: i64 = array_data_ptr_u64(argv);
    let envp_ptr: u64 = __novus_envp;
    mov(rax, 59);      // SYS_execve
    mov(rdi, path);
    mov(rsi, argv_ptr);
    mov(rdx, envp_ptr);
    syscall();
    return u64_to_i32(getreg(rax));
}

fn fork() -> i32 {
    mov(rax, 57);      // SYS_fork
    syscall();
    return u64_to_i32(getreg(rax));
}

fn spawn_execve(path: str, argv: []u64) -> i32 {
    let pid: i32 = fork();
    if (pid == 0) {
        execve_raw(path, argv);
        exit(1);
        return 1;
    }
    return pid;
}

// ---------------------------------------------------------------------------
// User info: get_home_dir / get_username
// Reads /etc/passwd and matches on current UID (via SYS_getuid)
// ---------------------------------------------------------------------------

fn get_home_dir() -> str {
    // Get current UID
    mov(rax, 102);     // SYS_getuid
    syscall();
    let uid: i32 = u64_to_i32(getreg(rax));
    let uid_str: str = i32_to_str(uid);

    // Open /etc/passwd
    let path: str = "/etc/passwd\0";
    mov(rax, 2);       // SYS_open
    mov(rdi, path);
    mov(rsi, 0);       // O_RDONLY
    mov(rdx, 0);
    syscall();
    let fd: i32 = u64_to_i32(getreg(rax));
    if (fd < 0) { return ""; }

    // Read file contents
    let buf: str = "";
    let k: i32 = 0;
    while (k < 4096) { buf = buf + " "; k = k + 1; }
    mov(rax, 0);       // SYS_read
    mov(rdi, fd);
    mov(rsi, buf);
    mov(rdx, 4096);
    syscall();
    let nread: i32 = u64_to_i32(getreg(rax));

    // Close file
    mov(rax, 3);       // SYS_close
    mov(rdi, fd);
    syscall();

    if (nread <= 0) { return ""; }

    // Parse /etc/passwd: each line is username:x:uid:gid:gecos:home:shell
    let i: i32 = 0;
    while (i < nread) {
        // Extract current line
        let line_start: i32 = i;
        while (i < nread && buf[i] != '\n') { i = i + 1; }
        let line: str = substr_len(buf, line_start, i - line_start);
        i = i + 1; // skip newline

        // Parse fields separated by ':'
        // Field 0: username, Field 2: uid, Field 5: home
        let field: i32 = 0;
        let field_start: i32 = 0;
        let line_len: i32 = len(line);
        let found_uid: str = "";
        let found_home: str = "";
        let j: i32 = 0;
        while (j <= line_len) {
            if (j == line_len || line[j] == ':') {
                if (field == 2) {
                    found_uid = substr_len(line, field_start, j - field_start);
                }
                if (field == 5) {
                    found_home = substr_len(line, field_start, j - field_start);
                }
                field = field + 1;
                field_start = j + 1;
            }
            j = j + 1;
        }
        if (str_equals(found_uid, uid_str)) {
            return found_home;
        }
    }
    return "";
}

fn get_username() -> str {
    // Get current UID
    mov(rax, 102);     // SYS_getuid
    syscall();
    let uid: i32 = u64_to_i32(getreg(rax));
    let uid_str: str = i32_to_str(uid);

    // Open /etc/passwd
    let path: str = "/etc/passwd\0";
    mov(rax, 2);       // SYS_open
    mov(rdi, path);
    mov(rsi, 0);       // O_RDONLY
    mov(rdx, 0);
    syscall();
    let fd: i32 = u64_to_i32(getreg(rax));
    if (fd < 0) { return ""; }

    // Read file contents
    let buf: str = "";
    let k: i32 = 0;
    while (k < 4096) { buf = buf + " "; k = k + 1; }
    mov(rax, 0);       // SYS_read
    mov(rdi, fd);
    mov(rsi, buf);
    mov(rdx, 4096);
    syscall();
    let nread: i32 = u64_to_i32(getreg(rax));

    // Close file
    mov(rax, 3);       // SYS_close
    mov(rdi, fd);
    syscall();

    if (nread <= 0) { return ""; }

    // Parse /etc/passwd: each line is username:x:uid:gid:gecos:home:shell
    let i: i32 = 0;
    while (i < nread) {
        let line_start: i32 = i;
        while (i < nread && buf[i] != '\n') { i = i + 1; }
        let line: str = substr_len(buf, line_start, i - line_start);
        i = i + 1;

        let field: i32 = 0;
        let field_start: i32 = 0;
        let line_len: i32 = len(line);
        let found_uid: str = "";
        let found_user: str = "";
        let j: i32 = 0;
        while (j <= line_len) {
            if (j == line_len || line[j] == ':') {
                if (field == 0) {
                    found_user = substr_len(line, field_start, j - field_start);
                }
                if (field == 2) {
                    found_uid = substr_len(line, field_start, j - field_start);
                }
                field = field + 1;
                field_start = j + 1;
            }
            j = j + 1;
        }
        if (str_equals(found_uid, uid_str)) {
            return found_user;
        }
    }
    return "";
}

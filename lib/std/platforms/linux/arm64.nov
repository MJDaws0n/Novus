// ---------------------------------------------------------------------------
// std/linux_arm64 - Linux ARM64 (aarch64) platform layer
// Linux ARM64 syscall: x8=syscall#, x0-x5=args, svc #0, return in x0
// ---------------------------------------------------------------------------

module std_linux_arm64;

import ../../core/core;

fn i32_to_u64(val: i32) -> u64 {
    mov(x0, val);
    return getreg(x0);
}

fn i64_to_u64(val: i64) -> u64 {
    mov(x0, val);
    return getreg(x0);
}

fn u64_to_i64(val: u64) -> i64 { return load64(&val); }

fn array_len(arr: []i32) -> i32 {
    mov(x0, arr);
    let hdr: u64 = getreg(x0);
    return load32(hdr + 8);
}

fn array_len_u64(arr: []u64) -> i32 {
    mov(x0, arr);
    let hdr: u64 = getreg(x0);
    return load32(hdr + 8);
}

fn array_len_str(arr: []str) -> i32 {
    mov(x0, arr);
    let hdr: u64 = getreg(x0);
    return load32(hdr + 8);
}

fn array_len_i64(arr: []i64) -> i32 {
    mov(x0, arr);
    let hdr: u64 = getreg(x0);
    return load32(hdr + 8);
}

fn array_len_u32(arr: []u32) -> i32 {
    mov(x0, arr);
    let hdr: u64 = getreg(x0);
    return load32(hdr + 8);
}

fn array_len_bool(arr: []bool) -> i32 {
    mov(x0, arr);
    let hdr: u64 = getreg(x0);
    return load32(hdr + 8);
}

fn array_len_f32(arr: []f32) -> i32 {
    mov(x0, arr);
    let hdr: u64 = getreg(x0);
    return load32(hdr + 8);
}

fn array_len_f64(arr: []f64) -> i32 {
    mov(x0, arr);
    let hdr: u64 = getreg(x0);
    return load32(hdr + 8);
}

fn array_data_ptr_i32(arr: []i32) -> i64 {
    mov(x0, arr);
    let hdr: u64 = getreg(x0);
    return load64(hdr);
}

fn array_data_ptr_str(arr: []str) -> i64 {
    mov(x0, arr);
    let hdr: u64 = getreg(x0);
    return load64(hdr);
}

fn array_data_ptr_i64(arr: []i64) -> i64 {
    mov(x0, arr);
    let hdr: u64 = getreg(x0);
    return load64(hdr);
}

fn print(msg: str) -> void {
    msg = msg + "\n";
    mov(x0, 1);        // fd = stdout
    mov(x1, msg);
    mov(x2, len(msg));
    mov(x8, 64);       // SYS_write
    syscall();
}

fn print_raw(msg: str) -> void {
    mov(x0, 1);        // fd = stdout
    mov(x1, msg);
    mov(x2, len(msg));
    mov(x8, 64);       // SYS_write
    syscall();
}

fn exit(code: i32) -> void {
    mov(x0, code);
    mov(x8, 93);       // SYS_exit
    syscall();
}

fn get_time_ns() -> i64 {
    let buf: str = "0123456789abcdef";
    mov(x0, 0);        // CLOCK_REALTIME
    mov(x1, buf);
    mov(x8, 113);      // SYS_clock_gettime
    syscall();
    mov(x0, buf);
    let base: u64 = getreg(x0);
    let tv_sec: i64 = load64(base);
    let tv_nsec: i64 = load64(base + 8);
    return tv_sec * 1000000000 + tv_nsec;
}

fn input(prompt: str, buf_len: i32 = 128) -> str {
    mov(x0, 1);
    mov(x1, prompt);
    mov(x2, len(prompt));
    mov(x8, 64);       // SYS_write
    syscall();
    let buf: str = "";
    while(len(buf) < buf_len) {
        buf = buf + " ";
    }
    mov(x0, 0);        // fd = stdin
    mov(x1, buf);
    mov(x2, buf_len);
    mov(x8, 63);       // SYS_read
    syscall();
    let nread: i32 = u64_to_i32(getreg(x0));
    let bp: u64 = ptr(buf);
    let out: str = "";
    let i: i32 = 0;
    while (i < nread) {
        let ch: i32 = read_byte(bp + i32_to_u64(i));
        if (ch == 10) {
            break;
        }
        out = out + copy_bytes_raw(bp + i32_to_u64(i), 1);
        i = i + 1;
    }
    return out;
}

fn ptr(s: str) -> u64 {
    mov(x0, s);
    return getreg(x0);
}

fn array_data_ptr_u64(arr: []u64) -> i64 {
    mov(x0, arr);
    let hdr: u64 = getreg(x0);
    return load64(hdr);
}

fn execve_raw(path: str, argv: []u64) -> i32 {
    let argv_ptr: i64 = array_data_ptr_u64(argv);
    let envp_ptr: u64 = __novus_envp;
    mov(x0, path);
    mov(x1, argv_ptr);
    mov(x2, envp_ptr);
    mov(x8, 221);      // SYS_execve
    syscall();
    return u64_to_i32(getreg(x0));
}

fn fork() -> i32 {
    // ARM64 Linux has no fork syscall; use clone(SIGCHLD, 0, 0, 0, 0)
    mov(x0, 17);       // SIGCHLD
    mov(x1, 0);        // child_stack = 0
    mov(x2, 0);        // parent_tid
    mov(x3, 0);        // tls
    mov(x4, 0);        // child_tid
    mov(x8, 220);      // SYS_clone
    syscall();
    return u64_to_i32(getreg(x0));
}

fn spawn_execve(path: str, argv: []u64) -> i32 {
    let pid: i32 = fork();
    if (pid == 0) {
        execve_raw(path, argv);
        exit(1);
        return 1;
    }
    return pid;
}

// ---------------------------------------------------------------------------
// User info: get_home_dir / get_username
// Reads /etc/passwd and matches on current UID (via SYS_getuid)
// ARM64 Linux has no SYS_open; uses SYS_openat with AT_FDCWD
// ---------------------------------------------------------------------------

fn get_home_dir() -> str {
    // Get current UID
    mov(x8, 174);      // SYS_getuid
    syscall();
    let uid: i32 = u64_to_i32(getreg(x0));
    let uid_str: str = i32_to_str(uid);

    // Open /etc/passwd using openat(AT_FDCWD, path, O_RDONLY)
    let path: str = "/etc/passwd\0";
    mov(x0, -100);     // AT_FDCWD
    mov(x1, path);
    mov(x2, 0);        // O_RDONLY
    mov(x3, 0);
    mov(x8, 56);       // SYS_openat
    syscall();
    let fd: i32 = u64_to_i32(getreg(x0));
    if (fd < 0) { return ""; }

    // Read file contents
    let buf: str = "";
    let k: i32 = 0;
    while (k < 4096) { buf = buf + " "; k = k + 1; }
    mov(x0, fd);
    mov(x1, buf);
    mov(x2, 4096);
    mov(x8, 63);       // SYS_read
    syscall();
    let nread: i32 = u64_to_i32(getreg(x0));

    // Close file
    mov(x0, fd);
    mov(x8, 57);       // SYS_close
    syscall();

    if (nread <= 0) { return ""; }

    // Parse /etc/passwd: each line is username:x:uid:gid:gecos:home:shell
    let i: i32 = 0;
    while (i < nread) {
        let line_start: i32 = i;
        while (i < nread && buf[i] != '\n') { i = i + 1; }
        let line: str = substr_len(buf, line_start, i - line_start);
        i = i + 1;

        let field: i32 = 0;
        let field_start: i32 = 0;
        let line_len: i32 = len(line);
        let found_uid: str = "";
        let found_home: str = "";
        let j: i32 = 0;
        while (j <= line_len) {
            if (j == line_len || line[j] == ':') {
                if (field == 2) {
                    found_uid = substr_len(line, field_start, j - field_start);
                }
                if (field == 5) {
                    found_home = substr_len(line, field_start, j - field_start);
                }
                field = field + 1;
                field_start = j + 1;
            }
            j = j + 1;
        }
        if (str_equals(found_uid, uid_str)) {
            return found_home;
        }
    }
    return "";
}

fn get_username() -> str {
    // Get current UID
    mov(x8, 174);      // SYS_getuid
    syscall();
    let uid: i32 = u64_to_i32(getreg(x0));
    let uid_str: str = i32_to_str(uid);

    // Open /etc/passwd using openat(AT_FDCWD, path, O_RDONLY)
    let path: str = "/etc/passwd\0";
    mov(x0, -100);     // AT_FDCWD
    mov(x1, path);
    mov(x2, 0);        // O_RDONLY
    mov(x3, 0);
    mov(x8, 56);       // SYS_openat
    syscall();
    let fd: i32 = u64_to_i32(getreg(x0));
    if (fd < 0) { return ""; }

    // Read file contents
    let buf: str = "";
    let k: i32 = 0;
    while (k < 4096) { buf = buf + " "; k = k + 1; }
    mov(x0, fd);
    mov(x1, buf);
    mov(x2, 4096);
    mov(x8, 63);       // SYS_read
    syscall();
    let nread: i32 = u64_to_i32(getreg(x0));

    // Close file
    mov(x0, fd);
    mov(x8, 57);       // SYS_close
    syscall();

    if (nread <= 0) { return ""; }

    // Parse /etc/passwd
    let i: i32 = 0;
    while (i < nread) {
        let line_start: i32 = i;
        while (i < nread && buf[i] != '\n') { i = i + 1; }
        let line: str = substr_len(buf, line_start, i - line_start);
        i = i + 1;

        let field: i32 = 0;
        let field_start: i32 = 0;
        let line_len: i32 = len(line);
        let found_uid: str = "";
        let found_user: str = "";
        let j: i32 = 0;
        while (j <= line_len) {
            if (j == line_len || line[j] == ':') {
                if (field == 0) {
                    found_user = substr_len(line, field_start, j - field_start);
                }
                if (field == 2) {
                    found_uid = substr_len(line, field_start, j - field_start);
                }
                field = field + 1;
                field_start = j + 1;
            }
            j = j + 1;
        }
        if (str_equals(found_uid, uid_str)) {
            return found_user;
        }
    }
    return "";
}

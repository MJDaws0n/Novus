module std_builder;

class StringBuilder {
    priv let chunks: []str = [];
    priv let size: i32 = 0;

    pub fn append(value: str) -> void {
        if (len(value) == 0) { return; }
        array_append(self.chunks, value);
        self.size += len(value);
    }

    pub fn append_byte(value: i32) -> void { self.append(byte_char(value)); }
    pub fn length() -> i32 { return self.size; }
    pub fn clear() -> void { self.chunks = []; self.size = 0; }

    pub fn text() -> str {
        let result: str = make_buffer(self.size);
        let offset: i32 = 0;
        for (let i: i32 = 0; i < len(self.chunks); i++) {
            let chunk: str = self.chunks[i];
            let size: i32 = len(chunk);
            for (let j: i32 = 0; j < size; j++) {
                string_set_byte(result, offset, byte_at(chunk, j));
                offset++;
            }
        }
        return result;
    }
}

// Binary data keeps an explicit length, including embedded zero bytes.
class ByteBuffer {
    pub let bytes: []i32 = [];
    pub fn append(value: i32) -> void { array_append(self.bytes, value & 255); }
    pub fn length() -> i32 { return len(self.bytes); }
    pub fn get(index: i32) -> i32 { return self.bytes[index]; }
    pub fn append_buffer(other: ByteBuffer) -> void {
        let count: i32 = other.length();
        for (let i: i32 = 0; i < count; i++) { self.append(other.get(i)); }
    }
    pub fn equals(other: ByteBuffer) -> bool {
        if (self.length() != other.length()) { return false; }
        for (let i: i32 = 0; i < self.length(); i++) {
            if (self.get(i) != other.get(i)) { return false; }
        }
        return true;
    }
    pub fn text() -> str {
        let result: str = make_buffer(self.length());
        for (let i: i32 = 0; i < self.length(); i++) { string_set_byte(result, i, self.get(i)); }
        return result;
    }
}

fn bytes_from_string(value: str) -> ByteBuffer {
    let size: i32 = len(value);
    let result: ByteBuffer = new ByteBuffer();
    for (let i: i32 = 0; i < size; i++) { result.append(byte_at(value, i)); }
    return result;
}

fn string_join(values: []str, separator: str) -> str {
    let result: StringBuilder = new StringBuilder();
    for (let i: i32 = 0; i < len(values); i++) {
        if (i > 0) { result.append(separator); }
        result.append(values[i]);
    }
    return result.text();
}

fn string_split(value: str, separator: str) -> []str {
    let result: []str = [];
    let start: i32 = 0;
    let count: i32 = len(value);
    let width: i32 = len(separator);
    if (width == 0) {
        for (let i: i32 = 0; i < count; i++) { array_append(result, byte_char(byte_at(value, i))); }
        return result;
    }
    for (let i: i32 = 0; i + width <= count; i++) {
        let match: bool = true;
        for (let j: i32 = 0; j < width; j++) {
            if (byte_at(value, i + j) != byte_at(separator, j)) { match = false; break; }
        }
        if (match) {
            array_append(result, copy_bytes(ptr(value) + i32_to_u64(start), i - start));
            start = i + width;
            i = start - 1;
        }
    }
    array_append(result, copy_bytes(ptr(value) + i32_to_u64(start), count - start));
    return result;
}

fn quote_string(value: str) -> str {
    let size: i32 = len(value);
    let result: StringBuilder = new StringBuilder();
    result.append("\"");
    for (let i: i32 = 0; i < size; i++) {
        let ch: i32 = byte_at(value, i);
        if (ch == 34) { result.append("\\\""); }
        else if (ch == 92) { result.append("\\\\"); }
        else if (ch == 10) { result.append("\\n"); }
        else if (ch == 13) { result.append("\\r"); }
        else if (ch == 9) { result.append("\\t"); }
        else if (ch < 32 || ch == 127) {
            result.append("\\x");
            let digits: str = "0123456789abcdef";
            result.append_byte(byte_at(digits, ch / 16));
            result.append_byte(byte_at(digits, ch % 16));
        } else { result.append_byte(ch); }
    }
    result.append("\"");
    return result.text();
}

// ---------------------------------------------------------------------------
// bool <-> string
// ---------------------------------------------------------------------------

fn bool_to_str(b: bool) -> str {
    if (b) { return "true"; }
    return "false";
}

fn str_to_bool(s: str) -> bool {
    if (len(s) == 0) { return false; }
    if (s[0] == 't' || s[0] == 'T' || s[0] == '1' || s[0] == 'y' || s[0] == 'Y') {
        return true;
    }
    return false;
}

// ---------------------------------------------------------------------------
// str_to_i64
// ---------------------------------------------------------------------------

fn str_to_i64(s: str) -> i64 {
    let i: i32 = 0;
    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') {
        i = i + 1;
    }
    let sign: i64 = 1;
    if (s[i] == '-') {
        sign = 0 - 1;
        i = i + 1;
    } else if (s[i] == '+') {
        i = i + 1;
    }
    let result: i64 = 0;
    while (s[i] != '\0') {
        let digit: i64 = 0 - 1;
        if (s[i] == '0') { digit = 0; }
        else if (s[i] == '1') { digit = 1; }
        else if (s[i] == '2') { digit = 2; }
        else if (s[i] == '3') { digit = 3; }
        else if (s[i] == '4') { digit = 4; }
        else if (s[i] == '5') { digit = 5; }
        else if (s[i] == '6') { digit = 6; }
        else if (s[i] == '7') { digit = 7; }
        else if (s[i] == '8') { digit = 8; }
        else if (s[i] == '9') { digit = 9; }
        else { break; }
        result = result * 10 + digit;
        i = i + 1;
    }
    return result * sign;
}

fn str_to_u32(s: str) -> u32 {
    let i: i32 = 0;
    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') {
        i = i + 1;
    }
    if (s[i] == '-') { return 0; }
    if (s[i] == '+') { i = i + 1; }

    let result: u32 = 0;
    while (s[i] != '\0') {
        let digit: u32 = 99;
        if (s[i] == '0') { digit = 0; }
        else if (s[i] == '1') { digit = 1; }
        else if (s[i] == '2') { digit = 2; }
        else if (s[i] == '3') { digit = 3; }
        else if (s[i] == '4') { digit = 4; }
        else if (s[i] == '5') { digit = 5; }
        else if (s[i] == '6') { digit = 6; }
        else if (s[i] == '7') { digit = 7; }
        else if (s[i] == '8') { digit = 8; }
        else if (s[i] == '9') { digit = 9; }
        else { break; }
        result = result * 10 + digit;
        i = i + 1;
    }
    return result;
}

fn str_to_u64(s: str) -> u64 {
    let i: i32 = 0;
    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') {
        i = i + 1;
    }
    if (s[i] == '-') { return 0; }
    if (s[i] == '+') { i = i + 1; }

    let result: u64 = 0;
    while (s[i] != '\0') {
        let digit: u64 = 99;
        if (s[i] == '0') { digit = 0; }
        else if (s[i] == '1') { digit = 1; }
        else if (s[i] == '2') { digit = 2; }
        else if (s[i] == '3') { digit = 3; }
        else if (s[i] == '4') { digit = 4; }
        else if (s[i] == '5') { digit = 5; }
        else if (s[i] == '6') { digit = 6; }
        else if (s[i] == '7') { digit = 7; }
        else if (s[i] == '8') { digit = 8; }
        else if (s[i] == '9') { digit = 9; }
        else { break; }
        result = result * 10 + digit;
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// Byte value helper (ensure value in 0-255 range)
// ---------------------------------------------------------------------------

fn to_u8(v: i32) -> i32 {
    return ((v % 256) + 256) % 256;
}

// ---------------------------------------------------------------------------
// Array contains helpers
// ---------------------------------------------------------------------------

fn array_contains_i32(arr: []i32, needle: i32) -> bool {
    let n: i32 = array_len(arr);
    let base: i64 = array_data_ptr_i32(arr);
    let i: i32 = 0;
    while (i < n) {
        let val: i32 = load32(i64_to_u64(base) + i32_to_u64(i) * 4);
        if (val == needle) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn array_contains_i64(arr: []i64, needle: i64) -> bool {
    let n: i32 = array_len_i64(arr);
    let base: i64 = array_data_ptr_i64(arr);
    let i: i32 = 0;
    while (i < n) {
        let val: i64 = load64(i64_to_u64(base) + i32_to_u64(i) * 8);
        if (val == needle) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn array_contains_u32(arr: []u32, needle: u32) -> bool {
    let n: i32 = array_len_u32(arr);
    let i: i32 = 0;
    while (i < n) {
        if (arr[i] == needle) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn array_contains_u64(arr: []u64, needle: u64) -> bool {
    let n: i32 = array_len_u64(arr);
    let i: i32 = 0;
    while (i < n) {
        if (arr[i] == needle) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn array_contains_bool(arr: []bool, needle: bool) -> bool {
    let n: i32 = array_len_bool(arr);
    let i: i32 = 0;
    while (i < n) {
        if (arr[i] == needle) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn array_contains_f32(arr: []f32, needle: f32) -> bool {
    let n: i32 = array_len_f32(arr);
    let i: i32 = 0;
    while (i < n) {
        if (str_equals(f32_to_str(arr[i]), f32_to_str(needle))) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn array_contains_f64(arr: []f64, needle: f64) -> bool {
    let n: i32 = array_len_f64(arr);
    let i: i32 = 0;
    while (i < n) {
        if (str_equals(f64_to_str(arr[i]), f64_to_str(needle))) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn array_contains_str(arr: []str, needle: str) -> bool {
    let n: i32 = array_len_str(arr);
    let base: i64 = array_data_ptr_str(arr);
    let i: i32 = 0;
    while (i < n) {
        let addr: u64 = i64_to_u64(load64(i64_to_u64(base) + i32_to_u64(i) * 8));
        let s: str = cstr_to_str(addr);
        if (str_equals(s, needle)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

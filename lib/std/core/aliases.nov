// ---------------------------------------------------------------------------
// std/aliases - Unified short-name API
//
// Novus supports function overloading, so a single name can dispatch to the
// right implementation based on argument types. This file exposes the new
// preferred public API as thin wrappers around the typed implementations.
//
// Old typed names (e.g. i32_to_str, str_contains, array_len_u64) remain
// available for backward compatibility but are considered deprecated; new
// code should prefer these unified names.
// ---------------------------------------------------------------------------

module std_aliases;

import core;
import strings;

#if(os == "darwin") {
    import ../platforms/darwin/common;
}
#if(os == "windows") {
    import ../platforms/windows/common;
}
#if(os == "linux") {
    import ../platforms/linux/common;
}

// ---------------------------------------------------------------------------
// to_str - convert any common scalar to a printable string
// ---------------------------------------------------------------------------

fn to_str(n: i32) -> str { return i32_to_str(n); }
fn to_str(n: i64) -> str { return i64_to_str(n); }
fn to_str(n: u32) -> str { return u32_to_str(n); }
fn to_str(n: u64) -> str { return u64_to_str(n); }
fn to_str(n: f32) -> str { return f32_to_str(n); }
fn to_str(n: f64) -> str { return f64_to_str(n); }
fn to_str(b: bool) -> str { return bool_to_str(b); }
fn to_str(s: str)  -> str { return s; }

// ---------------------------------------------------------------------------
// to_i32 / to_i64 / to_bool - parse strings or coerce between integer widths
// ---------------------------------------------------------------------------

fn to_i32(s: str)  -> i32  { return str_to_i32(s); }
fn to_i32(n: u64)  -> i32  { return u64_to_i32(n); }
fn to_i32(n: i64)  -> i32  { return u64_to_i32(i64_to_u64(n)); }
fn to_i32(n: u32)  -> i32  { return str_to_i32(u32_to_str(n)); }
fn to_i32(n: f32)  -> i32  { return u64_to_i32(i64_to_u64(f64_to_i64(n))); }
fn to_i32(n: f64)  -> i32  { return u64_to_i32(i64_to_u64(f64_to_i64(n))); }
fn to_i32(n: i32)  -> i32  { return n; }

fn to_i64(s: str)  -> i64  { return str_to_i64(s); }
fn to_i64(n: u64)  -> i64  { return u64_to_i64(n); }
fn to_i64(n: i32)  -> i64  { return u64_to_i64(i32_to_u64(n)); }
fn to_i64(n: u32)  -> i64  { return str_to_i64(u32_to_str(n)); }
fn to_i64(n: f32)  -> i64  { return f64_to_i64(n); }
fn to_i64(n: f64)  -> i64  { return f64_to_i64(n); }
fn to_i64(n: i64)  -> i64  { return n; }

fn to_u32(s: str)  -> u32  { return str_to_u32(s); }
fn to_u32(n: i32)  -> u32  { return str_to_u32(i32_to_str(n)); }
fn to_u32(n: i64)  -> u32  { return str_to_u32(i64_to_str(n)); }
fn to_u32(n: u32)  -> u32  { return n; }
fn to_u32(n: u64)  -> u32  { return str_to_u32(u64_to_str(n)); }
fn to_u32(n: f32)  -> u32  { return str_to_u32(f32_to_str(n)); }
fn to_u32(n: f64)  -> u32  { return str_to_u32(f64_to_str(n)); }

fn to_u64(s: str)  -> u64  { return str_to_u64(s); }
fn to_u64(n: i32)  -> u64  { return i32_to_u64(n); }
fn to_u64(n: i64)  -> u64  { return i64_to_u64(n); }
fn to_u64(n: u32)  -> u64  { return str_to_u64(u32_to_str(n)); }
fn to_u64(n: f32)  -> u64  { return str_to_u64(f32_to_str(n)); }
fn to_u64(n: f64)  -> u64  { return str_to_u64(f64_to_str(n)); }
fn to_u64(n: u64)  -> u64  { return n; }

fn to_f32(s: str)  -> f32  { return str_to_f32(s); }
fn to_f32(n: i32)  -> f32  { return str_to_f32(i32_to_str(n)); }
fn to_f32(n: i64)  -> f32  { return str_to_f32(i64_to_str(n)); }
fn to_f32(n: u32)  -> f32  { return str_to_f32(u32_to_str(n)); }
fn to_f32(n: u64)  -> f32  { return str_to_f32(u64_to_str(n)); }
fn to_f32(n: f32)  -> f32  { return n; }
fn to_f32(n: f64)  -> f32  { return str_to_f32(f64_to_str(n)); }

fn to_f64(s: str)  -> f64  { return str_to_f64(s); }
fn to_f64(n: i32)  -> f64  { return i64_to_f64(u64_to_i64(i32_to_u64(n))); }
fn to_f64(n: i64)  -> f64  { return i64_to_f64(n); }
fn to_f64(n: u32)  -> f64  { return str_to_f64(u32_to_str(n)); }
fn to_f64(n: u64)  -> f64  { return str_to_f64(u64_to_str(n)); }
fn to_f64(n: f32)  -> f64  { return str_to_f64(f32_to_str(n)); }
fn to_f64(n: f64)  -> f64  { return n; }

fn to_bool(s: str) -> bool { return str_to_bool(s); }
fn to_bool(b: bool) -> bool { return b; }

fn to_hex(n: i32)  -> str  { return int_to_hex(n); }

// ---------------------------------------------------------------------------
// len - length of any container type
// ---------------------------------------------------------------------------
// `len(s: str) -> i32` is provided by core.
fn len(arr: []i32) -> i32 { return array_len(arr); }
fn len(arr: []i64) -> i32 { return array_len_i64(arr); }
fn len(arr: []u32) -> i32 { return array_len_u32(arr); }
fn len(arr: []u64) -> i32 { return array_len_u64(arr); }
fn len(arr: []bool) -> i32 { return array_len_bool(arr); }
fn len(arr: []f32) -> i32 { return array_len_f32(arr); }
fn len(arr: []f64) -> i32 { return array_len_f64(arr); }
fn len(arr: []str) -> i32 { return array_len_str(arr); }

// ---------------------------------------------------------------------------
// contains - membership test for strings and arrays
// ---------------------------------------------------------------------------

fn contains(s: str, needle: str)  -> bool { return str_contains(s, needle); }
fn contains(arr: []i32, v: i32)   -> bool { return array_contains_i32(arr, v); }
fn contains(arr: []i64, v: i64)   -> bool { return array_contains_i64(arr, v); }
fn contains(arr: []u32, v: u32)   -> bool { return array_contains_u32(arr, v); }
fn contains(arr: []u64, v: u64)   -> bool { return array_contains_u64(arr, v); }
fn contains(arr: []bool, v: bool) -> bool { return array_contains_bool(arr, v); }
fn contains(arr: []f32, v: f32)   -> bool { return array_contains_f32(arr, v); }
fn contains(arr: []f64, v: f64)   -> bool { return array_contains_f64(arr, v); }
fn contains(arr: []str, v: str)   -> bool { return array_contains_str(arr, v); }

// ---------------------------------------------------------------------------
// String helpers without the str_ prefix
// ---------------------------------------------------------------------------

fn equals(a: str, b: str)         -> bool { return str_equals(a, b); }
fn find(s: str, needle: str)      -> i32  { return str_find(s, needle); }
fn last_find(s: str, needle: str) -> i32  { return str_last_find(s, needle); }
fn count(s: str, needle: str)     -> i32  { return str_count(s, needle); }
fn is_empty(s: str)               -> bool { return str_is_empty(s); }
fn is_blank(s: str)               -> bool { return str_is_blank(s); }
fn lower(s: str)                  -> str  { return str_lower(s); }
fn upper(s: str)                  -> str  { return str_upper(s); }
fn reverse(s: str)                -> str  { return str_reverse(s); }
fn repeat(s: str, n: i32)         -> str  { return str_repeat(s, n); }
fn trim(s: str)                   -> str  { return str_trim(s); }
fn trim_left(s: str)              -> str  { return str_trim_left(s); }
fn trim_right(s: str)             -> str  { return str_trim_right(s); }
fn pad_left(s: str, total: i32, pad: str)  -> str { return str_pad_left(s, total, pad); }
fn pad_right(s: str, total: i32, pad: str) -> str { return str_pad_right(s, total, pad); }
fn replace(s: str, old: str, new_val: str)       -> str { return str_replace(s, old, new_val); }
fn replace_first(s: str, old: str, new_val: str) -> str { return str_replace_first(s, old, new_val); }
fn split_first(s: str, delim: str)               -> str { return str_split_first(s, delim); }
fn split_rest(s: str, delim: str)                -> str { return str_split_rest(s, delim); }

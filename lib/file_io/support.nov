module file_support;

import ../std;

class FileInfo {
    pub let path: str = "";
    pub let exists: bool = false;
    pub let directory: bool = false;
    pub let size: i64 = 0;
    pub let error: str = "";
}

class FileReadResult {
    pub let data: ByteBuffer = new ByteBuffer();
    pub let error: str = "";
}

class PathResult {
    pub let path: str = "";
    pub let error: str = "";
}

fn read_all_bytes(path: str) -> FileReadResult {
    let result: FileReadResult = new FileReadResult();
    let descriptor: i32 = file_open_read(path);
    if (descriptor < 0) { result.error = "cannot open file: " + path; return result; }
    let buffer: str = make_buffer(16384);
    while (true) {
        let amount: i32 = file_read(descriptor, ptr(buffer), 16384);
        if (amount == 0) { break; }
        if (amount < 0) { result.error = "cannot read file: " + path; break; }
        for (let i: i32 = 0; i < amount; i++) { result.data.append(byte_at(buffer, i)); }
    }
    file_close(descriptor);
    return result;
}

fn write_all_bytes(path: str, data: ByteBuffer) -> str {
    let descriptor: i32 = file_open_write(path);
    if (descriptor < 0) { return "cannot open file for writing: " + path; }
    let buffer: str = data.text();
    let offset: i32 = 0;
    while (offset < data.length()) {
        let written: i32 = file_write(descriptor, ptr(buffer) + i32_to_u64(offset), data.length() - offset);
        if (written <= 0) { file_close(descriptor); return "cannot write file: " + path; }
        offset += written;
    }
    file_close(descriptor);
    return "";
}

fn path_clean(path: str) -> str {
    if (path == "") { return "."; }
    let normalized: str = path;
    if (path_separator() == "\\") { normalized = str_replace(path, "\\", "/"); }
    let prefix: str = "";
    let rooted: bool = starts_with(normalized, "/");
    if (path_separator() == "\\" && len(normalized) >= 2 && byte_at(normalized, 1) == 58) {
        prefix = substr_len(normalized, 0, 2);
        normalized = substr(normalized, 2);
        rooted = starts_with(normalized, "/");
    }
    let parts: []str = string_split(normalized, "/");
    let result: []str = [];
    for (let i: i32 = 0; i < len(parts); i++) {
        let part: str = parts[i];
        if (part == "" || part == ".") { continue; }
        if (part == "..") {
            if (len(result) > 0 && result[len(result) - 1] != "..") { array_pop(result); }
            else if (!rooted) { array_append(result, part); }
        } else { array_append(result, part); }
    }
    if (rooted) { prefix = prefix + path_separator(); }
    let clean: str = prefix + string_join(result, path_separator());
    if (clean == "") { return "."; }
    return clean;
}

fn path_join_all(parts: []str) -> str {
    let path: str = "";
    for (let i: i32 = 0; i < len(parts); i++) {
        if (parts[i] != "") {
            if (path != "") { path = path + path_separator(); }
            path = path + parts[i];
        }
    }
    if (path == "") { return ""; }
    return path_clean(path);
}

fn path_parent(path: str) -> str {
    let clean: str = path_clean(path);
    let index: i32 = str_last_find(clean, path_separator());
    if (index < 0) { return "."; }
    if (index == 0) { return path_separator(); }
    return substr_len(clean, 0, index);
}

fn path_absolute(path: str) -> PathResult {
    let result: PathResult = new PathResult();
    result.path = path_clean(path);
    if (starts_with(result.path, path_separator()) || (path_separator() == "\\" && len(result.path) > 2 && byte_at(result.path, 1) == 58)) { return result; }
    let directory: PathResult = working_directory();
    if (directory.error != "") { return directory; }
    result.path = path_join_all([directory.path, path]);
    return result;
}

fn create_directories(path: str, mode: i32 = 493) -> str {
    let info: FileInfo = file_info(path);
    if (info.exists) {
        if (info.directory) { return ""; }
        return "path is not a directory: " + path;
    }
    let parent: str = path_parent(path);
    if (parent != path && parent != ".") {
        let error: str = create_directories(parent, mode);
        if (error != "") { return error; }
    }
    if (sys_mkdir(path, mode) != 0 && !file_info(path).directory) { return "cannot create directory: " + path; }
    return "";
}

#if(os != "windows") {
    fn path_separator() -> str { return "/"; }
}
#if(os == "windows") {
    fn path_separator() -> str { return "\\"; }
}

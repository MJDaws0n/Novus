module string_lab;

import ../../lib/core core;
import ../../lib/term term;

fn dump_chars(label: str, text: str) -> void {
    term.println(label + " (len=" + core.int_to_str(len(text)) + ")");
    let i: i32 = 0;
    while (i < len(text)) {
        term.println("  [" + core.int_to_str(i) + "] = " + text[i]);
        i = i + 1;
    }
}

fn main() -> i32 {
    let phrase: str = "NOVUS";
    dump_chars("phrase", phrase);

    let banner: str = core.repeat("=-", 8);
    term.println(banner);
    term.println("clamp examples");
    term.println(" clamp(17, 0, 10) = " + core.int_to_str(core.clamp_i32(17, 0, 10)));
    term.println(" clamp(-4, 0, 10) = " + core.int_to_str(core.clamp_i32(-4, 0, 10)));

    let scores: []i32 = [4, 9, 15];
    array_append(scores, 16);
    term.println("scores[0] = " + core.int_to_str(scores[0]));
    term.println("scores[1] = " + core.int_to_str(scores[1]));
    term.println("scores[2] = " + core.int_to_str(scores[2]));
    term.println("scores[3] = " + core.int_to_str(scores[3]));

    let popped: i32 = array_pop(scores);
    term.println("popped = " + core.int_to_str(popped));
    term.exit_with(0);
    return 0;
}

module dice_duel;

import ../../lib/core core;
import ../../lib/game game;
import ../../lib/term term;

fn main() -> i32 {
    term.println("== Novus dice-duel ==");
    term.println("Hero vs Villain. First to 0 HP loses.");

    let seed: i32 = 20260523;
    let hero_hp: i32 = 24;
    let villain_hp: i32 = 24;
    let round: i32 = 1;

    while (round <= 8) {
        if (hero_hp <= 0 || villain_hp <= 0) {
            break;
        }

        seed = core.lcg_next(seed);
        let delta: i32 = game.duel_delta(seed, 6);
        let damage: i32 = game.damage_from_delta(delta);
        let winner: str = game.winner_label(delta);

        if (winner == "hero") {
            villain_hp = villain_hp - damage;
            term.println("round " + core.int_to_str(round) + ": hero hits " + core.int_to_str(damage));
        } else if (winner == "villain") {
            hero_hp = hero_hp - damage;
            term.println("round " + core.int_to_str(round) + ": villain hits " + core.int_to_str(damage));
        } else {
            term.println("round " + core.int_to_str(round) + ": draw");
        }

        term.println(" hero    " + game.hp_bar(hero_hp, 24, 24));
        term.println(" villain " + game.hp_bar(villain_hp, 24, 24));
        round = round + 1;
    }

    if (hero_hp > villain_hp) {
        term.println("result: hero wins");
    } else if (villain_hp > hero_hp) {
        term.println("result: villain wins");
    } else {
        term.println("result: draw");
    }

    term.exit_with(0);
    return 0;
}

module codegen_emit_arm64_coff;

import model;
import runtime;

fn codegen_arm64Emitter_emitWindowsHeapAllocator(e: CodegenArm64Emitter) -> void {
    let w: StringBuilder = e.b;
    w.append("\n.p2align 2\n_novus_heap_alloc:\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x9", "_novus_heap");
    codegen_arm64Emitter_emitLoadGlobal(e, "x10", "_novus_heap_ptr");
    w.append("    ldr x11, [x10]\n    add x12, x11, x0\n");
    codegen_arm64Emitter_loadImm(e, "x13", e.target.HeapSize);
    w.append("    cmp x12, x13\n    b.hi .Lwin_heap_exhausted\n    str x12, [x10]\n    add x0, x9, x11\n    ret\n.Lwin_heap_exhausted:\n    brk #0\n");
}

fn codegen_arm64Emitter_emitWinMainArgs(e: CodegenArm64Emitter) -> void {
    e.b.append("    bl _novus_windows_args\n    ldr x1, [x0]\n    ldr x0, [x0, #8]\n    sub x0, x0, #1\n");
}

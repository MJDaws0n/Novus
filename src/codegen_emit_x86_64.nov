                let count_314: i32 = len(items_312);
                for (let index_313: i32 = 0; index_313 < count_314; index_313++) {
                    let instr: CodegenIRInstr = items_312[index_313];
                    {
                        let choice_315: i32 = instr.Op;
                        if ((choice_315 == 74) || (choice_315 == 40) || (choice_315 == 48) || (choice_315 == 51) || (choice_315 == 73)) {
                            return true;
                        }
                    }

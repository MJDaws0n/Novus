// collectWinCallExterns scans all IR functions for IRWinCall instructions
// and returns a deduplicated list of Windows API function names to extern.
fn codegen_x86_64Emitter_collectWinCallExterns(e: CodegenX86_64Emitter) -> []str {
    let map_302: MapStrBool = new MapStrBool();
    let seen: MapStrBool = map_302;
    let result: []str = [];
    {
        let items_303: []CodegenIRFunc = e.mod.Functions;
        let count_305: i32 = len(items_303);
        for (let index_304: i32 = 0; index_304 < count_305; index_304++) {
            let fn_value: CodegenIRFunc = items_303[index_304];
            {
                let items_306: []CodegenIRInstr = fn_value.Instrs;
                let count_308: i32 = len(items_306);
                for (let index_307: i32 = 0; index_307 < count_308; index_307++) {
                    let instr: CodegenIRInstr = items_306[index_307];
                    if (((instr.Op == 54) && (instr.Src1.Kind == 5))) {
                        let name: str = instr.Src1.Label;
                        if (!(MapStrBool_get(seen, name))) {
                            MapStrBool_put(seen, name, true);
                            result = append_Str(result, name);
                        }
                    }
                }
            }
        }
    }
    return result;
}

// emitNASMWinCall emits a Windows API call using the x64 calling convention:
//   - First 4 args in rcx, rdx, r8, r9
//   - 32-byte shadow space always allocated
//   - Additional args pushed right-to-left on stack
//   - Stack aligned to 16 bytes before call
//   - Return value in rax
fn codegen_x86_64Emitter_emitNASMWinCall(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let apiName: str = instr.Src1.Label;
    let winArgRegs: []str = ["rcx", "rdx", "r8", "r9"];
    w.append("    ; win_call ");
    w.append(apiName);
    w.append(" (");
    w.append(runtime_string_i32(len(instr.Args)));
    w.append(" args)\n");
    let stackArgs: i32 = 0;
    if ((len(instr.Args) > 4)) {
        let extraArgs: i32 = (len(instr.Args) - 4);
        if (((extraArgs % 2) != 0)) {
            w.append("    sub rsp, 8\n");
            stackArgs++;
        }
        {
            let i: i32 = (len(instr.Args) - 1);
            for (; (i >= 4); i--) {
                let src: str = codegen_x86_64Emitter_nasmLoadToReg(e, fn_value, instr.Args[i], "r10");
                w.append("    push ");
                w.append(src);
                w.append("\n");
                stackArgs++;
            }
        }
    }
    {
        let i: i32 = 0;
        for (; ((i < len(instr.Args)) && (i < 4)); i++) {
            let src: str = codegen_x86_64Emitter_nasmLoadToReg(e, fn_value, instr.Args[i], "r10");
            if ((src != winArgRegs[i])) {
                w.append("    mov ");
                w.append(winArgRegs[i]);
                w.append(", ");
                w.append(src);
                w.append("\n");
            }
        }
    }
    w.append("    sub rsp, 32\n    call ");
    w.append(apiName);
    w.append("\n    add rsp, 32\n");
    if ((stackArgs > 0)) {
        w.append("    add rsp, ");
        w.append(runtime_string_i32((stackArgs * 8)));
        w.append("\n");
    }
    if ((instr.Dst.Kind != 0)) {
        codegen_x86_64Emitter_nasmStoreToOperand(e, fn_value, instr.Dst, "rax");
    }
}

// emitNASMGCRuntime emits the GC runtime functions for x86_64 NASM (Intel syntax, Windows ABI).
// Includes: _novus_gc_register, _novus_gc_collect, _novus_gc_alloc.
fn codegen_x86_64Emitter_emitNASMGCRuntime(e: CodegenX86_64Emitter) -> void {
    let w: StringBuilder = e.b;
    w.append("\n_novus_gc_register:\n    push rbx\n    lea rax, [rel _novus_gc_count]\n    mov rbx, [rax]\n    cmp rbx, ");
    w.append(runtime_string_i32(e.target.GCEntries));
    w.append("\n    jl .gcr_space\n    ud2\n.gcr_space:\n    lea rax, [rel _novus_gc_table]\n    imul r8, rbx, 24\n    add rax, r8\n    mov [rax], rcx\n    mov [rax+8], rdx\n    mov qword [rax+16], 0\n    inc rbx\n    lea rax, [rel _novus_gc_count]\n    mov [rax], rbx\n.gcr_full:\n    pop rbx\n    ret\n");
    codegen_x86_64Emitter_emitFastCollector(e, true);
    w.append(runtime_strings_ReplaceAll(runtime_strings_ReplaceAll("\n_novus_gc_alloc:\n    push rbx\n    push rsi\n    push rdi\n    sub rsp, 32\n    call _novus_gc_round\n    mov rsi, rax\n    mov rax, [rel _novus_gc_count]\n    cmp rax, [rel _novus_gc_threshold]\n    jge .gca_collect\n    cmp rax, CAPACITY\n    jl .gca_take\n.gca_collect:\n    call _novus_gc_collect\n.gca_take:\n    lea rcx, [rel _novus_gc_freelist]\n    mov rdx, rsi\n    call _novus_gc_take\n    test rax, rax\n    jnz .gca_register\n    mov rax, [rel _novus_heap_ptr]\n    test rax, rax\n    jnz .gca_heap_ready\n    lea rax, [rel _novus_heap]\n.gca_heap_ready:\n    lea rdi, [rax+rsi]\n    lea rbx, [rel _novus_heap]\n    add rbx, HEAPSIZE\n    cmp rdi, rbx\n    jbe .gca_heap_space\n    ud2\n.gca_heap_space:\n    mov [rel _novus_heap_ptr], rdi\n.gca_register:\n    mov rdi, rax\n    mov rcx, rax\n    mov rdx, rsi\n    call _novus_gc_register\n    mov rax, rdi\n    add rsp, 32\n    pop rdi\n    pop rsi\n    pop rbx\n    ret\n", "CAPACITY", runtime_string_i32(e.target.GCEntries)), "HEAPSIZE", runtime_string_i64(e.target.HeapSize)));

}

// emitGASGCRuntime emits the GC runtime functions for x86_64 GAS (AT&T syntax).

    w.append(runtime_string_i64(e.target.HeapSize));
    w.append("(%r10), %r11\n    movq %r11, (%rdx)\n    movq %r10, %rax\n    jmp .Lgca_region_try_gas\n.Lgca_register_bump_gas:\n    movq %rbx, %rdi\n    movq %r12, %rsi\n    call ");
    w.append(gcRegSym);

}

// needsWinMainArgs checks if the main function takes argc/argv parameters
// on Windows, requiring a __getmainargs prologue.
fn codegen_x86_64Emitter_needsWinMainArgs(e: CodegenX86_64Emitter) -> bool {
    if ((e.target.OS != 2)) {
        return false;
    }
    {
        let items_316: []CodegenIRFunc = e.mod.Functions;
        let count_318: i32 = len(items_316);
        for (let index_317: i32 = 0; index_317 < count_318; index_317++) {
            let fn_value: CodegenIRFunc = items_316[index_317];
            if (((fn_value.Name == "main") && (fn_value.ParamCount >= 2))) {
                return true;
            }
        }
    }
    return false;
}

fn codegen_stripPercent(s: str) -> str {
    return runtime_strings_TrimPrefix(s, "%");
}

fn codegen_gasQuoteString(value: ByteBuffer) -> str {
    let result: StringBuilder = new StringBuilder();
    result.append("\"");
    for (let i: i32 = 0; i < value.length(); i++) {
        let ch: i32 = value.get(i);
        if (ch == 34) { result.append("\\\""); }
        else if (ch == 92) { result.append("\\\\"); }
        else if (ch == 10) { result.append("\\n"); }
        else if (ch == 13) { result.append("\\r"); }
        else if (ch == 9) { result.append("\\t"); }
        else if (ch < 32 || ch > 126) { result.append("\\" + format_unsigned(i32_to_u64(ch), 8, 3)); }
        else { result.append_byte(ch); }
    }
    result.append("\"");
    return result.text();
}

fn codegen_nasmQuoteString(value: ByteBuffer) -> str {
    let parts: []str = [];
    let current: ByteBuffer = new ByteBuffer();
    for (let i: i32 = 0; i < value.length(); i++) {
        let ch: i32 = value.get(i);
        if (ch < 32 || ch > 126 || ch == 34) {
            if (current.length() > 0) {
                array_append(parts, "\"" + current.text() + "\"");
                current = new ByteBuffer();
            }
            array_append(parts, i32_to_str(ch));
        } else { current.append(ch); }
    }
    if (current.length() > 0) { array_append(parts, "\"" + current.text() + "\""); }
    if (len(parts) == 0) { return "\"\""; }
    return string_join(parts, ", ");
}


fn codegen_flagNameToX86Setcc(name: str) -> str {
    {
        let choice_320: str = name;
        if ((choice_320 == "c") || (choice_320 == "carry") || (choice_320 == "cs") || (choice_320 == "cf")) {
            return "setc";
        } else if ((choice_320 == "z") || (choice_320 == "zero") || (choice_320 == "zero_flag")) {
            return "setz";
        } else if ((choice_320 == "n") || (choice_320 == "negative") || (choice_320 == "negative_flag")) {
            return "sets";
        } else if ((choice_320 == "v") || (choice_320 == "overflow") || (choice_320 == "overflow_flag")) {
            return "seto";
        }
    }
    return "";
}

fn codegen_x86_64Emitter_emitGASFlagOp(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let flagName: str = "";
    if ((instr.Op == 39)) {
        if ((instr.Src1.Kind == 2)) {
            flagName = instr.Src1.PhysReg;
        } else {
            if ((instr.Src1.Kind == 5)) {
                flagName = instr.Src1.Label;
            }
        }
    } else {
        if ((instr.Dst.Kind == 2)) {
            flagName = instr.Dst.PhysReg;
        } else {
            if ((instr.Dst.Kind == 5)) {
                flagName = instr.Dst.Label;
            }
        }
    }
    if ((instr.Op == 39)) {
        let setcc: str = codegen_flagNameToX86Setcc(flagName);
        if ((setcc != "")) {
            w.append("    movq $0, %r10\n    ");
            w.append(setcc);
            w.append(" %r10b\n");
        } else {
            w.append("    ## getflag: unrecognised flag ");
            w.append(runtime_quote(flagName));
            w.append("\n    xorq %r10, %r10\n");
        }
        codegen_x86_64Emitter_gasStoreToOperand(e, fn_value, instr.Dst, "%r10");
    } else {
        w.append("    ## setflag ");
        w.append(runtime_quote(flagName));
        w.append(" not directly supported on x86\n");
    }
}

fn codegen_x86_64Emitter_emitNASMFlagOp(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;

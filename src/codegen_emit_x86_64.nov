module codegen_emit_x86_64;

import model;
import runtime;

fn codegen_EmitX86_64(mod: CodegenIRModule, target: CodegenTarget) -> str {
    codegen_Target_EnsureHeapDefaults(target);
    mod = codegen_withWindowsArgs(mod, target);
    mod = codegen_withCollector(mod, target);
    let e: CodegenX86_64Emitter = make_CodegenX86_64Emitter_11(mod, target, make_StringBuilder_8());
    codegen_x86_64Emitter_emit(e);
    return e.b.text();
}

fn codegen_x86_64Emitter_uniqueID(e: CodegenX86_64Emitter) -> i32 {
    e.uid++;
    return e.uid;
}

fn codegen_x86_64Emitter_emit(e: CodegenX86_64Emitter) -> void {
    if ((e.target.Flavor == 1)) {
        codegen_x86_64Emitter_emitNASM(e);
    } else {
        codegen_x86_64Emitter_emitGAS(e);
    }
}

fn codegen_x86_64Emitter_computeFrameSize(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc) -> i32 {
    let maxVReg: i32 = 0;
    {
        let items_243: []CodegenIRInstr = fn_value.Instrs;
        let count_245: i32 = len(items_243);
        for (let index_244: i32 = 0; index_244 < count_245; index_244++) {
            let instr: CodegenIRInstr = items_243[index_244];
            {
                let items_246: []CodegenOperand = [instr.Dst, instr.Src1, instr.Src2];
                let count_248: i32 = len(items_246);
                for (let index_247: i32 = 0; index_247 < count_248; index_247++) {
                    let op: CodegenOperand = items_246[index_247];
                    if (((op.Kind == 1) && ((op.Reg + 1) > maxVReg))) {
                        maxVReg = (op.Reg + 1);
                    }
                }
            }
            {
                let items_249: []CodegenOperand = instr.Args;
                let count_251: i32 = len(items_249);
                for (let index_250: i32 = 0; index_250 < count_251; index_250++) {
                    let op: CodegenOperand = items_249[index_250];
                    if (((op.Kind == 1) && ((op.Reg + 1) > maxVReg))) {
                        maxVReg = (op.Reg + 1);
                    }
                }
            }
        }
    }
    let totalSlots: i32 = ((fn_value.Locals + maxVReg) + 4);
    let size: i32 = (totalSlots * 8);
    if (((size % 16) != 0)) {
        size = (size + (16 - ((size % 16))));
    }
    if ((size < 16)) {
        size = 16;
    }
    return size;
}

// vregOffset returns the byte offset from %rbp for virtual register N.
fn codegen_x86_64Emitter_vregOffset(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, reg: i32) -> i32 {
    return -((((((fn_value.Locals + reg) + 1)) * 8)));
}

fn codegen_x86_64Emitter_emitGAS(e: CodegenX86_64Emitter) -> void {
    let w: StringBuilder = e.b;
    if ((len(e.mod.Strings) > 0)) {
        if ((e.target.OS == 0)) {
            w.append(".data\n");
        } else {
            w.append(".section __DATA,__data\n");
        }
        {
            let items_252: []CodegenIRStringConst = e.mod.Strings;
            let count_254: i32 = len(items_252);
            for (let index_253: i32 = 0; index_253 < count_254; index_253++) {
                let s: CodegenIRStringConst = items_252[index_253];
                let label: str = codegen_Target_Sym(e.target, s.Label);
                w.append((label + ":\n"));
                w.append(("    .asciz " + codegen_gasQuoteString(s.Value) + "\n"));
                w.append((label + "_len:\n"));
                w.append(("    .quad " + runtime_string_i32(s.Value.length()) + "\n"));
            }
        }
        w.append("\n");
    }
    if ((len(e.mod.Globals) > 0)) {
        if ((len(e.mod.Strings) == 0)) {
            if ((e.target.OS == 0)) {
                w.append(".data\n");
            } else {
                w.append(".section __DATA,__data\n");
            }
        }
        {
            let items_255: []CodegenIRGlobal = e.mod.Globals;
            let count_257: i32 = len(items_255);
            for (let index_256: i32 = 0; index_256 < count_257; index_256++) {
                let g: CodegenIRGlobal = items_255[index_256];
                let label: str = codegen_Target_Sym(e.target, g.Name);
                w.append((".p2align 3\n"));
                w.append((label + ":\n"));
                if ((g.InitStr >= 0)) {
                    let strLabel: str = codegen_Target_Sym(e.target, e.mod.Strings[g.InitStr].Label);
                    w.append(("    .quad " + strLabel + "\n"));
                } else {
                    w.append(("    .quad " + runtime_string_i64(g.InitImm) + "\n"));
                }
            }
        }
        w.append("\n");
    }
    if (codegen_x86_64Emitter_usesHeap(e)) {
        let heapPtrSym: str = codegen_Target_Sym(e.target, "_novus_heap_ptr");
        let heapEndSym: str = codegen_Target_Sym(e.target, "_novus_heap_end");
        w.append((".lcomm " + heapPtrSym + ", 8\n"));
        w.append((".lcomm " + heapEndSym + ", 8\n"));
        let gcTable: str = codegen_Target_Sym(e.target, "_novus_gc_table");
        let gcCount: str = codegen_Target_Sym(e.target, "_novus_gc_count");
        let gcThreshold: str = codegen_Target_Sym(e.target, "_novus_gc_threshold");
        let gcFreelist: str = codegen_Target_Sym(e.target, "_novus_gc_freelist");
        let gcStackBot: str = codegen_Target_Sym(e.target, "_novus_gc_stack_bottom");
        w.append((".lcomm " + gcTable + ", " + runtime_string_i32((e.target.GCEntries * 24)) + "\n"));
        w.append((".lcomm " + gcCount + ", 8\n"));
        w.append((".lcomm " + gcThreshold + ", 8\n"));
        w.append((".lcomm " + gcFreelist + ", 512\n"));
        w.append((".lcomm " + gcStackBot + ", 8\n\n"));
    }
    if ((e.target.OS == 0)) {
        w.append(".text\n");
    } else {
        w.append(".section __TEXT,__text\n");
    }
    let entryFuncName: str = codegen_Target_Sym(e.target, "main");
    w.append((".globl " + entryFuncName + "\n\n"));
    if ((e.target.OS == 0)) {
        w.append(".globl _start\n");
        w.append("_start:\n");
        if (codegen_x86_64Emitter_usesHeap(e)) {
            let gcStackBot: str = codegen_Target_Sym(e.target, "_novus_gc_stack_bottom");
            w.append(("    leaq " + gcStackBot + "(" + "%" + "rip), " + "%" + "rax\n"));
            w.append("    movq %rsp, (%rax)\n");
            let gcThreshold: str = codegen_Target_Sym(e.target, "_novus_gc_threshold");
            w.append(("    leaq " + gcThreshold + "(" + "%" + "rip), " + "%" + "rax\n"));
            w.append("    movq $256, (%rax)\n");
        }
        w.append("    movq (%rsp), %rdi\n");
        w.append("    leaq 8(%rsp), %rsi\n");
        if (codegen_hasRuntimeEnvpGlobal(e.mod)) {
            let envpSym: str = codegen_Target_Sym(e.target, "_g___novus_envp");
            w.append("    leaq 8(%rsi,%rdi,8), %rdx\n");
            w.append(("    leaq " + envpSym + "(" + "%" + "rip), " + "%" + "rax\n"));
            w.append("    movq %rdx, (%rax)\n");
        }
        w.append(("    call " + entryFuncName + "\n"));
        w.append("    movq %rax, %rdi\n");
        w.append("    movq $60, %rax\n");
        w.append("    syscall\n\n");
    }
    {
        let items_258: []CodegenIRFunc = e.mod.Functions;
        let count_260: i32 = len(items_258);
        for (let index_259: i32 = 0; index_259 < count_260; index_259++) {
            let fn_value: CodegenIRFunc = items_258[index_259];
            codegen_x86_64Emitter_emitGASFunction(e, fn_value);
        }
    }
    if (codegen_x86_64Emitter_usesHeap(e)) {
        codegen_x86_64Emitter_emitGASGCRuntime(e);
    }
}

fn codegen_x86_64Emitter_emitGASMmapSyscall(e: CodegenX86_64Emitter) -> void {
    let w: StringBuilder = e.b;
    w.append("    movq $0, %rdi\n");
    w.append(("    movq $" + runtime_string_i64(e.target.HeapSize) + ", " + "%" + "rsi\n"));
    w.append("    movq $3, %rdx\n");
    if ((e.target.OS == 1)) {
        w.append("    movq $0x1002, %r10\n");
        w.append("    movq $-1, %r8\n");
        w.append("    movq $0, %r9\n");
        w.append(("    movq $" + runtime_string_i64((197 + e.target.SyscallNumOffset)) + ", " + "%" + "rax\n"));
        w.append("    syscall\n");
    } else {
        w.append("    movq $0x22, %r10\n");
        w.append("    movq $-1, %r8\n");
        w.append("    movq $0, %r9\n");
        w.append("    movq $9, %rax\n");
        w.append("    syscall\n");
    }
}

fn codegen_x86_64Emitter_emitGASFunction(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc) -> void {
    let w: StringBuilder = e.b;
    let sym: str = codegen_Target_Sym(e.target, fn_value.Name);
    let frameSize: i32 = codegen_x86_64Emitter_computeFrameSize(e, fn_value);
    w.append((sym + ":\n"));
    w.append("    pushq %rbp\n");
    w.append("    movq %rsp, %rbp\n");
    if ((frameSize > 0)) {
        w.append(("    subq $" + runtime_string_i32(frameSize) + ", " + "%" + "rsp\n"));
    }
    if ((((fn_value.Name == "main") && (e.target.OS == 1)) && codegen_hasRuntimeEnvpGlobal(e.mod))) {
        let envpSym: str = codegen_Target_Sym(e.target, "_g___novus_envp");
        w.append(("    movq " + envpSym + "@GOTPCREL(" + "%" + "rip), " + "%" + "r11\n"));
        w.append("    movq %rdx, (%r11)\n");
    }
    if ((((fn_value.Name == "main") && (e.target.OS == 1)) && codegen_x86_64Emitter_usesHeap(e))) {
        let gcStackBot: str = codegen_Target_Sym(e.target, "_novus_gc_stack_bottom");
        w.append(("    leaq " + gcStackBot + "(" + "%" + "rip), " + "%" + "rax\n"));
        w.append("    leaq 16(%rbp), %rcx\n");
        w.append("    movq %rcx, (%rax)\n");
        let gcThreshold: str = codegen_Target_Sym(e.target, "_novus_gc_threshold");
        w.append(("    leaq " + gcThreshold + "(" + "%" + "rip), " + "%" + "rax\n"));
        w.append("    movq $256, (%rax)\n");
    }
    {
        let items_261: []CodegenIRInstr = fn_value.Instrs;
        let count_263: i32 = len(items_261);
        for (let index_262: i32 = 0; index_262 < count_263; index_262++) {
            let instr: CodegenIRInstr = items_261[index_262];
            codegen_x86_64Emitter_emitGASInstr(e, fn_value, instr);
        }
    }
    w.append("\n");
}

// promoteReg upgrades 32-bit x86 register names to 64-bit equivalents
// since we emit movq (64-bit) instructions.
fn codegen_promoteReg(name: str) -> str {
    let map_264: MapStrStr = new MapStrStr();
    MapStrStr_put(map_264, "ax", "rax");
    MapStrStr_put(map_264, "bx", "rbx");
    MapStrStr_put(map_264, "cx", "rcx");
    MapStrStr_put(map_264, "dx", "rdx");
    MapStrStr_put(map_264, "si", "rsi");
    MapStrStr_put(map_264, "di", "rdi");
    MapStrStr_put(map_264, "bp", "rbp");
    MapStrStr_put(map_264, "sp", "rsp");
    MapStrStr_put(map_264, "eax", "rax");
    MapStrStr_put(map_264, "ebx", "rbx");
    MapStrStr_put(map_264, "ecx", "rcx");
    MapStrStr_put(map_264, "edx", "rdx");
    MapStrStr_put(map_264, "esi", "rsi");
    MapStrStr_put(map_264, "edi", "rdi");
    MapStrStr_put(map_264, "ebp", "rbp");
    MapStrStr_put(map_264, "esp", "rsp");
    let m: MapStrStr = map_264;
    {
        let r: str = MapStrStr_get(m, name);
        let ok: bool = MapStrStr_has(m, name);
        if (ok) {
            return r;
        }
    }
    return name;
}

// loadToReg loads an operand value into the given scratch register.
// Returns the AT&T register string to use.
fn codegen_x86_64Emitter_gasLoadToReg(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, op: CodegenOperand, scratch: str) -> str {
    let w: StringBuilder = e.b;
    {
        let choice_265: i32 = op.Kind;
        if ((choice_265 == 2)) {
            return ("%" + codegen_promoteReg(op.PhysReg));
        } else if ((choice_265 == 3)) {
            w.append(("    movq $" + runtime_string_i64(op.Imm) + ", " + scratch + "\n"));
            return scratch;
        } else if ((choice_265 == 1)) {
            let off: i32 = codegen_x86_64Emitter_vregOffset(e, fn_value, op.Reg);
            w.append(("    movq " + runtime_string_i32(off) + "(" + "%" + "rbp), " + scratch + "\n"));
            return scratch;
        } else if ((choice_265 == 4)) {
            let label: str = e.mod.Strings[op.Imm].Label;
            let sym: str = codegen_Target_Sym(e.target, label);
            if ((e.target.OS == 1)) {
                w.append(("    leaq " + sym + "(" + "%" + "rip), " + scratch + "\n"));
            } else {
                w.append(("    leaq " + sym + "(" + "%" + "rip), " + scratch + "\n"));
            }
            return scratch;
        } else if ((choice_265 == 6)) {
            w.append(("    movq " + runtime_string_i64(op.MemOffset) + "(" + "%" + codegen_promoteReg(op.MemBase) + "), " + scratch + "\n"));
            return scratch;
        } else if ((choice_265 == 5)) {
            return op.Label;
        }
    }
    return scratch;
}

// gasSpillIfNeeded stores a scratch register back to a vreg's stack slot.
fn codegen_x86_64Emitter_gasSpillIfNeeded(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, op: CodegenOperand, reg: str) -> void {
    if ((op.Kind == 1)) {
        let off: i32 = codegen_x86_64Emitter_vregOffset(e, fn_value, op.Reg);
        e.b.append(("    movq " + reg + ", " + runtime_string_i32(off) + "(" + "%" + "rbp)\n"));
    }
}

// gasEnsureReg loads dst operand into scratch, returns the register or phys reg string.
fn codegen_x86_64Emitter_gasEnsureReg(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, op: CodegenOperand, scratch: str) -> str {
    return codegen_x86_64Emitter_gasLoadToReg(e, fn_value, op, scratch);
}

// gasStoreToOperand stores a register value into a destination operand.
fn codegen_x86_64Emitter_gasStoreToOperand(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, dst: CodegenOperand, reg: str) -> void {
    let w: StringBuilder = e.b;
    {
        let choice_266: i32 = dst.Kind;
        if ((choice_266 == 2)) {
            let promoted: str = ("%" + codegen_promoteReg(dst.PhysReg));
            if ((reg != promoted)) {
                w.append(("    movq " + reg + ", " + promoted + "\n"));
            }
        } else if ((choice_266 == 1)) {
            let off: i32 = codegen_x86_64Emitter_vregOffset(e, fn_value, dst.Reg);
            w.append(("    movq " + reg + ", " + runtime_string_i32(off) + "(" + "%" + "rbp)\n"));
        } else if ((choice_266 == 6)) {
            w.append(("    movq " + reg + ", " + runtime_string_i64(dst.MemOffset) + "(" + "%" + codegen_promoteReg(dst.MemBase) + ")\n"));
        }
    }
}

// emitGASMove writes physical-register destinations directly. Raw assembly
// code relies on values already placed in syscall registers surviving later
// mov() calls. Loading every source through %r10 used to turn sequences such
// as mov(r10, optionPtr); mov(r8, 4) into r10=4 immediately before syscall.
fn codegen_x86_64Emitter_emitGASMove(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, dst: CodegenOperand, src: CodegenOperand) -> void {
    if ((dst.Kind != 2)) {
        let loaded: str = codegen_x86_64Emitter_gasLoadToReg(e, fn_value, src, "%r10");
        codegen_x86_64Emitter_gasStoreToOperand(e, fn_value, dst, loaded);
        return;
    }
    let w: StringBuilder = e.b;
    let dstReg: str = ("%" + codegen_promoteReg(dst.PhysReg));
    {
        let choice_267: i32 = src.Kind;
        if ((choice_267 == 2)) {
            let srcReg: str = ("%" + codegen_promoteReg(src.PhysReg));
            if ((srcReg != dstReg)) {
                w.append(("    movq " + srcReg + ", " + dstReg + "\n"));
            }
        } else if ((choice_267 == 3)) {
            w.append(("    movq $" + runtime_string_i64(src.Imm) + ", " + dstReg + "\n"));
        } else if ((choice_267 == 1)) {
            w.append(("    movq " + runtime_string_i32(codegen_x86_64Emitter_vregOffset(e, fn_value, src.Reg)) + "(" + "%" + "rbp), " + dstReg + "\n"));
        } else if ((choice_267 == 4)) {
            let sym: str = codegen_Target_Sym(e.target, e.mod.Strings[src.Imm].Label);
            w.append(("    leaq " + sym + "(" + "%" + "rip), " + dstReg + "\n"));
        } else if ((choice_267 == 6)) {
            w.append(("    movq " + runtime_string_i64(src.MemOffset) + "(" + "%" + codegen_promoteReg(src.MemBase) + "), " + dstReg + "\n"));
        } else if ((choice_267 == 5)) {
            w.append(("    movq " + src.Label + ", " + dstReg + "\n"));
        }
    }
}

fn codegen_x86_64Emitter_emitGASInstr(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    {
        let choice_268: i32 = instr.Op;
        if ((choice_268 == 30)) {
            if (((instr.Dst.Kind == 5) && (instr.Dst.Label != fn_value.Name))) {
                w.append((instr.Dst.Label + ":\n"));
            }
        } else if ((choice_268 == 71)) {
            if ((instr.Src1.Kind == 5)) {
                w.append(("    ## " + instr.Src1.Label + "\n"));
            }
        } else if ((choice_268 == 0)) {
            codegen_x86_64Emitter_emitGASMove(e, fn_value, instr.Dst, instr.Src1);
        } else if ((choice_268 == 1)) {
            let scratch: str = "%r10";
            if ((instr.Src1.Kind == 4)) {
                let label: str = e.mod.Strings[instr.Src1.Imm].Label;
                let sym: str = codegen_Target_Sym(e.target, label);
                w.append(("    leaq " + sym + "(" + "%" + "rip), " + scratch + "\n"));
            } else {
                if ((instr.Src1.Kind == 5)) {
                    w.append(("    leaq " + codegen_Target_Sym(e.target, instr.Src1.Label) + "(" + "%" + "rip), " + scratch + "\n"));
                } else {
                    if ((instr.Src1.Kind == 1)) {
                        let off: i32 = codegen_x86_64Emitter_vregOffset(e, fn_value, instr.Src1.Reg);
                        w.append(("    leaq " + runtime_string_i32(off) + "(" + "%" + "rbp), " + scratch + "\n"));
                    } else {
                        if ((instr.Src1.Kind == 6)) {
                            w.append(("    leaq " + runtime_string_i64(instr.Src1.MemOffset) + "(" + "%" + codegen_promoteReg(instr.Src1.MemBase) + "), " + scratch + "\n"));
                        } else {
                            codegen_x86_64Emitter_gasLoadToReg(e, fn_value, instr.Src1, scratch);
                        }
                    }
                }
            }
            codegen_x86_64Emitter_gasStoreToOperand(e, fn_value, instr.Dst, scratch);
        } else if ((choice_268 == 2)) {
            let scratch: str = "%r10";
            if ((instr.Src1.Kind == 6)) {
                w.append(("    movq " + runtime_string_i64(instr.Src1.MemOffset) + "(" + "%" + codegen_promoteReg(instr.Src1.MemBase) + "), " + scratch + "\n"));
            } else {
                if ((instr.Src1.Kind == 4)) {
                    let label: str = e.mod.Strings[instr.Src1.Imm].Label;
                    let sym: str = codegen_Target_Sym(e.target, label);
                    w.append(("    leaq " + sym + "(" + "%" + "rip), " + scratch + "\n"));
                } else {
                    codegen_x86_64Emitter_gasLoadToReg(e, fn_value, instr.Src1, scratch);
                }
            }
            codegen_x86_64Emitter_gasStoreToOperand(e, fn_value, instr.Dst, scratch);
        } else if ((choice_268 == 3)) {
            let src: str = codegen_x86_64Emitter_gasLoadToReg(e, fn_value, instr.Src1, "%r10");
            if ((instr.Dst.Kind == 6)) {
                w.append(("    movq " + src + ", " + runtime_string_i64(instr.Dst.MemOffset) + "(" + "%" + codegen_promoteReg(instr.Dst.MemBase) + ")\n"));
            } else {
                if ((instr.Src2.Kind != 0)) {
                    let addr: str = codegen_x86_64Emitter_gasLoadToReg(e, fn_value, instr.Src2, "%r11");
                    w.append(("    movq " + src + ", (" + addr + ")\n"));
                }
            }
        } else if ((choice_268 == 4)) {
            let src: str = codegen_x86_64Emitter_gasLoadToReg(e, fn_value, instr.Src1, "%r10");
            w.append(("    pushq " + src + "\n"));
        } else if ((choice_268 == 5)) {
            if ((instr.Dst.Kind == 2)) {
                w.append(("    popq " + "%" + instr.Dst.PhysReg + "\n"));
            } else {
                w.append("    popq %r10\n");
                codegen_x86_64Emitter_gasStoreToOperand(e, fn_value, instr.Dst, "%r10");
            }
        } else if ((choice_268 == 6)) {
            codegen_x86_64Emitter_emitGASBinOp(e, fn_value, instr, "addq");
        } else if ((choice_268 == 7)) {
            codegen_x86_64Emitter_emitGASBinOp(e, fn_value, instr, "subq");
        } else if ((choice_268 == 8)) {
            codegen_x86_64Emitter_emitGASMul(e, fn_value, instr);
        } else if ((choice_268 == 9)) {
            codegen_x86_64Emitter_emitGASDiv(e, fn_value, instr);
        } else if ((choice_268 == 11)) {
            codegen_x86_64Emitter_emitGASUDiv(e, fn_value, instr);
        } else if ((choice_268 == 10)) {
            codegen_x86_64Emitter_emitGASMod(e, fn_value, instr);
        } else if ((choice_268 == 12)) {
            codegen_x86_64Emitter_emitGASUMod(e, fn_value, instr);
        } else if ((choice_268 == 13)) {
            let src: str = codegen_x86_64Emitter_gasLoadToReg(e, fn_value, instr.Src1, "%r10");
            w.append(("    negq " + src + "\n"));
            codegen_x86_64Emitter_gasStoreToOperand(e, fn_value, instr.Dst, src);
        } else if ((choice_268 == 17)) {
            let src: str = codegen_x86_64Emitter_gasLoadToReg(e, fn_value, instr.Src1, "%r10");
            w.append(("    xorq $1, " + src + "\n"));
            codegen_x86_64Emitter_gasStoreToOperand(e, fn_value, instr.Dst, src);
        } else if ((choice_268 == 14)) {
            codegen_x86_64Emitter_emitGASBinOp(e, fn_value, instr, "andq");
        } else if ((choice_268 == 15)) {

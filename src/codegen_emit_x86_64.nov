    codegen_x86_64Emitter_emitFastCollector(e, false);
    w.append("\n");
    w.append(gcAllocSym);
    w.append(":\n    pushq %rbp\n    movq %rsp, %rbp\n    pushq %rbx\n    pushq %r12\n    addq $7, %rdi\n    andq $-8, %rdi\n    cmpq $16, %rdi\n    jge .Lgca_size_ok_gas\n    movq $16, %rdi\n.Lgca_size_ok_gas:\n    call ");
    w.append(codegen_Target_Sym(e.target, "_novus_gc_round"));
    w.append("\n    movq %rax, %rdi\n    movq %rdi, %r12\n    leaq ");
    w.append(gcCount);
    w.append("(%rip), %rax\n    movq (%rax), %rcx\n    leaq ");
    w.append(gcThreshold);
    w.append("(%rip), %rax\n    movq (%rax), %rdx\n    cmpq %rdx, %rcx\n    jge .Lgca_collect_gas\n    cmpq $");
    w.append(runtime_string_i32(e.target.GCEntries));
    w.append(", %rcx\n    jl .Lgca_try_free_gas\n.Lgca_collect_gas:\n    call ");
    w.append(gcCollectSym);
    w.append("\n.Lgca_try_free_gas:\n    leaq ");
    w.append(gcFreelist);
    w.append("(%rip), %rdi\n    movq %r12, %rsi\n    call ");
    w.append(codegen_Target_Sym(e.target, "_novus_gc_take"));
    w.append("\n    testq %rax, %rax\n    jz .Lgca_bump_gas\n    movq %rax, %rbx\n    jmp .Lgca_register_bump_gas\n.Lgca_bump_gas:\n    leaq ");
    w.append(heapPtrSym);
    w.append("(%rip), %rcx\n    movq (%rcx), %rax\n    testq %rax, %rax\n    jz .Lgca_region_init_gas\n.Lgca_region_try_gas:\n    leaq (%rax,%r12), %r11\n    leaq ");
    w.append(heapEndSym);

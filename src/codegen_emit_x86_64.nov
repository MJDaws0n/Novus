fn codegen_x86_64Emitter_emitNASMFunction(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc) -> void {
    let w: StringBuilder = e.b;
    let frameSize: i32 = codegen_x86_64Emitter_computeFrameSize(e, fn_value);

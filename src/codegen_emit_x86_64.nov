    codegen_x86_64Emitter_emitGASMmapSyscall(e);
    w.append("    popq %rcx\n    movq %rax, %r10\n    movq %r10, (%rcx)\n    leaq ");
    w.append(heapEndSym);
    w.append("(%rip), %rdx\n    leaq ");
    w.append(runtime_string_i64(e.target.HeapSize));
    w.append("(%r10), %r11\n    movq %r11, (%rdx)\n    movq %r10, %rax\n    jmp .Lgca_region_try_gas\n.Lgca_region_grow_gas:\n    pushq %rcx\n");
    codegen_x86_64Emitter_emitGASMmapSyscall(e);
    w.append("    popq %rcx\n    movq %rax, %r10\n    movq %r10, (%rcx)\n    leaq ");

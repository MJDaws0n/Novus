            w.append("    _novus_win_envp: resq 1\n");
            w.append("    _novus_win_newmode: resd 1\n");
        }
        w.append("\n");
    }
    if ((len(e.mod.Globals) > 0)) {
        if ((len(e.mod.Strings) == 0)) {
            w.append("section .data\n");

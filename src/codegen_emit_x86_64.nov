fn codegen_x86_64Emitter_emitNASMBinOp(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr, mnemonic: str) -> void {
    let w: StringBuilder = e.b;
    let src1: str = codegen_x86_64Emitter_nasmLoadToReg(e, fn_value, instr.Src1, "r10");
    let src2: str = codegen_x86_64Emitter_nasmLoadToReg(e, fn_value, instr.Src2, "r11");
    if ((src1 != "r10")) {
        w.append(("    mov r10, " + src1 + "\n"));
    }
    w.append(("    " + mnemonic + " r10, " + src2 + "\n"));
    codegen_x86_64Emitter_nasmStoreToOperand(e, fn_value, instr.Dst, "r10");
}

fn codegen_x86_64Emitter_emitNASMCmp(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr, setcc: str) -> void {
    let w: StringBuilder = e.b;
    let src1: str = codegen_x86_64Emitter_nasmLoadToReg(e, fn_value, instr.Src1, "r10");
    let src2: str = codegen_x86_64Emitter_nasmLoadToReg(e, fn_value, instr.Src2, "r11");
    if ((src1 != "r10")) {
        w.append(("    mov r10, " + src1 + "\n"));
    }
    w.append(("    cmp r10, " + src2 + "\n"));
    w.append(("    " + setcc + " r10b\n"));
    w.append("    movzx r10, r10b\n");
    codegen_x86_64Emitter_nasmStoreToOperand(e, fn_value, instr.Dst, "r10");
}

// emitNASMFBinOp handles addsd, subsd, mulsd, divsd.
fn codegen_x86_64Emitter_emitNASMFBinOp(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr, mnemonic: str) -> void {
    let w: StringBuilder = e.b;
    let src1: str = codegen_x86_64Emitter_nasmLoadToReg(e, fn_value, instr.Src1, "r10");
    let src2: str = codegen_x86_64Emitter_nasmLoadToReg(e, fn_value, instr.Src2, "r11");
    w.append(("    movq xmm0, " + src1 + "\n"));
    w.append(("    movq xmm1, " + src2 + "\n"));
    w.append(("    " + mnemonic + " xmm0, xmm1\n"));
    w.append("    movq r10, xmm0\n");
    codegen_x86_64Emitter_nasmStoreToOperand(e, fn_value, instr.Dst, "r10");
}

// emitNASMFMod handles fmod (a - trunc(a/b) * b).
fn codegen_x86_64Emitter_emitNASMFMod(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let src1: str = codegen_x86_64Emitter_nasmLoadToReg(e, fn_value, instr.Src1, "r10");
    let src2: str = codegen_x86_64Emitter_nasmLoadToReg(e, fn_value, instr.Src2, "r11");
    w.append(("    movq xmm0, " + src1 + "\n"));
    w.append(("    movq xmm1, " + src2 + "\n"));
    w.append("    movapd xmm2, xmm0\n");
    w.append("    divsd xmm2, xmm1\n");
    w.append("    cvttsd2si r11, xmm2\n");
    w.append("    cvtsi2sd xmm2, r11\n");
    w.append("    mulsd xmm2, xmm1\n");
    w.append("    subsd xmm0, xmm2\n");
    w.append("    movq r10, xmm0\n");
    codegen_x86_64Emitter_nasmStoreToOperand(e, fn_value, instr.Dst, "r10");
}

// emitNASMFNeg handles fneg (flip the sign bit).
fn codegen_x86_64Emitter_emitNASMFNeg(e: CodegenX86_64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;

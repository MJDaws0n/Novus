class AstClassBinding {
    pub let Name: str = "";
    pub let Class: AstNode = null;
    pub let Pos: AstPosition = CompilerState.zeroPosition;
}

fn copy_AstClassBinding(value: AstClassBinding) -> AstClassBinding {
    let result: AstClassBinding = new AstClassBinding();
    result.Name = value.Name;
    result.Class = value.Class;
    result.Pos = value.Pos;
    return result;
}


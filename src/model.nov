// Stable, insertion-ordered maps keep their public key/value arrays. Hash
// buckets only accelerate lookup; resizing and deletion preserve iteration order.
fn compiler_hash_string(key: str) -> i32 {
    let hash: i32 = 5381;
    let address: u64 = ptr(key);
    let byte: i32 = load8(address);
    while (byte != 0) { hash = (hash * 33) ^ byte; address++; byte = load8(address); }
    return hash & 2147483647;
}

class MapStrStr {
    pub let keys: []str = [];
    pub let buckets: []i32 = [];
    pub let values: []str = [];
}

fn MapStrStr_index(map: MapStrStr, key: str) -> i32 {
    if (map == null) { return -1; }
    let capacity: i32 = len(map.buckets);
    if (capacity == 0) {
        for (let i: i32 = 0; i < len(map.keys); i++) {
            if (map.keys[i] == key) { return i; }
        }
        return -1;
    }
    let slot: i32 = compiler_hash_string(key) & (capacity - 1);
    while (map.buckets[slot] != 0) {
        let i: i32 = map.buckets[slot] - 1;
        if (map.keys[i] == key) { return i; }
        slot = (slot + 1) & (capacity - 1);
    }
    return -1;
}

fn MapStrStr_rehash(map: MapStrStr, capacity: i32) -> void {
    if (len(map.buckets) != capacity) { map.buckets = array_I32(capacity); }
    else { for (let i: i32 = 0; i < capacity; i++) { map.buckets[i] = 0; } }
    for (let i: i32 = 0; i < len(map.keys); i++) {
        let slot: i32 = compiler_hash_string(map.keys[i]) & (capacity - 1);
        while (map.buckets[slot] != 0) { slot = (slot + 1) & (capacity - 1); }
        map.buckets[slot] = i + 1;
    }
}

fn MapStrStr_has(map: MapStrStr, key: str) -> bool {
    return MapStrStr_index(map, key) >= 0;
}

fn MapStrStr_get(map: MapStrStr, key: str) -> str {
    let index: i32 = MapStrStr_index(map, key);
    if (index < 0) { return ""; }
    return map.values[index];
}

fn MapStrStr_put(map: MapStrStr, key: str, value: str) -> void {
    let index: i32 = MapStrStr_index(map, key);
    if (index >= 0) { map.values[index] = value; return; }
    array_append(map.keys, key);
    array_append(map.values, value);
    let count: i32 = len(map.keys);
    if (count < 8 && len(map.buckets) == 0) { return; }
    let capacity: i32 = len(map.buckets);
    if (count * 2 > capacity) {
        if (capacity == 0) { capacity = 8; }
        MapStrStr_rehash(map, capacity * 2);
        return;
    }
    let slot: i32 = compiler_hash_string(key) & (capacity - 1);
    while (map.buckets[slot] != 0) { slot = (slot + 1) & (capacity - 1); }
    map.buckets[slot] = count;
}

fn MapStrStr_length(map: MapStrStr) -> i32 {
    if (map == null) { return 0; }
    return len(map.keys);
}

fn MapStrStr_delete(map: MapStrStr, key: str) -> void {
    let index: i32 = MapStrStr_index(map, key);
    if (index < 0) { return; }
    for (let i: i32 = index; i + 1 < len(map.keys); i++) {
        map.keys[i] = map.keys[i + 1];
        map.values[i] = map.values[i + 1];
    }
    array_pop(map.keys);
    array_pop(map.values);
    if (len(map.buckets) != 0) { MapStrStr_rehash(map, len(map.buckets)); }
}


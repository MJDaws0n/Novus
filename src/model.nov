// Empty list fields are shared read-only; append/extend helpers materialize
// a private list on first use. Tokens and source positions are immutable.
class AstNode {
    pub let Kind: str;
    pub let Operand: AstNode = null;
    pub let Pos: AstPosition = CompilerState.zeroPosition;
    pub let Elems: []AstNode = CompilerState.empty_AstNode;
    pub let Target: AstNode = null;

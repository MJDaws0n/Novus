class CodegenLowerer {
    pub let module_value: CodegenIRModule = null;
    pub let target: CodegenTarget = null;
    pub let fn_value: CodegenIRFunc = null;
    pub let nextVReg: i32 = 0;
    pub let nextLabel: i32 = 0;
    pub let vars: MapStrI32 = null;
    pub let nextSlot: i32 = 0;
    pub let varTypes: MapStrStr = null;
    pub let vregIsStr: MapI32Bool = null;
    pub let vregIsFloat: MapI32Bool = null;
    pub let vregIsUnsigned: MapI32Bool = null;
    pub let funcRetTypes: MapStrStr = null;
    pub let funcParamTypes: MapStrArraystr = null;
    pub let currentRetType: str = "";
    pub let loopBreakLabel: str = "";
    pub let loopContinueLabel: str = "";
    pub let physRegs: MapStrBool = null;
    pub let globals: MapStrStr = null;
    pub let globalTypes: MapStrStr = null;
    pub let globalInits: []AstNode = [];
    pub let funcOverloads: MapStrArraycodegenfuncoverloadentry = null;
}

fn copy_CodegenLowerer(value: CodegenLowerer) -> CodegenLowerer {
    let result: CodegenLowerer = new CodegenLowerer();
    result.module_value = value.module_value;
    result.target = value.target;
    result.fn_value = value.fn_value;
    result.nextVReg = value.nextVReg;
    result.nextLabel = value.nextLabel;
    result.vars = value.vars;
    result.nextSlot = value.nextSlot;
    result.varTypes = value.varTypes;
    result.vregIsStr = value.vregIsStr;
    result.vregIsFloat = value.vregIsFloat;
    result.vregIsUnsigned = value.vregIsUnsigned;
    result.funcRetTypes = value.funcRetTypes;
    result.funcParamTypes = value.funcParamTypes;
    result.currentRetType = value.currentRetType;
    result.loopBreakLabel = value.loopBreakLabel;
    result.loopContinueLabel = value.loopContinueLabel;
    result.physRegs = value.physRegs;
    result.globals = value.globals;
    result.globalTypes = value.globalTypes;
    result.globalInits = value.globalInits;
    result.funcOverloads = value.funcOverloads;
    return result;
}


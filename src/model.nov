    if (len(items) == 0) { items = []; }
    array_append(items, value);
    return items;
}

fn extend_Str(items: []str, more: []str) -> []str {
    if (len(items) == 0 && len(more) != 0) { items = []; }
    let count: i32 = len(more);
    for (let i: i32 = 0; i < count; i++) { array_append(items, more[i]); }
    return items;
}

fn slice_Str(items: []str, start: i32, end: i32) -> []str {
    let result: []str = [];
    for (let i: i32 = start; i < end; i++) { array_append(result, items[i]); }
    return result;
}

fn contains_Str(items: []str, value: str) -> bool {
    for (let i: i32 = 0; i < len(items); i++) {
        if (items[i] == value) { return true; }
    }
    return false;
}


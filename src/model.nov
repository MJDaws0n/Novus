fn copy_AstNode(value: AstNode) -> AstNode {
    let result: AstNode = new AstNode();
    result.Kind = value.Kind;
    result.Operand = value.Operand;
    result.Pos = value.Pos;
    result.Elems = value.Elems;
    result.Target = value.Target;
    result.Value = value.Value;
    result.Op = value.Op;
    result.Left = value.Left;
    result.Right = value.Right;
    result.Stmts = value.Stmts;
    result.BoolValue = value.BoolValue;
    result.Callee = value.Callee;
    result.Args = value.Args;
    result.Receiver = value.Receiver;
    result.ResolvedCallee = value.ResolvedCallee;
    result.Name = value.Name;
    result.Fields = value.Fields;
    result.Initializers = value.Initializers;
    result.Methods = value.Methods;
    result.SourceFile = value.SourceFile;
    result.Variable = value.Variable;
    result.Operator = value.Operator;
    result.TextValue = value.TextValue;
    result.Imports = value.Imports;
    result.Functions = value.Functions;
    result.Globals = value.Globals;
    result.Classes = value.Classes;
    result.Expression = value.Expression;
    result.MangledName = value.MangledName;
    result.Params = value.Params;
    result.ReturnType = value.ReturnType;
    result.Body = value.Body;
    result.Imported = value.Imported;
    result.Init = value.Init;
    result.Condition = value.Condition;
    result.Update = value.Update;
    result.Type = value.Type;
    result.RuntimeInit = value.RuntimeInit;
    result.Then = value.Then;
    result.Else = value.Else;
    result.Path = value.Path;
    result.Alias = value.Alias;
    result.SelectFns = value.SelectFns;
    result.Object = value.Object;
    result.Index = value.Index;
    result.ArrayType = value.ArrayType;
    result.Field = value.Field;
    result.ResolvedField = value.ResolvedField;
    result.ClassName = value.ClassName;
    result.Constructor = value.Constructor;
    result.Slots = value.Slots;
    result.Module = value.Module;
    result.ClassHelpers = value.ClassHelpers;
    result.ClassScopes = value.ClassScopes;
    result.ClassGlobals = value.ClassGlobals;
    result.ClassFunctions = value.ClassFunctions;
    result.Startup = value.Startup;
    result.CompTimeBlocks = value.CompTimeBlocks;
    return result;
}


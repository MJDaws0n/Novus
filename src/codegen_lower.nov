fn codegen_Lowerer_freshVReg(l: CodegenLowerer) -> i32 {
    let r: i32 = l.nextVReg;
    l.nextVReg++;
    return r;
}

fn codegen_Lowerer_freshLabel(l: CodegenLowerer, prefix: str) -> str {
    let lbl: str = (".L" + prefix + "_" + runtime_string_i32(l.nextLabel));
    l.nextLabel++;
    return lbl;
}

fn codegen_Lowerer_emit(l: CodegenLowerer, instr: CodegenIRInstr) -> void {
    codegen_IRFunc_Emit(l.fn_value, instr);
}

fn codegen_Lowerer_emitComment(l: CodegenLowerer, text: str) -> void {
    codegen_Lowerer_emit(l, make_CodegenIRInstr_22(71, copy_CodegenOperand(codegen_LabelOp(text))));
}

// allocVar allocates a stack slot for a local variable and returns the slot index.
fn codegen_Lowerer_allocVar(l: CodegenLowerer, name: str) -> i32 {
    let slot: i32 = l.nextSlot;
    MapStrI32_put(l.vars, name, slot);
    l.nextSlot++;
    if ((l.nextSlot > l.fn_value.Locals)) {
        l.fn_value.Locals = l.nextSlot;
    }
    return slot;
}

// varSlot returns the stack slot for a variable, or -1 if not found.
fn codegen_Lowerer_varSlot(l: CodegenLowerer, name: str) -> i32 {
    {
        let slot: i32 = MapStrI32_get(l.vars, name);
        let ok: bool = MapStrI32_has(l.vars, name);
        if (ok) {
            return slot;
        }
    }
    return -1;
}

// slotMem returns a memory operand addressing the given stack slot.
// Slots are addressed as [rbp - (slot+1)*ptrSize].
fn codegen_Lowerer_slotMem(l: CodegenLowerer, slot: i32) -> CodegenOperand {
    let offset: i64 = -(runtime_to_i64((((slot + 1)) * l.target.PtrSize)));
    return copy_CodegenOperand(codegen_Mem(l.target.BasePointer, offset));
}

fn codegen_Lowerer_lowerGlobal(l: CodegenLowerer, g: AstNode) -> void {
    let label: str = ("_g_" + g.Name);
    let typeName: str = "";
    if ((g.Type != null)) {
        typeName = g.Type.Name;
    }
    MapStrStr_put(l.globals, g.Name, label);
    MapStrStr_put(l.globalTypes, g.Name, typeName);
    let irGlobal: CodegenIRGlobal = make_CodegenIRGlobal_23(label, typeName, 0, -1);
    if ((g.Value != null)) {
        if ((g.RuntimeInit || runtime_strings_HasPrefix(typeName, "[]"))) {
            l.globalInits = append_Astnode(l.globalInits, g);
        }
        {
            let choice_391: AstNode = g.Value;
            if ((choice_391 != null && choice_391.Kind == "IntLitExpr")) {
                let v: AstNode = choice_391;
                let result_392: ResultI64Str = runtime_strconv_ParseInt(v.TextValue, 0, 64);
                let val: i64 = result_392.value0;
                let err: str = result_392.value1;
                if ((err == "")) {
                    irGlobal.InitImm = val;
                }
            } else if ((choice_391 != null && choice_391.Kind == "FloatLitExpr")) {
                let v: AstNode = choice_391;
                let result_393: ResultF64Str = runtime_strconv_ParseFloat(v.TextValue, 64);
                let val: f64 = result_393.value0;
                let err: str = result_393.value1;
                if ((err == "")) {
                    irGlobal.InitImm = runtime_to_i64(runtime_math_Float64bits(val));
                }
            } else if ((choice_391 != null && choice_391.Kind == "BoolLitExpr")) {
                let v: AstNode = choice_391;
                if (v.BoolValue) {
                    irGlobal.InitImm = 1;
                }
            } else if ((choice_391 != null && choice_391.Kind == "StringLitExpr")) {
                let v: AstNode = choice_391;
                let raw: ByteBuffer = codegen_stringLiteralValue(v.TextValue);
                let idx: i32 = codegen_IRModule_AddString(l.module_value, raw);
                irGlobal.InitStr = idx;
            }
        }
    }
    l.module_value.Globals = append_Codegenirglobal(l.module_value.Globals, copy_CodegenIRGlobal(irGlobal));
}

fn codegen_Lowerer_lowerFunction(l: CodegenLowerer, fn_value: AstNode, startup: []AstNode) -> void {
    let irName: str = fn_value.MangledName;
    if ((irName == "")) {
        irName = fn_value.Name;
    }
    let irFn: CodegenIRFunc = make_CodegenIRFunc_24(irName, array_Str(len(fn_value.Params)), len(fn_value.Params), fn_value.Imported);
    l.fn_value = irFn;
    l.nextVReg = 0;
    l.nextSlot = 0;
    l.vars = new MapStrI32();
    l.loopBreakLabel = "";
    l.loopContinueLabel = "";
    let map_394: MapStrStr = new MapStrStr();
    l.varTypes = map_394;
    let map_395: MapI32Bool = new MapI32Bool();
    l.vregIsStr = map_395;
    let map_396: MapI32Bool = new MapI32Bool();
    l.vregIsFloat = map_396;
    let map_397: MapI32Bool = new MapI32Bool();
    l.vregIsUnsigned = map_397;
    l.currentRetType = codegen_typeExprName(fn_value.ReturnType);
    codegen_Lowerer_emit(l, make_CodegenIRInstr_25(30, copy_CodegenOperand(codegen_LabelOp(irName))));
    codegen_Lowerer_emitComment(l, ("function " + fn_value.Name));
    {
        let items_398: []AstParam = fn_value.Params;
        let count_400: i32 = len(items_398);
        for (let index_399: i32 = 0; index_399 < count_400; index_399++) {
            let i: i32 = index_399;
            let param: AstParam = items_398[index_399];
            irFn.ParamNames[i] = param.Name;
            if ((param.Type != null)) {
                MapStrStr_put(l.varTypes, param.Name, param.Type.Name);
            }
            let slot: i32 = codegen_Lowerer_allocVar(l, param.Name);
            if ((i < len(l.target.ArgRegs))) {
                codegen_Lowerer_emit(l, make_CodegenIRInstr_2(3, copy_CodegenOperand(codegen_Lowerer_slotMem(l, slot)), copy_CodegenOperand(codegen_PReg(l.target.ArgRegs[i]))));
            } else {
                let baseOffset: i32 = (2 * l.target.PtrSize);
                let shadowSpace: i32 = 0;
                if (((l.target.OS == 2) && (l.target.Arch == 0))) {
                    shadowSpace = 32;
                }
                let callerOffset: i64 = runtime_to_i64(((baseOffset + shadowSpace) + (((i - len(l.target.ArgRegs))) * l.target.StackArgSlotSize)));
                let tmpReg: i32 = codegen_Lowerer_freshVReg(l);
                codegen_Lowerer_emit(l, make_CodegenIRInstr_2(2, copy_CodegenOperand(codegen_VReg(tmpReg)), copy_CodegenOperand(codegen_Mem(l.target.BasePointer, callerOffset))));
                codegen_Lowerer_emit(l, make_CodegenIRInstr_2(3, copy_CodegenOperand(codegen_Lowerer_slotMem(l, slot)), copy_CodegenOperand(codegen_VReg(tmpReg))));
            }
        }
    }
    if ((fn_value.Name == l.module_value.EntryFunc)) {
        {
            let items_401: []AstNode = startup;
            let count_403: i32 = len(items_401);
            for (let index_402: i32 = 0; index_402 < count_403; index_402++) {
                let stmt: AstNode = items_401[index_402];
                codegen_Lowerer_lowerStmt(l, stmt);
            }
        }
        {
            let items_404: []AstNode = l.globalInits;
            let count_406: i32 = len(items_404);
            for (let index_405: i32 = 0; index_405 < count_406; index_405++) {
                let g: AstNode = items_404[index_405];
                let value: CodegenOperand = copy_CodegenOperand(codegen_Lowerer_lowerExprForType(l, g.Value, codegen_typeExprName(g.Type)));
                codegen_Lowerer_emit(l, make_CodegenIRInstr_2(56, copy_CodegenOperand(codegen_LabelOp(MapStrStr_get(l.globals, g.Name))), copy_CodegenOperand(value)));
            }
        }
    }
    codegen_Lowerer_lowerBlock(l, fn_value.Body);
    if (((len(irFn.Instrs) == 0) || (irFn.Instrs[(len(irFn.Instrs) - 1)].Op != 32))) {
        codegen_Lowerer_emit(l, make_CodegenIRInstr_26(32));
    }
    let frameSize: i32 = (irFn.Locals * l.target.PtrSize);
    if (((frameSize % 16) != 0)) {
        frameSize = (frameSize + (16 - ((frameSize % 16))));
    }
    irFn.FrameSize = frameSize;
    l.module_value.Functions = append_Codegenirfunc(l.module_value.Functions, irFn);
}

fn codegen_Lowerer_lowerBlock(l: CodegenLowerer, block: AstNode) -> void {
    let assigned_407: MapStrI32 = l.vars;
    let assigned_408: MapStrStr = l.varTypes;
    let outerVars: MapStrI32 = assigned_407;
    let outerTypes: MapStrStr = assigned_408;
    l.vars = new MapStrI32();
    l.varTypes = new MapStrStr();
    {
        let items_409: MapStrI32 = outerVars;
        let count_411: i32 = MapStrI32_length(items_409);
        for (let index_410: i32 = 0; index_410 < count_411; index_410++) {
            let name: str = items_409.keys[index_410];
            let slot: i32 = items_409.values[index_410];
            MapStrI32_put(l.vars, name, slot);
        }
    }
    {
        let items_412: MapStrStr = outerTypes;
        let count_414: i32 = MapStrStr_length(items_412);
        for (let index_413: i32 = 0; index_413 < count_414; index_413++) {
            let name: str = items_412.keys[index_413];
            let typ: str = items_412.values[index_413];
            MapStrStr_put(l.varTypes, name, typ);
        }
    }
    {
        let items_415: []AstNode = block.Stmts;
        let count_417: i32 = len(items_415);
        for (let index_416: i32 = 0; index_416 < count_417; index_416++) {
            let stmt: AstNode = items_415[index_416];
            codegen_Lowerer_lowerStmt(l, stmt);
        }
    }
    let assigned_418: MapStrI32 = outerVars;
    let assigned_419: MapStrStr = outerTypes;
    l.vars = assigned_418;
    l.varTypes = assigned_419;
}

fn codegen_Lowerer_lowerStmt(l: CodegenLowerer, stmt: AstNode) -> void {
    {
        let choice_420: AstNode = stmt;
        if ((choice_420 != null && choice_420.Kind == "LetStmt")) {
            let s: AstNode = choice_420;
            codegen_Lowerer_lowerLetStmt(l, s);
        } else if ((choice_420 != null && choice_420.Kind == "ReturnStmt")) {
            let s: AstNode = choice_420;
            codegen_Lowerer_lowerReturnStmt(l, s);
        } else if ((choice_420 != null && choice_420.Kind == "IfStmt")) {
            let s: AstNode = choice_420;
            codegen_Lowerer_lowerIfStmt(l, s);
        } else if ((choice_420 != null && choice_420.Kind == "WhileStmt")) {
            let s: AstNode = choice_420;
            codegen_Lowerer_lowerWhileStmt(l, s);
        } else if ((choice_420 != null && choice_420.Kind == "ForStmt")) {
            let s: AstNode = choice_420;
            codegen_Lowerer_lowerForStmt(l, s);
        } else if ((choice_420 != null && choice_420.Kind == "ExprStmt")) {
            let s: AstNode = choice_420;
            codegen_Lowerer_lowerExpr(l, s.Expression);
        } else if ((choice_420 != null && choice_420.Kind == "AssignStmt")) {
            let s: AstNode = choice_420;
            codegen_Lowerer_lowerAssignStmt(l, s);
        } else if ((choice_420 != null && choice_420.Kind == "BlockStmt")) {
            let s: AstNode = choice_420;
            codegen_Lowerer_lowerBlock(l, s);
        } else if ((choice_420 != null && choice_420.Kind == "BreakStmt")) {
            let s: AstNode = choice_420;
            if ((l.loopBreakLabel != "")) {
                codegen_Lowerer_emit(l, make_CodegenIRInstr_25(27, copy_CodegenOperand(codegen_LabelOp(l.loopBreakLabel))));
            }
        } else if ((choice_420 != null && choice_420.Kind == "ContinueStmt")) {
            let s: AstNode = choice_420;
            if ((l.loopContinueLabel != "")) {
                codegen_Lowerer_emit(l, make_CodegenIRInstr_25(27, copy_CodegenOperand(codegen_LabelOp(l.loopContinueLabel))));
            }
        }
    }
}

fn codegen_Lowerer_lowerLetStmt(l: CodegenLowerer, s: AstNode) -> void {
    let slot: i32 = codegen_Lowerer_allocVar(l, s.Name);
    if ((s.Type != null)) {
        MapStrStr_put(l.varTypes, s.Name, s.Type.Name);

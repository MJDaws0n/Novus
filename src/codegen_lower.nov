// win_call("FuncName", arg1, arg2, ...) — call a Windows API function.
// The first argument must be a string literal naming the API function.
// Remaining arguments are passed via Windows x64 calling convention.
fn codegen_Lowerer_builtinWinCall(l: CodegenLowerer, e: AstNode) -> CodegenOperand {
    if ((len(e.Args) < 1)) {
        return copy_CodegenOperand(codegen_None());
    }
    let nameArg: AstNode = e.Args[0];
    let apiName: str = "";
    {
        let strLit: AstNode = nameArg;
        let ok: bool = (nameArg != null && nameArg.Kind == "StringLitExpr");
        if (ok) {
            let raw: str = strLit.TextValue;
            if (((len(raw) >= 2) && (((byte_at(raw, 0) == 34) || (byte_at(raw, 0) == 39))))) {
                raw = runtime_substring(raw, 1, (len(raw) - 1));
            }
            apiName = raw;
        }
    }
    if ((apiName == "")) {
        apiName = "unknown_win_api";
    }
    let argOps: []CodegenOperand = [];
    {
        let items_454: []AstNode = slice_Astnode(e.Args, 1, len(e.Args));
        let count_456: i32 = len(items_454);
        for (let index_455: i32 = 0; index_455 < count_456; index_455++) {
            let arg: AstNode = items_454[index_455];
            argOps = append_Codegenoperand(argOps, copy_CodegenOperand(codegen_Lowerer_lowerExpr(l, arg)));
        }
    }
    let dst: i32 = codegen_Lowerer_freshVReg(l);
    codegen_Lowerer_emit(l, make_CodegenIRInstr_27(54, copy_CodegenOperand(codegen_VReg(dst)), copy_CodegenOperand(codegen_LabelOp(apiName)), argOps));
    return copy_CodegenOperand(codegen_VReg(dst));
}

fn codegen_unescapeString(s: str) -> ByteBuffer {
    let b: ByteBuffer = new ByteBuffer();
    {
        let i: i32 = 0;
        for (; (i < len(s)); i++) {
            if (((byte_at(s, i) == 92) && ((i + 1) < len(s)))) {
                {
                    let choice_457: i32 = byte_at(s, (i + 1));
                    if ((choice_457 == 110)) {
                        b.append(10);
                    } else if ((choice_457 == 114)) {
                        b.append(13);
                    } else if ((choice_457 == 116)) {
                        b.append(9);
                    } else if ((choice_457 == 92)) {
                        b.append(92);
                    } else if ((choice_457 == 34)) {
                        b.append(34);
                    } else if ((choice_457 == 39)) {
                        b.append(39);
                    } else if ((choice_457 == 48)) {
                        b.append(0);
                    } else {
                        b.append(byte_at(s, (i + 1)));
                    }
                }
                i++;
            } else {
                b.append(byte_at(s, i));
            }
        }
    }
    return b;
}


// Lower translates an AST Program into an IRModule for the given target.
fn codegen_Lower(program: AstNode, target: CodegenTarget) -> CodegenIRModule {
    let functions: []AstNode = extend_Astnode(extend_Astnode([], program.Functions), program.ClassFunctions);
    let map_369: MapStrStr = new MapStrStr();
    let funcRetTypes: MapStrStr = map_369;
    let map_370: MapStrArraystr = new MapStrArraystr();
    let funcParamTypes: MapStrArraystr = map_370;
    {
        let items_371: []AstNode = functions;
        let count_373: i32 = len(items_371);
        for (let index_372: i32 = 0; index_372 < count_373; index_372++) {
            let fn_value: AstNode = items_371[index_372];
            let key: str = fn_value.MangledName;
            if ((key == "")) {
                key = fn_value.Name;
            }
            if ((fn_value.ReturnType != null)) {
                MapStrStr_put(funcRetTypes, key, fn_value.ReturnType.Name);
            }
            let paramTypes: []str = array_Str(len(fn_value.Params));
            {
                let items_374: []AstParam = fn_value.Params;
                let count_376: i32 = len(items_374);
                for (let index_375: i32 = 0; index_375 < count_376; index_375++) {
                    let i: i32 = index_375;
                    let param: AstParam = items_374[index_375];
                    if ((param.Type != null)) {
                        paramTypes[i] = param.Type.Name;
                    }
                }
            }
            MapStrArraystr_put(funcParamTypes, key, paramTypes);
        }
    }
    let map_377: MapStrArraycodegenfuncoverloadentry = new MapStrArraycodegenfuncoverloadentry();
    let funcOverloads: MapStrArraycodegenfuncoverloadentry = map_377;
    {
        let items_378: []AstNode = functions;
        let count_380: i32 = len(items_378);
        for (let index_379: i32 = 0; index_379 < count_380; index_379++) {
            let fn_value: AstNode = items_378[index_379];
            let irName: str = fn_value.MangledName;
            if ((irName == "")) {
                irName = fn_value.Name;
            }
            MapStrArraycodegenfuncoverloadentry_put(funcOverloads, fn_value.Name, append_Codegenfuncoverloadentry(MapStrArraycodegenfuncoverloadentry_get(funcOverloads, fn_value.Name), make_CodegenFuncOverloadEntry_19(irName, len(fn_value.Params))));
        }
    }
    let map_381: MapStrStr = new MapStrStr();
    let map_382: MapStrStr = new MapStrStr();
    let l: CodegenLowerer = make_CodegenLowerer_21(make_CodegenIRModule_20("main"), target, funcRetTypes, funcParamTypes, codegen_makePhysRegSet(), map_381, map_382, funcOverloads);
    {
        let items_383: []AstNode = extend_Astnode(extend_Astnode([], program.Globals), program.ClassGlobals);
        let count_385: i32 = len(items_383);
        for (let index_384: i32 = 0; index_384 < count_385; index_384++) {
            let g: AstNode = items_383[index_384];
            {
                let exists: bool = MapStrStr_has(l.globals, g.Name);
                if (exists) {
                    continue;
                }
            }
            codegen_Lowerer_lowerGlobal(l, g);
        }
    }
    let map_386: MapStrBool = new MapStrBool();
    let emittedFuncs: MapStrBool = map_386;
    {
        let items_387: []AstNode = functions;
        let count_389: i32 = len(items_387);
        for (let index_388: i32 = 0; index_388 < count_389; index_388++) {
            let fn_value: AstNode = items_387[index_388];
            let irName: str = fn_value.MangledName;
            if ((irName == "")) {
                irName = fn_value.Name;
            }
            if (MapStrBool_get(emittedFuncs, irName)) {
                continue;
            }
            MapStrBool_put(emittedFuncs, irName, true);
            codegen_Lowerer_lowerFunction(l, fn_value, program.Startup);
        }
    }
    return l.module_value;
}


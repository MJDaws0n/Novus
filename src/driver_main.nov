// parseSize parses a size string like "64m", "128M", "1g", "67108864" into bytes.
fn driver_parseSize(s: str) -> ResultI64Str {
    if ((len(s) == 0)) {
        return make_ResultI64Str(0, ("empty size"));
    }
    let last: i32 = byte_at(s, (len(s) - 1));
    let multiplier: i64 = 1;
    let numStr: str = s;
    {
        let choice_73: i32 = last;
        if ((choice_73 == 107) || (choice_73 == 75)) {
            multiplier = 1024;
            numStr = runtime_substring(s, 0, (len(s) - 1));
        } else if ((choice_73 == 109) || (choice_73 == 77)) {
            multiplier = 1048576;
            numStr = runtime_substring(s, 0, (len(s) - 1));
        } else if ((choice_73 == 103) || (choice_73 == 71)) {
            multiplier = 1073741824;
            numStr = runtime_substring(s, 0, (len(s) - 1));
        }
    }
    let result_74: ResultI64Str = runtime_strconv_ParseInt(numStr, 10, 64);
    let n: i64 = result_74.value0;
    let err: str = result_74.value1;
    if ((err != "")) {
        return make_ResultI64Str(0, err);
    }
    if ((n <= 0)) {
        return make_ResultI64Str(0, ("size must be positive"));
    }
    if ((n > (9223372036854775807 / multiplier))) {
        return make_ResultI64Str(0, ("size too large"));
    }
    return make_ResultI64Str((n * multiplier), "");
}

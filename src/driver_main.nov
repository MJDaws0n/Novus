fn driver_splitTarget(s: str) -> []str {
    {
        let items_61: str = s;
        let count_63: i32 = len(items_61);
        for (let index_62: i32 = 0; index_62 < count_63; index_62++) {
            let i: i32 = index_62;
            let c: i32 = byte_at(items_61, index_62);
            if ((c == 47)) {
                return [runtime_substring(s, 0, i), runtime_substring(s, (i + 1), len(s))];
            }
        }
    }
    return [s];
}

// resolveTargetFromArgs checks for --target=os/arch in CLI args and returns

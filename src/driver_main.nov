        let count_66: i32 = len(items_64);
        for (let index_65: i32 = 0; index_65 < count_66; index_65++) {
            let arg: str = items_64[index_65];
            if (((len(arg) > 9) && (runtime_substring(arg, 0, 9) == "--target="))) {
                let parts: []str = driver_splitTarget(runtime_substring(arg, 9, len(arg)));
                if ((len(parts) == 2)) {
                    let result_67: ResultCodegentargetStr = codegen_ResolveTarget(parts[0], parts[1]);
                    let target: CodegenTarget = result_67.value0;
                    let err: str = result_67.value1;
                    if ((err == "")) {
                        return target;

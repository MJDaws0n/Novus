                w.append(s.Label);
                w.append("_len:\n    .long ");
                w.append(runtime_string_i32(s.Value.length()));
                w.append("\n");
            }
        }
        w.append("\n");
    }
    if (codegen_x86Emitter_usesHeap(e)) {
        w.append(".bss\n_novus_heap:\n    .space ");
        w.append(runtime_string_i64(e.target.HeapSize));
        w.append("\n_novus_heap_ptr:\n    .space 4\n_novus_gc_table:\n    .space ");
        w.append(runtime_string_i32((e.target.GCEntries * 12)));
        w.append("\n_novus_gc_count:\n    .space 4\n_novus_gc_threshold:\n    .space 4\n_novus_gc_freelist:\n    .space 256\n_novus_gc_stack_bottom:\n    .space 4\n\n");
    }
    if ((len(e.mod.Globals) > 0)) {
        w.append(".data\n");
        {
            let items_13: []CodegenIRGlobal = e.mod.Globals;
            let count_15: i32 = len(items_13);
            for (let index_14: i32 = 0; index_14 < count_15; index_14++) {
                let g: CodegenIRGlobal = copy_CodegenIRGlobal(items_13[index_14]);
                w.append(g.Name);
                w.append(":\n");
                if ((g.InitStr >= 0)) {
                    let strLabel: str = e.mod.Strings[g.InitStr].Label;
                    w.append("    .long ");
                    w.append(strLabel);
                    w.append("\n    .long 0\n");
                } else {
                    w.append("    .quad ");
                    w.append(runtime_string_i64(g.InitImm));
                    w.append("\n");
                }
            }
        }
        w.append("\n");
    }
    w.append(".text\n.globl _start\n.globl main\n\n_start:\n");
    if (codegen_x86Emitter_usesHeap(e)) {
        w.append("    movl %esp, _novus_gc_stack_bottom\n    movl $256, _novus_gc_threshold\n");
    }
    if (codegen_hasRuntimeEnvpGlobal(e.mod)) {
        let envpSym: str = codegen_Target_Sym(e.target, "_g___novus_envp");
        w.append("    movl (%esp), %eax\n    leal 8(%esp,%eax,4), %edx\n    movl %edx, ");
        w.append(envpSym);
        w.append("\n");
    }
    w.append("    movl (%esp), %eax\n    leal 4(%esp), %ecx\n    pushl $0\n    pushl %ecx\n    pushl $0\n    pushl %eax\n    call main\n    addl $16, %esp\n    movl %eax, %ebx\n    movl $1, %eax\n    int $0x80\n\n");
    {
        let items_16: []CodegenIRFunc = e.mod.Functions;
        let count_18: i32 = len(items_16);
        for (let index_17: i32 = 0; index_17 < count_18; index_17++) {
            let fn_value: CodegenIRFunc = items_16[index_17];
            codegen_x86Emitter_emitFunction(e, fn_value);
        }
    }
    codegen_x86Emitter_emitWideDivisionRuntime(e);
    if (codegen_x86Emitter_usesHeap(e)) {
        codegen_x86Emitter_emitX86GCRuntime(e);
    }
}

fn codegen_x86Emitter_emitFunction(e: CodegenX86Emitter, fn_value: CodegenIRFunc) -> void {
    let w: StringBuilder = e.b;
    e.fn_value = fn_value;
    let frameSize: i32 = codegen_x86Emitter_computeFrameSize(e, fn_value);
    w.append(fn_value.Name);
    w.append(":\n    pushl %ebp\n    movl %esp, %ebp\n");
    if ((frameSize > 0)) {
        w.append("    subl $");
        w.append(runtime_string_i32(frameSize));
        w.append(", %esp\n");
    }
    w.append("    pushl %ebx\n    pushl %esi\n    pushl %edi\n");
    {
        let items_19: []CodegenIRInstr = fn_value.Instrs;
        let count_21: i32 = len(items_19);
        for (let index_20: i32 = 0; index_20 < count_21; index_20++) {
            let instr: CodegenIRInstr = items_19[index_20];
            codegen_x86Emitter_emitInstr(e, fn_value, instr);
        }
    }
    w.append("\n");
    e.fn_value = null;
}


        w.append(("    .space " + runtime_string_i64(e.target.HeapSize) + "\n"));
        w.append("_novus_heap_ptr:\n");
        w.append("    .space 4\n");
        w.append("_novus_gc_table:\n");
        w.append(("    .space " + runtime_string_i32((e.target.GCEntries * 12)) + "\n"));
        w.append("_novus_gc_count:\n");
        w.append("    .space 4\n");
        w.append("_novus_gc_threshold:\n");
        w.append("    .space 4\n");
        w.append("_novus_gc_freelist:\n");
        w.append("    .space 256\n");
        w.append("_novus_gc_stack_bottom:\n");
        w.append("    .space 4\n\n");
    }
    if ((len(e.mod.Globals) > 0)) {
        if ((len(e.mod.Strings) == 0)) {
            w.append(".data\n");
        }
        {
            let items_221: []CodegenIRGlobal = e.mod.Globals;
            let count_223: i32 = len(items_221);
            for (let index_222: i32 = 0; index_222 < count_223; index_222++) {
                let g: CodegenIRGlobal = items_221[index_222];
                w.append((g.Name + ":\n"));
                if ((g.InitStr >= 0)) {
                    let strLabel: str = e.mod.Strings[g.InitStr].Label;
                    w.append(("    .long " + strLabel + "\n"));
                } else {
                    w.append(("    .long " + runtime_string_i32(runtime_to_i32(g.InitImm)) + "\n"));
                }
            }
        }
        w.append("\n");
    }
    w.append(".text\n");
    w.append(".globl _start\n");
    w.append(".globl main\n\n");
    w.append("_start:\n");
    if (codegen_x86Emitter_usesHeap(e)) {
        w.append("    movl %esp, _novus_gc_stack_bottom\n");
        w.append("    movl $256, _novus_gc_threshold\n");
    }
    if (codegen_hasRuntimeEnvpGlobal(e.mod)) {
        let envpSym: str = codegen_Target_Sym(e.target, "_g___novus_envp");
        w.append("    movl (%esp), %eax\n");
        w.append("    leal 8(%esp,%eax,4), %edx\n");
        w.append(("    movl " + "%" + "edx, " + envpSym + "\n"));
    }
    w.append("    call main\n");
    w.append("    movl %eax, %ebx\n");
    w.append("    movl $1, %eax\n");
    w.append("    int $0x80\n\n");
    {
        let items_224: []CodegenIRFunc = e.mod.Functions;
        let count_226: i32 = len(items_224);
        for (let index_225: i32 = 0; index_225 < count_226; index_225++) {
            let fn_value: CodegenIRFunc = items_224[index_225];
            codegen_x86Emitter_emitFunction(e, fn_value);
        }
    }
    if (codegen_x86Emitter_usesHeap(e)) {
        codegen_x86Emitter_emitX86GCRuntime(e);
    }
}

fn codegen_x86Emitter_emitFunction(e: CodegenX86Emitter, fn_value: CodegenIRFunc) -> void {
    let w: StringBuilder = e.b;
    e.fn_value = fn_value;
    let frameSize: i32 = codegen_x86Emitter_computeFrameSize(e, fn_value);
    w.append((fn_value.Name + ":\n"));
    w.append("    pushl %ebp\n");
    w.append("    movl %esp, %ebp\n");
    if ((frameSize > 0)) {
        w.append(("    subl $" + runtime_string_i32(frameSize) + ", " + "%" + "esp\n"));
    }
    {
        let items_227: []CodegenIRInstr = fn_value.Instrs;
        let count_229: i32 = len(items_227);
        for (let index_228: i32 = 0; index_228 < count_229; index_228++) {
            let instr: CodegenIRInstr = items_227[index_228];
            codegen_x86Emitter_emitInstr(e, fn_value, instr);
        }
    }
    w.append("\n");
    e.fn_value = null;
}


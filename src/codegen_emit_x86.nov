// EmitX86 converts an IRModule to x86 (32-bit) assembly text.
fn codegen_EmitX86(mod: CodegenIRModule, target: CodegenTarget) -> str {
    codegen_Target_EnsureHeapDefaults(target);
    mod = codegen_withCollector(mod, target);
    let e: CodegenX86Emitter = make_CodegenX86Emitter_10(mod, target, make_StringBuilder_8());
    codegen_x86Emitter_emit(e);
    return e.b.text();
}

fn codegen_x86Emitter_uniqueID(e: CodegenX86Emitter) -> i32 {
    let id: i32 = e.nextID;
    e.nextID++;
    return id;
}

fn codegen_x86Emitter_computeFrameSize(e: CodegenX86Emitter, fn_value: CodegenIRFunc) -> i32 {
    let maxVReg: i32 = 0;
    {
        let items_1: []CodegenIRInstr = fn_value.Instrs;
        let count_3: i32 = len(items_1);
        for (let index_2: i32 = 0; index_2 < count_3; index_2++) {
            let instr: CodegenIRInstr = items_1[index_2];
            if (instr.Dst.Kind == 1 && instr.Dst.Reg + 1 > maxVReg) { maxVReg = instr.Dst.Reg + 1; }
            if (instr.Src1.Kind == 1 && instr.Src1.Reg + 1 > maxVReg) { maxVReg = instr.Src1.Reg + 1; }
            if (instr.Src2.Kind == 1 && instr.Src2.Reg + 1 > maxVReg) { maxVReg = instr.Src2.Reg + 1; }
            {
                let items_7: []CodegenOperand = instr.Args;
                let count_9: i32 = len(items_7);
                for (let index_8: i32 = 0; index_8 < count_9; index_8++) {
                    let op: CodegenOperand = items_7[index_8];
                    if (((op.Kind == 1) && ((op.Reg + 1) > maxVReg))) {
                        maxVReg = (op.Reg + 1);
                    }
                }
            }
        }
    }
    let totalSlots: i32 = ((fn_value.Locals + maxVReg) + 4);
    let size: i32 = (totalSlots * 8);
    if (((size % 16) != 0)) {
        size = (size + (16 - ((size % 16))));
    }
    if ((size < 16)) {
        size = 16;
    }
    return size;
}

fn codegen_x86Emitter_vregOffset(e: CodegenX86Emitter, fn_value: CodegenIRFunc, reg: i32) -> i32 {
    return -((((((fn_value.Locals + reg) + 1)) * 8)));
}

fn codegen_x86Emitter_emit(e: CodegenX86Emitter) -> void {

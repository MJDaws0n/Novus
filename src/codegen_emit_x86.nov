// EmitX86 converts an IRModule to x86 (32-bit) assembly text.
fn codegen_EmitX86(mod: CodegenIRModule, target: CodegenTarget) -> str {
    codegen_Target_EnsureHeapDefaults(target);
    mod = codegen_withCollector(mod, target);
    let e: CodegenX86Emitter = make_CodegenX86Emitter_10(mod, target, make_StringBuilder_8());
    codegen_x86Emitter_emit(e);
    return e.b.text();
}

fn codegen_x86Emitter_uniqueID(e: CodegenX86Emitter) -> i32 {
    let id: i32 = e.nextID;
    e.nextID++;
    return id;
}

fn codegen_x86Emitter_computeFrameSize(e: CodegenX86Emitter, fn_value: CodegenIRFunc) -> i32 {
    let maxVReg: i32 = 0;
    {
        let items_209: []CodegenIRInstr = fn_value.Instrs;
        let count_211: i32 = len(items_209);
        for (let index_210: i32 = 0; index_210 < count_211; index_210++) {
            let instr: CodegenIRInstr = items_209[index_210];
            {
                let items_212: []CodegenOperand = [instr.Dst, instr.Src1, instr.Src2];
                let count_214: i32 = len(items_212);
                for (let index_213: i32 = 0; index_213 < count_214; index_213++) {
                    let op: CodegenOperand = items_212[index_213];
                    if (((op.Kind == 1) && ((op.Reg + 1) > maxVReg))) {
                        maxVReg = (op.Reg + 1);
                    }
                }
            }
            {
                let items_215: []CodegenOperand = instr.Args;
                let count_217: i32 = len(items_215);
                for (let index_216: i32 = 0; index_216 < count_217; index_216++) {
                    let op: CodegenOperand = items_215[index_216];
                    if (((op.Kind == 1) && ((op.Reg + 1) > maxVReg))) {
                        maxVReg = (op.Reg + 1);
                    }
                }
            }
        }
    }
    let totalSlots: i32 = ((fn_value.Locals + maxVReg) + 4);
    let size: i32 = (totalSlots * 4);
    if (((size % 16) != 0)) {
        size = (size + (16 - ((size % 16))));
    }
    if ((size < 16)) {
        size = 16;
    }
    return size;
}

fn codegen_x86Emitter_vregOffset(e: CodegenX86Emitter, fn_value: CodegenIRFunc, reg: i32) -> i32 {
    return -((((((fn_value.Locals + reg) + 1)) * 4)));
}

fn codegen_x86Emitter_emit(e: CodegenX86Emitter) -> void {

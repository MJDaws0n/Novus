        } else {
            codegen_x86Emitter_wideLoad(e, instr.Src2, "%eax", "%edx");
            w.append("    movl %eax, 8(%esp)\n    movl %edx, 12(%esp)\n");
            if ((instr.Op == 61)) {
                let id: i32 = codegen_x86Emitter_uniqueID(e);
                w.append(("    fldl 8(" + "%" + "esp)\n    fldl (" + "%" + "esp)\n.Lfmod32_" + runtime_string_i32(id) + ":\n    fprem\n    fnstsw " + "%" + "ax\n    testw $1024, " + "%" + "ax\n    jnz .Lfmod32_" + runtime_string_i32(id) + "\n    fstpl (" + "%" + "esp)\n    fstp " + "%" + "st(0)\n"));
            } else {
                w.append("    movsd (%esp), %xmm0\n    movsd 8(%esp), %xmm1\n");

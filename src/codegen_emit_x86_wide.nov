    e.b.append(("    call " + instr.Src1.Label + "\n"));
    if ((len(instr.Args) > 0)) {
        e.b.append(("    addl $" + runtime_string_i32((len(instr.Args) * 8)) + ", " + "%" + "esp\n"));
    }
    codegen_x86Emitter_wideResult(e, instr.Dst);
}


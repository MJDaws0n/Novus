    }
    w.append("    call _novus_udivmod64\n");
    if (remainder) {
        w.append("    movl %ebx, %eax\n    movl %ecx, %edx\n");
    }
    if (signed) {
        w.append("    popl %edi\n    popl %esi\n");
        let sign: str = "%edi";
        if (remainder) {
            sign = "%esi";
        }
        w.append(("    testl " + sign + ", " + sign + "\n    jz .Lwide_div_done_" + runtime_string_i32(id) + "\n    negl " + "%" + "eax\n    adcl $0, " + "%" + "edx\n    negl " + "%" + "edx\n.Lwide_div_done_" + runtime_string_i32(id) + ":\n"));
    }
    codegen_x86Emitter_wideResult(e, instr.Dst);
}

// Register-only integer arithmetic support. Fast-path division by a single
// machine word also covers the collector's indexing and ordinary loop counts.
fn codegen_x86Emitter_emitWideDivisionRuntime(e: CodegenX86Emitter) -> void {
    e.b.append("\n_novus_udivmod64:\n    pushl %esi\n    pushl %edi\n    testl %ecx, %ecx\n    jnz .Ludiv64_long\n    movl %eax, %esi\n    movl %edx, %eax\n    xorl %edx, %edx\n    divl %ebx\n    movl %eax, %edi\n    movl %esi, %eax\n    divl %ebx\n    movl %edx, %ebx\n    movl %edi, %edx\n    movl $0, %ecx\n    jmp .Ludiv64_done\n.Ludiv64_long:\n    xorl %esi, %esi\n    xorl %edi, %edi\n    pushl $64\n.Ludiv64_loop:\n    shll $1, %eax\n    rcll $1, %edx\n    rcll $1, %esi\n    rcll $1, %edi\n    jc .Ludiv64_sub\n    cmpl %ecx, %edi\n    jb .Ludiv64_next\n    ja .Ludiv64_sub\n    cmpl %ebx, %esi\n    jb .Ludiv64_next\n.Ludiv64_sub:\n    subl %ebx, %esi\n    sbbl %ecx, %edi\n    orl $1, %eax\n.Ludiv64_next:\n    decl (%esp)\n    jnz .Ludiv64_loop\n    addl $4, %esp\n    movl %esi, %ebx\n    movl %edi, %ecx\n.Ludiv64_done:\n    popl %edi\n    popl %esi\n    ret\n");
}

fn codegen_x86Emitter_emitWideFloat(e: CodegenX86Emitter, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    codegen_x86Emitter_wideLoad(e, instr.Src1, "%eax", "%edx");
    w.append("    subl $24, %esp\n    movl %eax, (%esp)\n    movl %edx, 4(%esp)\n");

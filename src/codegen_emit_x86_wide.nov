fn codegen_x86Emitter_emitWideDiv(e: CodegenX86Emitter, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let id: i32 = codegen_x86Emitter_uniqueID(e);
    codegen_x86Emitter_wideLoad(e, instr.Src1, "%eax", "%edx");
    codegen_x86Emitter_wideLoad(e, instr.Src2, "%ebx", "%ecx");

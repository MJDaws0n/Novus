            e.b.append("    pushl ");
            e.b.append(codegen_x86Emitter_widePart(e, instr.Args[i], true));
            e.b.append("\n    pushl ");
            e.b.append(codegen_x86Emitter_widePart(e, instr.Args[i], false));
            e.b.append("\n");
        }
    }
    e.b.append("    call ");
    e.b.append(instr.Src1.Label);
    e.b.append("\n");
    if ((len(instr.Args) > 0)) {
        e.b.append("    addl $");
        e.b.append(runtime_string_i32((len(instr.Args) * 8)));
        e.b.append(", ");
        e.b.append("%");
        e.b.append("esp\n");
    }
    codegen_x86Emitter_wideResult(e, instr.Dst);
}


fn codegen_x86Emitter_emitWideCall(e: CodegenX86Emitter, instr: CodegenIRInstr) -> void {
    {
        let i: i32 = (len(instr.Args) - 1);
        for (; (i >= 0); i--) {
            e.b.append(("    pushl " + codegen_x86Emitter_widePart(e, instr.Args[i], true) + "\n    pushl " + codegen_x86Emitter_widePart(e, instr.Args[i], false) + "\n"));
        }

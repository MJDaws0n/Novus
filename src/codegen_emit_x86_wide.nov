// Novus values keep their full 64-bit representation on i386. Pointers and OS
// structures remain 32-bit; function arguments occupy eight-byte stack slots.
fn codegen_x86Emitter_widePart(e: CodegenX86Emitter, op: CodegenOperand, high: bool) -> str {
    if (!(high)) {
        if ((op.Kind == 3)) {
            return ("$" + runtime_string_i32(runtime_to_i32(op.Imm)));
        }
        return codegen_x86Emitter_operand(e, op);
    }
    {
        let choice_36: i32 = op.Kind;
        if ((choice_36 == 3)) {
            return ("$" + runtime_string_i32(runtime_to_i32((runtime_to_u64(op.Imm) >> 32))));
        } else if ((choice_36 == 1)) {
            return (runtime_string_i32((codegen_x86Emitter_vregOffset(e, e.fn_value, op.Reg) + 4)) + "(" + "%" + "ebp)");
        } else if ((choice_36 == 6)) {
            if ((op.MemBase != "")) {
                return (runtime_string_i64((op.MemOffset + 4)) + "(" + "%" + op.MemBase + ")");
            }
            return (runtime_string_i64((op.MemOffset + 4)));
        } else if ((choice_36 == 5)) {
            return (op.Label + "+4");
        }
    }
    return "$0";
}

fn codegen_x86Emitter_wideLoad(e: CodegenX86Emitter, op: CodegenOperand, low: str, high: str) -> void {
    e.b.append("    movl ");
    e.b.append(codegen_x86Emitter_widePart(e, op, false));
    e.b.append(", ");
    e.b.append(low);
    e.b.append("\n    movl ");
    e.b.append(codegen_x86Emitter_widePart(e, op, true));
    e.b.append(", ");
    e.b.append(high);
    e.b.append("\n");
}

fn codegen_x86Emitter_wideStore(e: CodegenX86Emitter, op: CodegenOperand, low: str, high: str) -> void {
    if ((op.Kind == 0)) {
        return;
    }
    e.b.append("    movl ");
    e.b.append(low);
    e.b.append(", ");
    e.b.append(codegen_x86Emitter_widePart(e, op, false));
    e.b.append("\n");
    if ((op.Kind != 2)) {
        e.b.append("    movl ");
        e.b.append(high);
        e.b.append(", ");
        e.b.append(codegen_x86Emitter_widePart(e, op, true));
        e.b.append("\n");
    }
}

fn codegen_x86Emitter_wideResult(e: CodegenX86Emitter, op: CodegenOperand) -> void {
    codegen_x86Emitter_wideStore(e, op, "%eax", "%edx");
}


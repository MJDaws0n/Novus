            value.Instrs[j].Dst = codegen_windowsOperand(value.Instrs[j].Dst);
            value.Instrs[j].Src1 = codegen_windowsOperand(value.Instrs[j].Src1);
            value.Instrs[j].Src2 = codegen_windowsOperand(value.Instrs[j].Src2);
        }
        array_append(result.Functions, value);
    }
    return result;
}
fn codegen_windowsOperand(value: CodegenOperand) -> CodegenOperand {
    if (value.Kind == 5 && starts_with(value.Label, ".L")) { return codegen_LabelOp(".Lwin_args" + substr(value.Label, 2)); }
    return value;
}

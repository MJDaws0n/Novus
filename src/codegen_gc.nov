    let source: str = "fn _novus_windows_args() -> []u64 {\n    let count: i32 = 0;\n    win_call(\"GetCommandLineW\");\n    let command: u64 = getreg(rax);\n    win_call(\"CommandLineToArgvW\", command, &count);\n    let wide: u64 = getreg(rax);\n    if (wide == 0) { win_call(\"ExitProcess\", 71); }\n    let arguments: []u64 = [];\n    for (let i: i32 = 0; i < count; i++) {\n        let value: u64 = load64(wide + i * 8);\n        win_call(\"WideCharToMultiByte\", 65001, 0, value, -1, 0, 0, 0, 0);\n        let size: i32 = getreg(rax);\n        if (size <= 0) { win_call(\"ExitProcess\", 71); }\n        let buffer: u64 = _novus_gc_alloc(size);\n        win_call(\"WideCharToMultiByte\", 65001, 0, value, -1, buffer, size, 0, 0);\n        let copied: i32 = getreg(rax);\n        if (copied <= 0) { win_call(\"ExitProcess\", 71); }\n        array_append(arguments, buffer);\n    }\n    array_append(arguments, 0);\n    win_call(\"LocalFree\", wide);\n    return arguments;\n}\n";
    let program: AstNode = parser_Parse(lexer_Lex(source).value0).value0;
    let runtime: CodegenIRModule = codegen_Lower(program, target);
    let result: CodegenIRModule = copy_CodegenIRModule(mod);
    result.Functions = extend_Codegenirfunc([], mod.Functions);
    for (let i: i32 = 0; i < len(runtime.Functions); i++) {
        let value: CodegenIRFunc = runtime.Functions[i];
        for (let j: i32 = 0; j < len(value.Instrs); j++) {
            value.Instrs[j].Dst = codegen_windowsOperand(value.Instrs[j].Dst);
            value.Instrs[j].Src1 = codegen_windowsOperand(value.Instrs[j].Src1);
            value.Instrs[j].Src2 = codegen_windowsOperand(value.Instrs[j].Src2);
        }

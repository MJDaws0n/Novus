        let ok: bool = MapStrArraysemanticsymbol_has(s.funcOverloads, name);
        if ((ok && (len(overloads) > 0))) {
            return overloads;
        }
    }
    if ((s.parent != null)) {
        return semantic_Scope_lookupFuncOverloads(s.parent, name);
    }
    return [];
}

// lookupFunc finds the best matching function overload for the given name
// and argument types. Returns nil if no match is found.
fn semantic_Scope_lookupFunc(s: SemanticScope, name: str, argTypes: []SemanticType) -> SemanticSymbol {
    let overloads: []SemanticSymbol = semantic_Scope_lookupFuncOverloads(s, name);
    if ((len(overloads) == 0)) {
        return null;
    }
    if ((len(overloads) == 1)) {
        return overloads[0];
    }
    {
        let items_741: []SemanticSymbol = overloads;
        let count_743: i32 = len(items_741);
        for (let index_742: i32 = 0; index_742 < count_743; index_742++) {
            let sym: SemanticSymbol = items_741[index_742];
            let minArgs: i32 = (len(sym.Params) - sym.DefaultCount);
            if (((len(argTypes) < minArgs) || (len(argTypes) > len(sym.Params)))) {
                continue;
            }
            let match: bool = true;
            {
                let i: i32 = 0;
                for (; (i < len(argTypes)); i++) {
                    let paramType: SemanticType = sym.Params[i];
                    if (((paramType == null) || (argTypes[i] == null))) {
                        continue;
                    }
                    if (!(semantic_isAssignableTo(paramType, argTypes[i]))) {
                        match = false;
                        break;
                    }

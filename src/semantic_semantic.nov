        let ok: bool = MapStrSemantictype_has(CompilerState.semantic_builtinTypes, name);
        if (ok) {
            return t;
        }
    }
    if (((len(name) > 2) && (runtime_substring(name, 0, 2) == "[]"))) {
        let elemName: str = runtime_substring(name, 2, len(name));
        let elemType: SemanticType = semantic_LookupType(elemName);
        if ((elemType == null)) {
            return null;
        }
        let arrType: SemanticType = make_SemanticType_97(name, true, elemType);
        MapStrSemantictype_put(CompilerState.semantic_builtinTypes, name, arrType);
        return arrType;
    }
    return null;
}


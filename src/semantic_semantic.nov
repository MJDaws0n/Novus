    semantic_Analyzer_injectBuiltins(a);
    semantic_Analyzer_analyzeProgram(a, program);
    return a.diagnostics;
}

fn semantic_Analyzer_error(a: SemanticAnalyzer, pos: AstPosition, msg: str) -> void {

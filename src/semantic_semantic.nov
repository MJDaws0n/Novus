fn semantic_Analyzer_blockReturns(a: SemanticAnalyzer, block: AstNode) -> bool {
    if ((len(block.Stmts) == 0)) {
        return false;
    }
    let last: AstNode = block.Stmts[(len(block.Stmts) - 1)];
    return semantic_Analyzer_stmtReturns(a, last);
}

// stmtReturns reports whether a statement unconditionally returns.
// loopBreaks ignores breaks belonging to a nested loop.
fn semantic_loopBreaks(stmt: AstNode) -> bool {

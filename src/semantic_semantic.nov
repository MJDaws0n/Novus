        let count_747: i32 = len(items_745);
        for (let index_746: i32 = 0; index_746 < count_747; index_746++) {
            let i: i32 = index_746;
            let paramType: SemanticType = items_745[index_746];
            if (((paramType == null) || (argTypes[i] == null))) {
                return false;
            }
            if (!(semantic_isAssignableTo(paramType, argTypes[i]))) {
                return false;
            }
        }
    }
    return true;
}

// lookup traverses the scope chain (current → parent → …) to find a symbol.
fn semantic_Scope_lookup(s: SemanticScope, name: str) -> SemanticSymbol {
    {
        let sym: SemanticSymbol = MapStrSemanticsymbol_get(s.symbols, name);
        if ((sym != null)) {
            return sym;

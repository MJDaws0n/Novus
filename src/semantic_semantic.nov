    }
    return ((name + ".") + runtime_strings_Join(sanitized, "."));
}

// sanitizeTypeName converts a type name into a form safe for use in assembly labels.
// e.g. "[]i32" → "_arr_i32", "[]u64" → "_arr_u64"
fn semantic_sanitizeTypeName(name: str) -> str {
    if (runtime_strings_HasPrefix(name, "[]")) {
        return ("_arr_" + runtime_substring(name, 2, len(name)));
    }
    return name;
}

// Analyze runs semantic analysis on the given AST program and returns all
// diagnostics (errors and warnings).  The returned slice is empty when the
// program is semantically valid.
fn semantic_Analyze(program: AstNode) -> []SemanticDiagnostic {

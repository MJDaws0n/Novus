        if ((choice_740 == CompilerState.semantic_TypeU8) || (choice_740 == CompilerState.semantic_TypeU16) || (choice_740 == CompilerState.semantic_TypeU32) || (choice_740 == CompilerState.semantic_TypeU64) || (choice_740 == CompilerState.semantic_TypeI8) || (choice_740 == CompilerState.semantic_TypeI16) || (choice_740 == CompilerState.semantic_TypeI32) || (choice_740 == CompilerState.semantic_TypeI64)) {
            return true;
        }
    }
    return false;
}

// isFloat reports whether t is one of the concrete floating-point types.
fn semantic_isFloat(t: SemanticType) -> bool {
    return ((t == CompilerState.semantic_TypeF32) || (t == CompilerState.semantic_TypeF64));
}

// isNumeric reports whether t is a numeric type (concrete integer, concrete
// float, or an untyped numeric literal).
fn semantic_isNumeric(t: SemanticType) -> bool {
    return (((semantic_isInteger(t) || semantic_isFloat(t)) || (t == CompilerState.semantic_TypeUntypedInt)) || (t == CompilerState.semantic_TypeUntypedFloat));
}

// isAssignableTo reports whether a value of type src can be used where dst
// is expected.  This enables untyped integer literals to flow into any
// integer or float slot, and untyped float literals to flow into any float
// slot — making the language easy to use without explicit casts.
fn semantic_isAssignableTo(dst: SemanticType, src: SemanticType) -> bool {
    if ((src == CompilerState.semantic_TypeNull)) {
        return ((dst.class_value != null) || (dst == CompilerState.semantic_TypeNull));
    }
    if ((dst == src)) {
        return true;
    }
    if ((src == CompilerState.semantic_TypeUntypedInt)) {
        return ((semantic_isInteger(dst) || semantic_isFloat(dst)) || (dst == CompilerState.semantic_TypeUntypedFloat));
    }
    if ((src == CompilerState.semantic_TypeUntypedFloat)) {
        return semantic_isFloat(dst);
    }
    if ((dst.IsArray && src.IsArray)) {
        if ((src.Name == "[]<unknown>")) {
            return true;
        }
        return semantic_isAssignableTo(dst.ElemType, src.ElemType);
    }
    return false;
}

// isComparable reports whether values of type a and b can be compared with
// == or !=.
fn semantic_isComparable(a: SemanticType, b: SemanticType) -> bool {
    if (((a == CompilerState.semantic_TypeNull) || (b == CompilerState.semantic_TypeNull))) {
        return (semantic_isAssignableTo(a, b) || semantic_isAssignableTo(b, a));
    }
    if ((a == b)) {
        return true;
    }
    return (semantic_isAssignableTo(a, b) || semantic_isAssignableTo(b, a));
}

// resolveNumericPair determines the concrete result type when two numeric
// values are combined in a binary operation.  Returns nil on mismatch.
fn semantic_resolveNumericPair(a: SemanticType, b: SemanticType) -> SemanticType {
    if ((a == b)) {
        return a;
    }
    if ((a == CompilerState.semantic_TypeUntypedInt)) {
        if ((semantic_isInteger(b) || semantic_isFloat(b))) {
            return b;
        }
        if ((b == CompilerState.semantic_TypeUntypedFloat)) {
            return b;
        }
        return null;
    }
    if ((b == CompilerState.semantic_TypeUntypedInt)) {
        if ((semantic_isInteger(a) || semantic_isFloat(a))) {
            return a;
        }
        if ((a == CompilerState.semantic_TypeUntypedFloat)) {
            return a;
        }
        return null;
    }
    if ((a == CompilerState.semantic_TypeUntypedFloat)) {
        if (semantic_isFloat(b)) {
            return b;
        }
        return null;
    }
    if ((b == CompilerState.semantic_TypeUntypedFloat)) {
        if (semantic_isFloat(a)) {
            return a;
        }
        return null;
    }
    return null;
}


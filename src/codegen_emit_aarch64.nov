// emitArrayAppend: append val to arr. Dst = arrPtr, Src1 = val.
// If len == cap, grow the array (allocate new data, copy, update header).
fn codegen_arm64Emitter_emitArrayAppend(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let arrPtr: str = codegen_arm64Emitter_loadToReg(e, fn_value, instr.Dst, "x11");
    let val: str = codegen_arm64Emitter_loadToReg(e, fn_value, instr.Src1, "x12");
    let id: i32 = codegen_arm64Emitter_uniqueID(e);
    let noGrowLabel: str = (".Laang_" + runtime_string_i32(id));
    let capOkLabel: str = (".Laaco_" + runtime_string_i32(id));
    let copyLabel: str = (".Laacp_" + runtime_string_i32(id));
    let copyDoneLabel: str = (".Laacd_" + runtime_string_i32(id));
    let allocSym: str = codegen_Target_Sym(e.target, "_novus_gc_alloc");
    if ((arrPtr != "x11")) {
        w.append("    mov x11, ");
        w.append(arrPtr);
        w.append("\n");
    }
    w.append("    ldr x13, [x11, #8]\n    ldr x14, [x11, #16]\n    cmp x13, x14\n    b.lt ");
    w.append(noGrowLabel);
    w.append("\n    lsl x14, x14, #1\n    cmp x14, #4\n    b.ge ");
    w.append(capOkLabel);
    w.append("\n    mov x14, #4\n");
    w.append(capOkLabel);
    w.append(":\n    stp x11, x12, [sp, #-16]!\n    stp x13, x14, [sp, #-16]!\n    lsl x0, x14, #3\n    bl ");
    w.append(allocSym);
    w.append("\n    mov x17, x0\n    ldp x13, x14, [sp], #16\n    ldp x11, x12, [sp], #16\n    ldr x16, [x11, #0]\n    mov x9, #0\n");
    w.append(copyLabel);
    w.append(":\n    cmp x9, x13\n    b.ge ");
    w.append(copyDoneLabel);
    w.append("\n    ldr x8, [x16, x9, lsl #3]\n    str x8, [x17, x9, lsl #3]\n    add x9, x9, #1\n    b ");
    w.append(copyLabel);
    w.append("\n");
    w.append(copyDoneLabel);
    w.append(":\n    str x17, [x11, #0]\n    str x14, [x11, #16]\n");
    w.append(noGrowLabel);
    w.append(":\n    ldr x16, [x11, #0]\n");
    if ((val != "x12")) {
        w.append("    mov x12, ");
        w.append(val);
        w.append("\n");
    }
    w.append("    str x12, [x16, x13, lsl #3]\n    add x13, x13, #1\n    str x13, [x11, #8]\n");

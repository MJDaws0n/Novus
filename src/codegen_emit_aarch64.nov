// EmitARM64 converts an IRModule to ARM64 assembly text.
fn codegen_EmitARM64(mod: CodegenIRModule, target: CodegenTarget) -> str {
    codegen_Target_EnsureHeapDefaults(target);
    mod = codegen_withWindowsArgs(mod, target);
    mod = codegen_withCollector(mod, target);
    let e: CodegenArm64Emitter = make_CodegenArm64Emitter_9(mod, target, make_StringBuilder_8());
    codegen_arm64Emitter_emit(e);
    return codegen_peepholeARM64(e.b.text());
}

fn codegen_arm64Emitter_uniqueID(e: CodegenArm64Emitter) -> i32 {
    e.uid++;
    return e.uid;
}

// toW converts an ARM64 x-register name to its w-register (32-bit) counterpart,
// e.g. "x10" → "w10".  Used for byte-level operations (ldrb/strb).
fn codegen_toW(reg: str) -> str {
    if (((len(reg) > 0) && (byte_at(reg, 0) == 120))) {
        return ("w" + runtime_substring(reg, 1, len(reg)));
    }
    return reg;
}

fn codegen_arm64Emitter_emit(e: CodegenArm64Emitter) -> void {
    let w: StringBuilder = e.b;
    if ((len(e.mod.Strings) > 0)) {
        if ((e.target.OS == 1)) {
            w.append(".section __DATA,__data\n");
        } else {
            w.append(".data\n");
        }
        {
            let items_158: []CodegenIRStringConst = e.mod.Strings;
            let count_160: i32 = len(items_158);
            for (let index_159: i32 = 0; index_159 < count_160; index_159++) {
                let s: CodegenIRStringConst = items_158[index_159];
                let label: str = codegen_Target_Sym(e.target, s.Label);
                w.append(".p2align 3\n");
                w.append(label);
                w.append(":\n    .asciz ");
                w.append(codegen_gasQuoteString(s.Value));
                w.append("\n");
                w.append(label);
                w.append("_len:\n    .quad ");
                w.append(runtime_string_i32(s.Value.length()));
                w.append("\n");
            }
        }
        w.append("\n");
    }
    if (codegen_arm64Emitter_usesHeap(e)) {
        if ((e.target.OS == 2)) {
            w.append(".bss\n.p2align 3\n_novus_heap:\n    .space ");
            w.append(runtime_string_i64(e.target.HeapSize));
            w.append("\n");
        }
        let heapPtrSym: str = codegen_Target_Sym(e.target, "_novus_heap_ptr");
        let heapEndSym: str = codegen_Target_Sym(e.target, "_novus_heap_end");
        w.append(".lcomm ");
        w.append(heapPtrSym);
        w.append(", 8\n");
        if ((e.target.OS != 2)) {
            w.append(".lcomm ");
            w.append(heapEndSym);
            w.append(", 8\n\n");
        }
        let gcTable: str = codegen_Target_Sym(e.target, "_novus_gc_table");
        let gcCount: str = codegen_Target_Sym(e.target, "_novus_gc_count");
        let gcThreshold: str = codegen_Target_Sym(e.target, "_novus_gc_threshold");
        let gcFreelist: str = codegen_Target_Sym(e.target, "_novus_gc_freelist");
        let gcStackBot: str = codegen_Target_Sym(e.target, "_novus_gc_stack_bottom");
        w.append(".lcomm ");
        w.append(gcTable);
        w.append(", ");
        w.append(runtime_string_i32((e.target.GCEntries * 24)));
        w.append("\n.lcomm ");
        w.append(gcCount);
        w.append(", 8\n.lcomm ");
        w.append(gcThreshold);
        w.append(", 8\n.lcomm ");
        w.append(gcFreelist);
        w.append(", 512\n.lcomm ");
        w.append(gcStackBot);
        w.append(", 8\n\n");
    }
    if ((len(e.mod.Globals) > 0)) {
        if ((len(e.mod.Strings) == 0)) {
            if ((e.target.OS == 1)) {
                w.append(".section __DATA,__data\n");
            } else {
                w.append(".data\n");
            }
        }
        {
            let items_161: []CodegenIRGlobal = e.mod.Globals;
            let count_163: i32 = len(items_161);
            for (let index_162: i32 = 0; index_162 < count_163; index_162++) {
                let g: CodegenIRGlobal = items_161[index_162];
                let label: str = codegen_Target_Sym(e.target, g.Name);
                w.append(".p2align 3\n");
                w.append(label);
                w.append(":\n");
                if ((g.InitStr >= 0)) {
                    let strLabel: str = codegen_Target_Sym(e.target, e.mod.Strings[g.InitStr].Label);
                    w.append("    .quad ");
                    w.append(strLabel);
                    w.append("\n");
                } else {
                    w.append("    .quad ");
                    w.append(runtime_string_i64(g.InitImm));
                    w.append("\n");
                }
            }
        }
        w.append("\n");
    }
    if ((e.target.OS == 1)) {
        w.append(".section __TEXT,__text\n");
    } else {
        w.append(".text\n");
    }
    let entryFuncName: str = codegen_Target_Sym(e.target, "main");
    w.append(".globl ");
    w.append(entryFuncName);
    w.append("\n.p2align 2\n\n");
    if ((e.target.OS == 0)) {
        w.append(".globl _start\n_start:\n");
        if (codegen_arm64Emitter_usesHeap(e)) {
            let gcStackBot: str = codegen_Target_Sym(e.target, "_novus_gc_stack_bottom");
            w.append("    adrp x9, ");
            w.append(gcStackBot);
            w.append("\n    add x9, x9, :lo12:");
            w.append(gcStackBot);
            w.append("\n    mov x10, sp\n    str x10, [x9]\n");
            let gcThreshold: str = codegen_Target_Sym(e.target, "_novus_gc_threshold");
            w.append("    adrp x9, ");
            w.append(gcThreshold);
            w.append("\n    add x9, x9, :lo12:");
            w.append(gcThreshold);
            w.append("\n    mov x10, #256\n    str x10, [x9]\n");
        }
        w.append("    ldr x0, [sp]\n    add x1, sp, #8\n");
        if (codegen_hasRuntimeEnvpGlobal(e.mod)) {
            let envpSym: str = codegen_Target_Sym(e.target, "_g___novus_envp");
            w.append("    add x2, x1, x0, lsl #3\n    add x2, x2, #8\n    adrp x9, ");
            w.append(envpSym);
            w.append("\n    add x9, x9, :lo12:");
            w.append(envpSym);
            w.append("\n    str x2, [x9]\n");
        }
        w.append("    bl ");
        w.append(entryFuncName);
        w.append("\n    mov x8, #93\n    svc #0\n\n");
    }
    {
        let items_164: []CodegenIRFunc = e.mod.Functions;
        let count_166: i32 = len(items_164);
        for (let index_165: i32 = 0; index_165 < count_166; index_165++) {
            let fn_value: CodegenIRFunc = items_164[index_165];
            codegen_arm64Emitter_emitFunction(e, fn_value);
        }
    }
    if (codegen_arm64Emitter_usesHeap(e)) {
        codegen_arm64Emitter_emitHeapAllocator(e);
        codegen_arm64Emitter_emitGCRuntime(e);
    }
}

// computeFrameSize returns the total frame size for the function.
fn codegen_arm64Emitter_computeFrameSize(e: CodegenArm64Emitter, fn_value: CodegenIRFunc) -> i32 {
    let maxVReg: i32 = 0;
    {
        let items_167: []CodegenIRInstr = fn_value.Instrs;
        let count_169: i32 = len(items_167);
        for (let index_168: i32 = 0; index_168 < count_169; index_168++) {
            let instr: CodegenIRInstr = items_167[index_168];
            {
                let items_170: []CodegenOperand = [instr.Dst, instr.Src1, instr.Src2];
                let count_172: i32 = len(items_170);
                for (let index_171: i32 = 0; index_171 < count_172; index_171++) {
                    let op: CodegenOperand = items_170[index_171];
                    if (((op.Kind == 1) && ((op.Reg + 1) > maxVReg))) {
                        maxVReg = (op.Reg + 1);
                    }
                }
            }
            {
                let items_173: []CodegenOperand = instr.Args;
                let count_175: i32 = len(items_173);
                for (let index_174: i32 = 0; index_174 < count_175; index_174++) {
                    let op: CodegenOperand = items_173[index_174];
                    if (((op.Kind == 1) && ((op.Reg + 1) > maxVReg))) {
                        maxVReg = (op.Reg + 1);
                    }
                }
            }
        }
    }
    let totalSlots: i32 = ((fn_value.Locals + maxVReg) + 4);
    let size: i32 = (totalSlots * 8);
    if (((size % 16) != 0)) {
        size = (size + (16 - ((size % 16))));
    }
    if ((size < 16)) {
        size = 16;
    }
    return size;
}

// vregOffset returns the frame offset for virtual register N.
// Locals occupy slots 0..locals-1 → [x29 - 8] to [x29 - locals*8].
// VRegs start after: [x29 - (locals + N + 1)*8].
fn codegen_arm64Emitter_vregOffset(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, reg: i32) -> i32 {
    return -((((((fn_value.Locals + reg) + 1)) * 8)));
}

fn codegen_arm64Emitter_emitFunction(e: CodegenArm64Emitter, fn_value: CodegenIRFunc) -> void {
    let w: StringBuilder = e.b;
    let sym: str = codegen_Target_Sym(e.target, fn_value.Name);
    let frameSize: i32 = codegen_arm64Emitter_computeFrameSize(e, fn_value);
    let vregUses: MapI32I32 = new MapI32I32();
    {
        let items_176: []CodegenIRInstr = fn_value.Instrs;
        let count_178: i32 = len(items_176);
        for (let index_177: i32 = 0; index_177 < count_178; index_177++) {
            let instr: CodegenIRInstr = items_176[index_177];
            {
                let items_179: []CodegenOperand = [instr.Src1, instr.Src2];
                let count_181: i32 = len(items_179);
                for (let index_180: i32 = 0; index_180 < count_181; index_180++) {
                    let op: CodegenOperand = items_179[index_180];
                    if ((op.Kind == 1)) {
                        MapI32I32_put(vregUses, op.Reg, (MapI32I32_get(vregUses, op.Reg) + 1));
                    }
                }
            }
            {
                let items_182: []CodegenOperand = instr.Args;
                let count_184: i32 = len(items_182);
                for (let index_183: i32 = 0; index_183 < count_184; index_183++) {
                    let op: CodegenOperand = items_182[index_183];
                    if ((op.Kind == 1)) {
                        MapI32I32_put(vregUses, op.Reg, (MapI32I32_get(vregUses, op.Reg) + 1));
                    }
                }
            }
        }
    }
    w.append(sym);
    w.append(":\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n");
    if ((frameSize > 0)) {
        codegen_arm64Emitter_emitSPAdj(e, "sub", frameSize);
    }
    if ((((fn_value.Name == "main") && (e.target.OS == 1)) && codegen_hasRuntimeEnvpGlobal(e.mod))) {
        let envpSym: str = codegen_Target_Sym(e.target, "_g___novus_envp");
        w.append("    adrp x9, ");
        w.append(envpSym);
        w.append("@PAGE\n    add x9, x9, ");
        w.append(envpSym);
        w.append("@PAGEOFF\n    str x2, [x9]\n");
    }
    if ((((fn_value.Name == "main") && (e.target.OS != 0)) && codegen_arm64Emitter_usesHeap(e))) {
        let gcStackBot: str = codegen_Target_Sym(e.target, "_novus_gc_stack_bottom");
        codegen_arm64Emitter_emitLoadGlobal(e, "x9", gcStackBot);
        w.append("    add x10, x29, #16\n    str x10, [x9]\n");
        let gcThreshold: str = codegen_Target_Sym(e.target, "_novus_gc_threshold");
        codegen_arm64Emitter_emitLoadGlobal(e, "x9", gcThreshold);
        w.append("    mov x10, #256\n    str x10, [x9]\n");
    }
    if ((((fn_value.Name == "main") && (e.target.OS == 2)) && (fn_value.ParamCount >= 2))) {
        codegen_arm64Emitter_emitWinMainArgs(e);
    }

    {
        let i: i32 = 0;
        for (; (i < len(fn_value.Instrs)); i++) {
            let instr: CodegenIRInstr = fn_value.Instrs[i];
            if ((codegen_isCmpOp(instr.Op) && ((i + 1) < len(fn_value.Instrs)))) {
                let next: CodegenIRInstr = fn_value.Instrs[(i + 1)];
                if (codegen_canFuseCmpBranch(instr, next, vregUses)) {
                    codegen_arm64Emitter_emitFusedCmpBranch(e, fn_value, instr, next);
                    i++;
                    continue;
                }
            }
            codegen_arm64Emitter_emitInstr(e, fn_value, instr);
        }
    }
    w.append("\n");
}


    let w: StringBuilder = e.b;
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, copy_CodegenOperand(instr.Dst), "x10");
    let src1: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src1), "x11");
    if ((((instr.Src2.Kind == 3) && (instr.Src2.Imm >= 0)) && (instr.Src2.Imm <= 4095))) {
        w.append(("    cmp " + src1 + ", #" + runtime_string_i64(instr.Src2.Imm) + "\n"));
    } else {
        let src2: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src2), "x12");
        w.append(("    cmp " + src1 + ", " + src2 + "\n"));

    w.append("\n    mov x12, x0\n    add x13, x0, #24\n    str x13, [x12, #0]\n    str xzr, [x12, #8]\n");
    codegen_arm64Emitter_loadImm(e, "x14", cap);
    w.append("    str x14, [x12, #16]\n    mov ");
    w.append(dst);
    w.append(", x12\n");
    codegen_arm64Emitter_spillIfNeeded(e, fn_value, instr.Dst, dst);
}


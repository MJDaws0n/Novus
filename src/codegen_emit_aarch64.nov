fn codegen_arm64Emitter_usesHeap(e: CodegenArm64Emitter) -> bool {
    {
        let items_189: []CodegenIRFunc = e.mod.Functions;
        let count_191: i32 = len(items_189);
        for (let index_190: i32 = 0; index_190 < count_191; index_190++) {
            let fn_value: CodegenIRFunc = items_189[index_190];
            {
                let items_192: []CodegenIRInstr = fn_value.Instrs;
                let count_194: i32 = len(items_192);
                for (let index_193: i32 = 0; index_193 < count_194; index_193++) {
                    let instr: CodegenIRInstr = items_192[index_193];
                    {
                        let choice_195: i32 = instr.Op;
                        if ((choice_195 == 74) || (choice_195 == 40) || (choice_195 == 48) || (choice_195 == 51) || (choice_195 == 73)) {
                            return true;
                        }
                    }
                }
            }
        }
    }
    return false;
}

// emitSPAdj emits "add sp, sp, #N" or "sub sp, sp, #N", handling the ARM64
// immediate limit of 4095 by falling back to a scratch register for larger
// values.
fn codegen_arm64Emitter_emitSPAdj(e: CodegenArm64Emitter, mnemonic: str, size: i32) -> void {
    let w: StringBuilder = e.b;
    if (e.target.OS == 2 && mnemonic == "sub") {
        while (size >= 4096) {
            w.append("    sub sp, sp, #4096\n    str xzr, [sp]\n");
            size -= 4096;
        }
    }
    if ((size <= 4095)) {
        w.append("    ");
        w.append(mnemonic);
        w.append(" sp, sp, #");
        w.append(runtime_string_i32(size));
        w.append("\n");
    } else {
        codegen_arm64Emitter_loadImm(e, "x17", runtime_to_i64(size));
        w.append("    ");
        w.append(mnemonic);
        w.append(" sp, sp, x17\n");
    }
}

fn codegen_arm64Emitter_emitFlagOp(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let flagName: str = "";
    if ((instr.Op == 39)) {
        if ((instr.Src1.Kind == 2)) {
            flagName = instr.Src1.PhysReg;
        } else {
            if ((instr.Src1.Kind == 5)) {
                flagName = instr.Src1.Label;
            }
        }
    } else {
        if ((instr.Dst.Kind == 2)) {
            flagName = instr.Dst.PhysReg;
        } else {
            if ((instr.Dst.Kind == 5)) {
                flagName = instr.Dst.Label;
            }
        }
    }
    if ((instr.Op == 39)) {
        let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, instr.Dst, "x10");
        let cond: str = codegen_flagNameToCondition(flagName);
        if ((cond != "")) {
            w.append("    cset ");
            w.append(dst);
            w.append(", ");
            w.append(cond);
            w.append("\n");
        } else {
            w.append("    // getflag: unrecognised flag ");
            w.append(runtime_quote(flagName));
            w.append("\n    mov ");
            w.append(dst);
            w.append(", #0\n");
        }
        codegen_arm64Emitter_spillIfNeeded(e, fn_value, instr.Dst, dst);
    } else {
        w.append("    // setflag ");
        w.append(runtime_quote(flagName));
        w.append(" not directly supported on ARM64\n");
    }
}

// flagNameToCondition maps Novus flag names to ARM64 condition suffixes
// usable with cset. The condition is TRUE when the flag IS set.
fn codegen_flagNameToCondition(name: str) -> str {
    {
        let choice_196: str = name;
        if ((choice_196 == "c") || (choice_196 == "carry") || (choice_196 == "cs") || (choice_196 == "cf")) {
            return "cs";
        } else if ((choice_196 == "z") || (choice_196 == "zero") || (choice_196 == "zero_flag")) {
            return "eq";
        } else if ((choice_196 == "n") || (choice_196 == "negative") || (choice_196 == "negative_flag")) {
            return "mi";
        } else if ((choice_196 == "v") || (choice_196 == "overflow") || (choice_196 == "overflow_flag")) {
            return "vs";
        }
    }
    return "";
}

// emitStrCmpEq emits an inline byte-by-byte string comparison.
// dst = 1 if strings are equal, 0 otherwise.
fn codegen_arm64Emitter_emitStrCmpEq(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let src1: str = codegen_arm64Emitter_loadToReg(e, fn_value, instr.Src1, "x13");
    let src2: str = codegen_arm64Emitter_loadToReg(e, fn_value, instr.Src2, "x14");
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, instr.Dst, "x10");
    let id: i32 = codegen_arm64Emitter_uniqueID(e);
    let loopLabel: str = (".Lstrcmp_loop_" + runtime_string_i32(id));
    let neLabel: str = (".Lstrcmp_ne_" + runtime_string_i32(id));
    let eqLabel: str = (".Lstrcmp_eq_" + runtime_string_i32(id));
    let endLabel: str = (".Lstrcmp_end_" + runtime_string_i32(id));
    if ((src1 != "x13")) {
        w.append("    mov x13, ");
        w.append(src1);
        w.append("\n");
    }
    if ((src2 != "x14")) {
        w.append("    mov x14, ");
        w.append(src2);
        w.append("\n");
    }
    w.append(loopLabel);
    w.append(":\n    ldrb w15, [x13], #1\n    ldrb w16, [x14], #1\n    cmp w15, w16\n    b.ne ");
    w.append(neLabel);
    w.append("\n    cbz w15, ");
    w.append(eqLabel);
    w.append("\n    b ");
    w.append(loopLabel);
    w.append("\n");
    w.append(neLabel);
    w.append(":\n    mov ");
    w.append(dst);
    w.append(", #0\n    b ");
    w.append(endLabel);
    w.append("\n");
    w.append(eqLabel);
    w.append(":\n    mov ");
    w.append(dst);
    w.append(", #1\n");
    w.append(endLabel);
    w.append(":\n");
    codegen_arm64Emitter_spillIfNeeded(e, fn_value, instr.Dst, dst);
}

fn codegen_arm64Emitter_emitLoadMem(e: CodegenArm64Emitter, dst: str, baseName: str, offset: i32) -> void {
    let w: StringBuilder = e.b;
    let base: str = codegen_arm64Emitter_armBaseReg(e, baseName);
    if (((offset >= -256) && (offset <= 255))) {
        w.append("    ldur ");
        w.append(dst);
        w.append(", [");
        w.append(base);
        w.append(", #");
        w.append(runtime_string_i32(offset));
        w.append("]\n");
    } else {
        if ((((offset >= 0) && (offset <= 32760)) && ((offset % 8) == 0))) {
            w.append("    ldr ");
            w.append(dst);
            w.append(", [");
            w.append(base);
            w.append(", #");
            w.append(runtime_string_i32(offset));
            w.append("]\n");
        } else {
            codegen_arm64Emitter_loadImm(e, "x17", runtime_to_i64(offset));
            w.append("    ldr ");
            w.append(dst);
            w.append(", [");
            w.append(base);
            w.append(", x17]\n");
        }
    }
}

fn codegen_arm64Emitter_emitStoreMem(e: CodegenArm64Emitter, src: str, baseName: str, offset: i32) -> void {
    let w: StringBuilder = e.b;
    let base: str = codegen_arm64Emitter_armBaseReg(e, baseName);
    if (((offset >= -256) && (offset <= 255))) {
        w.append("    stur ");
        w.append(src);
        w.append(", [");
        w.append(base);
        w.append(", #");
        w.append(runtime_string_i32(offset));
        w.append("]\n");
    } else {
        if ((((offset >= 0) && (offset <= 32760)) && ((offset % 8) == 0))) {
            w.append("    str ");
            w.append(src);
            w.append(", [");
            w.append(base);
            w.append(", #");
            w.append(runtime_string_i32(offset));
            w.append("]\n");
        } else {
            codegen_arm64Emitter_loadImm(e, "x17", runtime_to_i64(offset));
            w.append("    str ");
            w.append(src);
            w.append(", [");
            w.append(base);
            w.append(", x17]\n");
        }
    }
}

fn codegen_arm64Emitter_loadStringAddr(e: CodegenArm64Emitter, dst: str, idx: i32) -> void {
    codegen_arm64Emitter_emitLoadGlobal(e, dst, codegen_Target_Sym(e.target, e.mod.Strings[idx].Label));
}

// emitMove avoids using an unrelated physical register as an intermediate
// when the destination is itself a physical register. This keeps values that
// raw syscall/API setup code has already placed in x9-x17 intact.
fn codegen_arm64Emitter_emitMove(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, dst: CodegenOperand, src: CodegenOperand) -> void {
    if ((dst.Kind != 2)) {
        let dstReg: str = codegen_arm64Emitter_dstReg(e, fn_value, dst, "x10");
        if ((src.Kind == 3)) {
            codegen_arm64Emitter_loadImm(e, dstReg, src.Imm);
        } else {
            let srcReg: str = codegen_arm64Emitter_loadToReg(e, fn_value, src, "x11");
            e.b.append("    mov ");
            e.b.append(dstReg);
            e.b.append(", ");
            e.b.append(srcReg);
            e.b.append("\n");
        }
        codegen_arm64Emitter_spillIfNeeded(e, fn_value, dst, dstReg);
        return;
    }
    let dstReg: str = codegen_arm64Emitter_mapPhysReg(e, dst.PhysReg);
    {
        let choice_197: i32 = src.Kind;
        if ((choice_197 == 2)) {
            let srcReg: str = codegen_arm64Emitter_mapPhysReg(e, src.PhysReg);
            if ((srcReg != dstReg)) {
                e.b.append("    mov ");
                e.b.append(dstReg);
                e.b.append(", ");
                e.b.append(srcReg);
                e.b.append("\n");
            }
        } else if ((choice_197 == 3)) {
            codegen_arm64Emitter_loadImm(e, dstReg, src.Imm);
        } else if ((choice_197 == 1)) {
            codegen_arm64Emitter_emitLoadMem(e, dstReg, "x29", codegen_arm64Emitter_vregOffset(e, fn_value, src.Reg));
        } else if ((choice_197 == 4)) {
            codegen_arm64Emitter_loadStringAddr(e, dstReg, runtime_to_i32(src.Imm));
        } else if ((choice_197 == 6)) {
            codegen_arm64Emitter_emitLoadMem(e, dstReg, src.MemBase, runtime_to_i32(src.MemOffset));
        } else if ((choice_197 == 5)) {
            e.b.append("    mov ");
            e.b.append(dstReg);
            e.b.append(", ");
            e.b.append(src.Label);
            e.b.append("\n");
        }
    }
}

// ensureReg returns the register name for an operand.
// For VRegs: loads from stack into scratch; for imm: loads into scratch.
fn codegen_arm64Emitter_ensureReg(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, op: CodegenOperand, scratch: str) -> str {
    {
        let choice_198: i32 = op.Kind;
        if ((choice_198 == 2)) {
            return codegen_arm64Emitter_mapPhysReg(e, op.PhysReg);
        } else if ((choice_198 == 1)) {
            let off: i32 = codegen_arm64Emitter_vregOffset(e, fn_value, op.Reg);
            codegen_arm64Emitter_emitLoadMem(e, scratch, "x29", off);
            return scratch;
        } else if ((choice_198 == 3)) {
            codegen_arm64Emitter_loadImm(e, scratch, op.Imm);
            return scratch;
        } else if ((choice_198 == 4)) {
            codegen_arm64Emitter_loadStringAddr(e, scratch, runtime_to_i32(op.Imm));
            return scratch;
        } else if ((choice_198 == 6)) {
            codegen_arm64Emitter_emitLoadMem(e, scratch, op.MemBase, runtime_to_i32(op.MemOffset));
            return scratch;
        } else if ((choice_198 == 5)) {
            return op.Label;
        }
    }
    return scratch;
}

fn codegen_arm64Emitter_loadToReg(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, op: CodegenOperand, scratch: str) -> str {
    return codegen_arm64Emitter_ensureReg(e, fn_value, op, scratch);
}

fn codegen_arm64Emitter_spillIfNeeded(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, op: CodegenOperand, reg: str) -> void {
    if ((op.Kind == 1)) {
        let off: i32 = codegen_arm64Emitter_vregOffset(e, fn_value, op.Reg);
        codegen_arm64Emitter_emitStoreMem(e, reg, "x29", off);
    }
}

fn codegen_arm64Emitter_loadImm(e: CodegenArm64Emitter, reg: str, val: i64) -> void {
    let w: StringBuilder = e.b;
    if (((val >= 0) && (val <= 65535))) {
        w.append("    mov ");
        w.append(reg);
        w.append(", #");
        w.append(runtime_string_i64(val));
        w.append("\n");
    } else {
        if (((val >= -65536) && (val < 0))) {
            w.append("    mov ");
            w.append(reg);
            w.append(", #");
            w.append(runtime_string_i64(val));
            w.append("\n");
        } else {
            let uval: u64 = runtime_to_u64(val);
            w.append("    movz ");
            w.append(reg);
            w.append(", #");
            w.append(runtime_string_u64((uval & 65535)));
            w.append(", lsl #0\n");
            if (((((uval >> 16)) & 65535) != 0)) {
                w.append("    movk ");
                w.append(reg);
                w.append(", #");
                w.append(runtime_string_u64((((uval >> 16)) & 65535)));
                w.append(", lsl #16\n");
            }
            if (((((uval >> 32)) & 65535) != 0)) {
                w.append("    movk ");
                w.append(reg);
                w.append(", #");
                w.append(runtime_string_u64((((uval >> 32)) & 65535)));
                w.append(", lsl #32\n");
            }
            if (((((uval >> 48)) & 65535) != 0)) {
                w.append("    movk ");
                w.append(reg);
                w.append(", #");
                w.append(runtime_string_u64((((uval >> 48)) & 65535)));
                w.append(", lsl #48\n");
            }
        }
    }
}

fn codegen_arm64Emitter_mapPhysReg(e: CodegenArm64Emitter, name: str) -> str {
    if ((((e.target != null) && (e.target.OS == 1)) && (name == "r8"))) {
        return "x16";
    }
    if (name == "eax") { return "x0"; }
    if (name == "ebx") { return "x1"; }
    if (name == "ecx") { return "x2"; }
    if (name == "edx") { return "x3"; }
    if (name == "esi") { return "x4"; }
    if (name == "edi") { return "x5"; }
    if (name == "ebp") { return "x29"; }
    if (name == "esp") { return "sp"; }
    if (name == "rax") { return "x0"; }
    if (name == "rbx") { return "x1"; }
    if (name == "rcx") { return "x2"; }
    if (name == "rdx") { return "x3"; }
    if (name == "rsi") { return "x4"; }
    if (name == "rdi") { return "x5"; }
    if (name == "rbp") { return "x29"; }
    if (name == "rsp") { return "sp"; }
    if (name == "r8") { return "x8"; }
    if (name == "r9") { return "x9"; }
    if (name == "r10") { return "x10"; }
    if (name == "r11") { return "x11"; }
    if (name == "r12") { return "x12"; }
    if (name == "r13") { return "x13"; }
    if (name == "r14") { return "x14"; }
    if (name == "r15") { return "x15"; }
    return name;
}

fn codegen_arm64Emitter_armBaseReg(e: CodegenArm64Emitter, name: str) -> str {
    if ((name == "")) {
        return "x29";
    }
    return codegen_arm64Emitter_mapPhysReg(e, name);
}

// dstReg returns the register name for a destination operand WITHOUT
// pre-loading the current value.  Use this for output operands that are
// about to be overwritten — avoids a useless memory load per instruction.
fn codegen_arm64Emitter_dstReg(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, op: CodegenOperand, scratch: str) -> str {
    {
        let choice_200: i32 = op.Kind;
        if ((choice_200 == 2)) {
            return codegen_arm64Emitter_mapPhysReg(e, op.PhysReg);
        } else if ((choice_200 == 1)) {
            return scratch;
        }
    }
    return scratch;
}

fn codegen_isCmpOp(op: i32) -> bool {
    {
        let choice_201: i32 = op;
        if ((choice_201 == 21) || (choice_201 == 22) || (choice_201 == 23) || (choice_201 == 24) || (choice_201 == 25) || (choice_201 == 26) || (choice_201 == 75) || (choice_201 == 76) || (choice_201 == 77) || (choice_201 == 78)) {
            return true;
        }
    }
    return false;
}

fn codegen_canFuseCmpBranch(cmpInstr: CodegenIRInstr, brInstr: CodegenIRInstr, vregUses: MapI32I32) -> bool {
    if (((brInstr.Op != 28) && (brInstr.Op != 29))) {
        return false;
    }
    if (((cmpInstr.Dst.Kind != 1) || (brInstr.Src1.Kind != 1))) {
        return false;
    }
    if ((cmpInstr.Dst.Reg != brInstr.Src1.Reg)) {
        return false;
    }
    return (MapI32I32_get(vregUses, cmpInstr.Dst.Reg) == 1);
}

// cmpCondForOp returns the ARM64 condition code for a comparison opcode.
fn codegen_cmpCondForOp(op: i32) -> str {
    {
        let choice_202: i32 = op;
        if ((choice_202 == 21)) {
            return "eq";
        } else if ((choice_202 == 22)) {
            return "ne";
        } else if ((choice_202 == 23)) {
            return "lt";
        } else if ((choice_202 == 24)) {
            return "le";
        } else if ((choice_202 == 25)) {
            return "gt";
        } else if ((choice_202 == 26)) {
            return "ge";
        } else if ((choice_202 == 75)) {
            return "lo";
        } else if ((choice_202 == 76)) {
            return "ls";
        } else if ((choice_202 == 77)) {
            return "hi";
        } else if ((choice_202 == 78)) {
            return "hs";
        }
    }
    return "eq";
}

// invertCond flips an ARM64 condition code.
fn codegen_invertCond(cond: str) -> str {
    {
        let choice_203: str = cond;
        if ((choice_203 == "eq")) {
            return "ne";
        } else if ((choice_203 == "ne")) {
            return "eq";
        } else if ((choice_203 == "lt")) {
            return "ge";
        } else if ((choice_203 == "le")) {
            return "gt";
        } else if ((choice_203 == "gt")) {
            return "le";
        } else if ((choice_203 == "ge")) {
            return "lt";
        } else if ((choice_203 == "lo")) {
            return "hs";
        } else if ((choice_203 == "hs")) {
            return "lo";
        } else if ((choice_203 == "ls")) {
            return "hi";
        } else if ((choice_203 == "hi")) {
            return "ls";
        }
    }
    return cond;
}

// emitFusedCmpBranch emits a compare instruction followed directly by a
// conditional branch, eliminating the cset / spill / reload / cbz overhead.
fn codegen_arm64Emitter_emitFusedCmpBranch(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, cmpInstr: CodegenIRInstr, brInstr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let src1: str = codegen_arm64Emitter_loadToReg(e, fn_value, cmpInstr.Src1, "x11");
    if ((((cmpInstr.Src2.Kind == 3) && (cmpInstr.Src2.Imm >= 0)) && (cmpInstr.Src2.Imm <= 4095))) {
        w.append("    cmp ");
        w.append(src1);
        w.append(", #");
        w.append(runtime_string_i64(cmpInstr.Src2.Imm));
        w.append("\n");
    } else {
        let src2: str = codegen_arm64Emitter_loadToReg(e, fn_value, cmpInstr.Src2, "x12");
        w.append("    cmp ");
        w.append(src1);
        w.append(", ");
        w.append(src2);
        w.append("\n");
    }
    let cond: str = codegen_cmpCondForOp(cmpInstr.Op);
    if ((brInstr.Op == 29)) {
        cond = codegen_invertCond(cond);
    }
    w.append("    b.");
    w.append(cond);
    w.append(" ");
    w.append(brInstr.Dst.Label);
    w.append("\n");
}

// peepholeARM64 performs a single pass over the emitted assembly lines and
// eliminates (or replaces) redundant store-then-load sequences:
//
//	stur xN, [x29, #-K]    →  (keep store)
//	ldur xN, [x29, #-K]    →  (eliminate — xN already has the value)
//
//	stur xN, [x29, #-K]    →  (keep store)
//	ldur xM, [x29, #-K]    →  mov xM, xN  (cheaper than a memory load)
fn codegen_arm64LineEnd(text: str, start: i32, size: i32) -> i32 {
    let end: i32 = start;
    let address: u64 = ptr(text) + i32_to_u64(start);
    while (end < size && load8(address) != 10) { end++; address++; }
    return end;
}

// Return the register's first byte, without allocating substrings or tokens.
fn codegen_arm64MemRegister(text: str, start: i32, end: i32, store: bool) -> i32 {
    while (start < end && (byte_at(text, start) == 32 || byte_at(text, start) == 9 || byte_at(text, start) == 13)) { start++; }
    if (end - start < 7) { return -1; }
    let first: i32 = 108;
    let second: i32 = 100;
    if (store) { first = 115; second = 116; }
    if (byte_at(text, start) != first || byte_at(text, start + 1) != second) { return -1; }
    start += 2;
    if (byte_at(text, start) == 117) { start++; }
    if (byte_at(text, start) != 114 || byte_at(text, start + 1) != 32) { return -1; }
    start += 2;
    while (start < end && (byte_at(text, start) == 32 || byte_at(text, start) == 9)) { start++; }
    return start;
}

fn codegen_arm64MemComma(text: str, start: i32, end: i32) -> i32 {
    for (let i: i32 = start; i + 2 < end; i++) {
        if (byte_at(text, i) == 44 && byte_at(text, i + 1) == 32 && byte_at(text, i + 2) == 91) { return i; }
    }
    return -1;
}

fn codegen_assemblyRangeEqual(text: str, first: i32, firstEnd: i32, second: i32, secondEnd: i32) -> bool {
    if (firstEnd - first != secondEnd - second) { return false; }
    while (first < firstEnd) {
        if (byte_at(text, first) != byte_at(text, second)) { return false; }
        first++; second++;
    }
    return true;
}

fn codegen_copyAssemblyRange(output: str, offset: i32, text: str, start: i32, end: i32) -> i32 {
    let destination: u64 = ptr(output) + i32_to_u64(offset);
    let source: u64 = ptr(text) + i32_to_u64(start);
    let count: i32 = end - start;
    memory_copy(destination, source, count);
    return offset + count;
}

fn codegen_assemblyTrimEnd(text: str, start: i32, end: i32) -> i32 {
    while (end > start && (byte_at(text, end - 1) == 32 || byte_at(text, end - 1) == 9 || byte_at(text, end - 1) == 13)) { end--; }
    return end;
}

fn codegen_peepholeARM64(asm: str) -> str {
    let size: i32 = len(asm);
    let output: str = alloc_string(size);
    let written: i32 = 0;
    let start: i32 = 0;
    while (start < size) {
        let end: i32 = codegen_arm64LineEnd(asm, start, size);
        let next: i32 = end;
        if (next < size) { next++; }
        written = codegen_copyAssemblyRange(output, written, asm, start, next);
        let stReg: i32 = codegen_arm64MemRegister(asm, start, end, true);
        if (stReg >= 0 && next < size) {
            let nextEnd: i32 = codegen_arm64LineEnd(asm, next, size);
            let ldReg: i32 = codegen_arm64MemRegister(asm, next, nextEnd, false);
            if (ldReg >= 0) {
                let stComma: i32 = codegen_arm64MemComma(asm, stReg, end);
                let ldComma: i32 = codegen_arm64MemComma(asm, ldReg, nextEnd);
                if (stComma >= 0 && ldComma >= 0 && codegen_assemblyRangeEqual(asm, stComma + 2, codegen_assemblyTrimEnd(asm, stReg, end), ldComma + 2, codegen_assemblyTrimEnd(asm, ldReg, nextEnd))) {
                    let stRegEnd: i32 = codegen_assemblyTrimEnd(asm, stReg, stComma);
                    let ldRegEnd: i32 = codegen_assemblyTrimEnd(asm, ldReg, ldComma);
                    if (!codegen_assemblyRangeEqual(asm, stReg, stRegEnd, ldReg, ldRegEnd)) {
                        written = codegen_copyAssemblyRange(output, written, "    mov ", 0, 8);
                        written = codegen_copyAssemblyRange(output, written, asm, ldReg, ldRegEnd);
                        written = codegen_copyAssemblyRange(output, written, ", ", 0, 2);
                        written = codegen_copyAssemblyRange(output, written, asm, stReg, stRegEnd);
                        if (nextEnd < size) { string_set_byte(output, written, 10); written++; }
                    } else if (nextEnd == size) { written--; }
                    next = nextEnd;
                    if (next < size) { next++; }
                }
            }
        }
        start = next;
    }
    string_set_byte(output, written, 0);
    return output;
}

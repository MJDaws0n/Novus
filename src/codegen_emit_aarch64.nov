    let id: i32 = codegen_arm64Emitter_uniqueID(e);
    let startLabel: str = (".Lstrlen_s_" + runtime_string_i32(id));
    let doneLabel: str = (".Lstrlen_d_" + runtime_string_i32(id));
    w.append(("    mov x14, " + src + "\n"));
    w.append("    mov x15, #0\n");
    w.append((startLabel + ":\n"));
    w.append("    ldrb w16, [x14, x15]\n");
    w.append(("    cbz w16, " + doneLabel + "\n"));
    w.append("    add x15, x15, #1\n");
    w.append(("    b " + startLabel + "\n"));
    w.append((doneLabel + ":\n"));
    w.append(("    mov " + dst + ", x15\n"));
    codegen_arm64Emitter_spillIfNeeded(e, fn_value, copy_CodegenOperand(instr.Dst), dst);
}


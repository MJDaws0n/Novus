fn codegen_arm64Emitter_emitCall(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let argRegs: []str = e.target.ArgRegs;
    let stackArgs: i32 = runtime_max(0, (len(instr.Args) - len(argRegs)));
    let stackBytes: i32 = ((((stackArgs * e.target.StackArgSlotSize) + 15)) & ~(15));
    if ((stackBytes != 0)) {
        codegen_arm64Emitter_emitSPAdj(e, "sub", stackBytes);
        {
            let i: i32 = len(argRegs);
            for (; (i < len(instr.Args)); i++) {
                let src: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Args[i]), "x10");
                codegen_arm64Emitter_emitStoreMem(e, src, "sp", (((i - len(argRegs))) * e.target.StackArgSlotSize));
            }
        }
    }
    {
        let i: i32 = 0;
        for (; ((i < len(instr.Args)) && (i < len(argRegs))); i++) {
            if ((instr.Args[i].Kind == 3)) {
                codegen_arm64Emitter_loadImm(e, argRegs[i], instr.Args[i].Imm);
            } else {
                let src: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Args[i]), "x10");
                if ((src != argRegs[i])) {
                    w.append(("    mov " + argRegs[i] + ", " + src + "\n"));
                }
            }
        }
    }
    let label: str = instr.Src1.Label;
    let callTarget: str = codegen_Target_Sym(e.target, label);
    w.append(("    bl " + callTarget + "\n"));
    if ((stackBytes != 0)) {
        codegen_arm64Emitter_emitSPAdj(e, "add", stackBytes);
    }
    if ((instr.Dst.Kind != 0)) {
        let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, copy_CodegenOperand(instr.Dst), "x10");
        if ((dst != "x0")) {
            w.append(("    mov " + dst + ", x0\n"));
        }
        codegen_arm64Emitter_spillIfNeeded(e, fn_value, copy_CodegenOperand(instr.Dst), dst);
    }
}

fn codegen_arm64Emitter_emitStrLen(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let src: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src1), "x13");

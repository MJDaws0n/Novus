fn codegen_arm64Emitter_emitBinOp(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr, mnemonic: str) -> void {
    let w: StringBuilder = e.b;
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, instr.Dst, "x10");
    let src1: str = codegen_arm64Emitter_loadToReg(e, fn_value, instr.Src1, "x11");
    if ((instr.Src2.Kind == 3)) {
        let imm: i64 = instr.Src2.Imm;
        let mn: str = mnemonic;
        if (((mn == "sub") && (imm < 0))) {
            imm = -(imm);
            mn = "add";
        } else {
            if (((mn == "add") && (imm < 0))) {
                imm = -(imm);
                mn = "sub";
            }
        }
        if ((((((mn == "add") || (mn == "sub"))) && (imm >= 0)) && (imm <= 4095))) {
            w.append("    ");
            w.append(mn);
            w.append(" ");
            w.append(dst);
            w.append(", ");
            w.append(src1);
            w.append(", #");
            w.append(runtime_string_i64(imm));
            w.append("\n");
            codegen_arm64Emitter_spillIfNeeded(e, fn_value, instr.Dst, dst);
            return;
        }
    }
    let src2: str = codegen_arm64Emitter_loadToReg(e, fn_value, instr.Src2, "x12");
    w.append("    ");
    w.append(mnemonic);
    w.append(" ");
    w.append(dst);
    w.append(", ");
    w.append(src1);
    w.append(", ");
    w.append(src2);
    w.append("\n");
    codegen_arm64Emitter_spillIfNeeded(e, fn_value, instr.Dst, dst);
}

fn codegen_arm64Emitter_emitCmp(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr, cond: str) -> void {
    let w: StringBuilder = e.b;
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, instr.Dst, "x10");
    let src1: str = codegen_arm64Emitter_loadToReg(e, fn_value, instr.Src1, "x11");
    if ((((instr.Src2.Kind == 3) && (instr.Src2.Imm >= 0)) && (instr.Src2.Imm <= 4095))) {
        w.append("    cmp ");
        w.append(src1);
        w.append(", #");
        w.append(runtime_string_i64(instr.Src2.Imm));
        w.append("\n");
    } else {
        let src2: str = codegen_arm64Emitter_loadToReg(e, fn_value, instr.Src2, "x12");
        w.append("    cmp ");
        w.append(src1);
        w.append(", ");
        w.append(src2);
        w.append("\n");
    }
    w.append("    cset ");
    w.append(dst);
    w.append(", ");
    w.append(cond);
    w.append("\n");
    codegen_arm64Emitter_spillIfNeeded(e, fn_value, instr.Dst, dst);
}


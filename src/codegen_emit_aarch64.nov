fn codegen_arm64Emitter_emitStrConcat(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let src1: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src1), "x13");
    let src2: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src2), "x14");
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, copy_CodegenOperand(instr.Dst), "x10");
    let id: i32 = codegen_arm64Emitter_uniqueID(e);
    let len1Label: str = (".Lscl1_" + runtime_string_i32(id));
    let len1Done: str = (".Lscl1d_" + runtime_string_i32(id));
    let len2Label: str = (".Lscl2_" + runtime_string_i32(id));
    let len2Done: str = (".Lscl2d_" + runtime_string_i32(id));
    let copy1Label: str = (".Lsc1_" + runtime_string_i32(id));
    let copy2Label: str = (".Lsc2_" + runtime_string_i32(id));
    let allocSym: str = codegen_Target_Sym(e.target, "_novus_gc_alloc");
    if ((src1 != "x13")) {
        w.append(("    mov x13, " + src1 + "\n"));
    }
    if ((src2 != "x14")) {
        w.append(("    mov x14, " + src2 + "\n"));
    }
    w.append("    mov x15, #0\n");
    w.append((len1Label + ":\n"));
    w.append("    ldrb w16, [x13, x15]\n");
    w.append(("    cbz w16, " + len1Done + "\n"));
    w.append("    add x15, x15, #1\n");
    w.append(("    b " + len1Label + "\n"));
    w.append((len1Done + ":\n"));
    w.append("    mov x9, x15\n");
    w.append("    mov x15, #0\n");
    w.append((len2Label + ":\n"));
    w.append("    ldrb w16, [x14, x15]\n");
    w.append(("    cbz w16, " + len2Done + "\n"));
    w.append("    add x15, x15, #1\n");
    w.append(("    b " + len2Label + "\n"));
    w.append((len2Done + ":\n"));
    w.append("    add x0, x9, x15\n");
    w.append("    add x0, x0, #1\n");
    w.append("    stp x13, x14, [sp, #-16]!\n");
    w.append("    stp x9, x15, [sp, #-16]!\n");
    w.append(("    bl " + allocSym + "\n"));
    w.append("    ldp x9, x15, [sp], #16\n");
    w.append("    ldp x13, x14, [sp], #16\n");
    w.append("    mov x12, x0\n");
    w.append("    mov x11, x0\n");
    w.append((copy1Label + ":\n"));
    w.append("    ldrb w16, [x13], #1\n");
    w.append(("    cbz w16, " + copy2Label + "\n"));
    w.append("    strb w16, [x11], #1\n");
    w.append(("    b " + copy1Label + "\n"));
    w.append((copy2Label + ":\n"));
    w.append("    ldrb w16, [x14], #1\n");
    w.append("    strb w16, [x11], #1\n");
    w.append(("    cbnz w16, " + copy2Label + "\n"));
    w.append(("    mov " + dst + ", x12\n"));
    codegen_arm64Emitter_spillIfNeeded(e, fn_value, copy_CodegenOperand(instr.Dst), dst);
}

// emitLoadGlobal emits an adrp+add pair to load the address of a global
// symbol into dstReg, handling Darwin vs Linux page-offset syntax.
fn codegen_arm64Emitter_emitLoadGlobal(e: CodegenArm64Emitter, dstReg: str, sym: str) -> void {
    let w: StringBuilder = e.b;
    if ((e.target.OS == 1)) {
        w.append(("    adrp " + dstReg + ", " + sym + "@PAGE\n"));
        w.append(("    add " + dstReg + ", " + dstReg + ", " + sym + "@PAGEOFF\n"));
    } else {
        w.append(("    adrp " + dstReg + ", " + sym + "\n"));
        w.append(("    add " + dstReg + ", " + dstReg + ", :lo12:" + sym + "\n"));
    }
}

// emitMmapSyscall emits an mmap(NULL, 256MB, PROT_READ|PROT_WRITE,
// MAP_PRIVATE|MAP_ANON, -1, 0) system call.  Result in x0.
// Clobbers x0-x5 and the syscall-number register (x16 Darwin, x8 Linux).
fn codegen_arm64Emitter_emitMmapSyscall(e: CodegenArm64Emitter) -> void {
    let w: StringBuilder = e.b;
    w.append("    mov x0, #0\n");
    w.append("    mov x1, #256\n");
    w.append("    lsl x1, x1, #20\n");
    w.append("    mov x2, #3\n");
    if ((e.target.OS == 1)) {
        w.append("    mov x3, #0x1002\n");
        w.append("    mov x4, #-1\n");
        w.append("    mov x5, #0\n");
        w.append("    mov x16, #197\n");
        w.append("    svc #0x80\n");
    } else {
        w.append("    mov x3, #0x22\n");
        w.append("    mov x4, #-1\n");
        w.append("    mov x5, #0\n");
        w.append("    mov x8, #222\n");
        w.append("    svc #0\n");
    }
}

// emitHeapAllocator emits the _novus_heap_alloc runtime function.
// It provides a mmap-backed bump allocator that automatically grows by
// requesting new 256 MB virtual-memory regions from the kernel when the
// current region is exhausted.  Only pages actually touched consume
// physical RAM (demand-paged by the OS), so reserving a large region is
// essentially free.
//
//	Input:  x0 = requested size in bytes
//	Output: x0 = pointer to allocated block (8-byte aligned)
//	Clobbers: x0-x5, x9-x16 (caller-saved)
fn codegen_arm64Emitter_emitHeapAllocator(e: CodegenArm64Emitter) -> void {
    if ((e.target.OS == 2)) {
        codegen_arm64Emitter_emitWindowsHeapAllocator(e);
        return;
    }
    let w: StringBuilder = e.b;
    let allocSym: str = codegen_Target_Sym(e.target, "_novus_heap_alloc");
    let heapPtrSym: str = codegen_Target_Sym(e.target, "_novus_heap_ptr");
    let heapEndSym: str = codegen_Target_Sym(e.target, "_novus_heap_end");
    w.append("\n// ---- Runtime: mmap-backed heap allocator ----\n");
    w.append(".p2align 2\n");
    w.append((allocSym + ":\n"));
    w.append("    stp x29, x30, [sp, #-16]!\n");
    w.append("    mov x29, sp\n");
    w.append("    add x0, x0, #7\n");
    w.append("    bic x0, x0, #7\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x9", heapPtrSym);
    w.append("    ldr x10, [x9]\n");
    w.append("    cbz x10, .Lhalloc_init\n");
    w.append(".Lhalloc_try:\n");
    w.append("    add x11, x10, x0\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x12", heapEndSym);
    w.append("    ldr x13, [x12]\n");
    w.append("    cmp x11, x13\n");
    w.append("    b.hi .Lhalloc_grow\n");
    w.append("    str x11, [x9]\n");
    w.append("    mov x0, x10\n");
    w.append("    ldp x29, x30, [sp], #16\n");
    w.append("    ret\n");
    w.append(".Lhalloc_init:\n");
    w.append("    stp x0, x9, [sp, #-16]!\n");
    codegen_arm64Emitter_emitMmapSyscall(e);
    w.append("    mov x10, x0\n");
    w.append("    ldp x0, x9, [sp], #16\n");
    w.append("    str x10, [x9]\n");
    w.append("    mov x14, #256\n");
    w.append("    lsl x14, x14, #20\n");
    w.append("    add x14, x10, x14\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x12", heapEndSym);
    w.append("    str x14, [x12]\n");
    w.append("    b .Lhalloc_try\n");
    w.append(".Lhalloc_grow:\n");
    w.append("    str x0, [sp, #-16]!\n");
    codegen_arm64Emitter_emitMmapSyscall(e);
    w.append("    mov x10, x0\n");
    w.append("    ldr x0, [sp], #16\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x9", heapPtrSym);
    w.append("    str x10, [x9]\n");
    w.append("    mov x14, #256\n");
    w.append("    lsl x14, x14, #20\n");
    w.append("    add x14, x10, x14\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x12", heapEndSym);
    w.append("    str x14, [x12]\n");
    w.append("    b .Lhalloc_try\n");
    w.append("\n");
}

// emitGCRuntime emits the garbage collector runtime:
//   - _novus_gc_register: register an allocation in the GC table
//   - _novus_gc_collect: conservative mark-sweep collection
//   - _novus_gc_alloc: allocate with GC integration (free-list + auto-collect)
//
// GC table entry layout (24 bytes each):
//
//	[0]  ptr  — pointer to allocated block
//	[8]  size — allocation size in bytes
//	[16] mark — 0 = unmarked, 1 = marked
//
// Free list: singly-linked list of freed blocks. Each freed block has:
//
//	[0] next_ptr — pointer to next free block (0 = end)
//	[8] size     — size of this free block
fn codegen_arm64Emitter_emitGCRuntime(e: CodegenArm64Emitter) -> void {
    let w: StringBuilder = e.b;
    let gcTable: str = codegen_Target_Sym(e.target, "_novus_gc_table");
    let gcCount: str = codegen_Target_Sym(e.target, "_novus_gc_count");
    let gcThreshold: str = codegen_Target_Sym(e.target, "_novus_gc_threshold");
    let gcFreelist: str = codegen_Target_Sym(e.target, "_novus_gc_freelist");
    let allocSym: str = codegen_Target_Sym(e.target, "_novus_heap_alloc");
    let gcAllocSym: str = codegen_Target_Sym(e.target, "_novus_gc_alloc");
    let gcRegSym: str = codegen_Target_Sym(e.target, "_novus_gc_register");
    let gcCollectSym: str = codegen_Target_Sym(e.target, "_novus_gc_collect");
    w.append("\n// ---- GC: register allocation ----\n");
    w.append(".p2align 2\n");
    w.append((gcRegSym + ":\n"));
    w.append("    stp x29, x30, [sp, #-16]!\n");
    w.append("    mov x29, sp\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x9", gcCount);
    w.append("    ldr x10, [x9]\n");
    codegen_arm64Emitter_loadImm(e, "x11", runtime_to_i64(e.target.GCEntries));
    w.append("    cmp x10, x11\n");
    w.append("    b.lt .Lgcreg_space\n    brk #1\n.Lgcreg_space:\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x12", gcTable);
    w.append("    mov x13, #24\n");
    w.append("    mul x14, x10, x13\n");
    w.append("    add x12, x12, x14\n");
    w.append("    str x0, [x12, #0]\n");
    w.append("    str x1, [x12, #8]\n");
    w.append("    str xzr, [x12, #16]\n");
    w.append("    add x10, x10, #1\n");
    w.append("    str x10, [x9]\n");
    w.append(".Lgcreg_done:\n");
    w.append("    ldp x29, x30, [sp], #16\n");
    w.append("    ret\n");
    codegen_arm64Emitter_emitFastCollector(e);
    w.append("\n// ---- GC: allocator with free-list and auto-collection ----\n");
    w.append(".p2align 2\n");
    w.append((gcAllocSym + ":\n"));
    w.append("    stp x29, x30, [sp, #-16]!\n");
    w.append("    mov x29, sp\n");
    w.append("    stp x19, x20, [sp, #-16]!\n");
    w.append("    add x0, x0, #7\n");
    w.append("    bic x0, x0, #7\n");
    w.append("    cmp x0, #16\n");
    w.append("    b.ge .Lgca_size_ok\n");
    w.append("    mov x0, #16\n");
    w.append(".Lgca_size_ok:\n");
    w.append("    bl " + codegen_Target_Sym(e.target, "_novus_gc_round") + "\n");
    w.append("    mov x19, x0\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x9", gcCount);
    w.append("    ldr x10, [x9]\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x9", gcThreshold);
    w.append("    ldr x11, [x9]\n");
    w.append("    cmp x10, x11\n");
    w.append("    b.ge .Lgca_collect\n");
    codegen_arm64Emitter_loadImm(e, "x12", runtime_to_i64(e.target.GCEntries));
    w.append("    cmp x10, x12\n    b.lt .Lgca_try_free\n.Lgca_collect:\n");
    w.append(("    bl " + gcCollectSym + "\n"));
    w.append(".Lgca_try_free:\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x0", gcFreelist);
    w.append("    mov x1, x19\n");
    w.append("    bl " + codegen_Target_Sym(e.target, "_novus_gc_take") + "\n");
    w.append("    cbz x0, .Lgca_bump\n    mov x20, x0\n    mov x1, x19\n");
    w.append("    bl " + gcRegSym + "\n");
    w.append("    mov x0, x20\n    b .Lgca_ret\n");
    w.append(".Lgca_bump:\n");
    w.append("    mov x0, x19\n");
    w.append(("    bl " + allocSym + "\n"));
    w.append("    mov x20, x0\n");
    w.append("    mov x1, x19\n");
    w.append(("    bl " + gcRegSym + "\n"));
    w.append("    mov x0, x20\n");
    w.append(".Lgca_ret:\n");
    w.append("    ldp x19, x20, [sp], #16\n");
    w.append("    ldp x29, x30, [sp], #16\n");
    w.append("    ret\n");
}

// emitArrayNew allocates a new array header + data on the heap.
// Dst = pointer to header. Src1 = elem_size (imm, always 8). Src2 = initial cap (imm).
fn codegen_arm64Emitter_emitArrayNew(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, copy_CodegenOperand(instr.Dst), "x10");
    let cap: i64 = instr.Src2.Imm;
    if ((cap < 4)) {
        cap = 4;
    }
    let allocSym: str = codegen_Target_Sym(e.target, "_novus_gc_alloc");
    let totalSize: i64 = (24 + (cap * 8));
    codegen_arm64Emitter_loadImm(e, "x0", totalSize);
    w.append(("    bl " + allocSym + "\n"));
    w.append("    mov x12, x0\n");
    w.append("    add x13, x0, #24\n");
    w.append("    str x13, [x12, #0]\n");
    w.append("    str xzr, [x12, #8]\n");
    codegen_arm64Emitter_loadImm(e, "x14", cap);
    w.append("    str x14, [x12, #16]\n");
    w.append(("    mov " + dst + ", x12\n"));
    codegen_arm64Emitter_spillIfNeeded(e, fn_value, copy_CodegenOperand(instr.Dst), dst);
}

// emitArrayGet: dst = arr[index]. Src1 = arrPtr, Src2 = index.
fn codegen_arm64Emitter_emitArrayGet(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let arrPtr: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src1), "x11");
    let idx: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src2), "x12");
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, copy_CodegenOperand(instr.Dst), "x10");
    w.append(("    ldr x13, [" + arrPtr + ", #0]\n"));
    w.append(("    ldr " + dst + ", [x13, " + idx + ", lsl #3]\n"));
    codegen_arm64Emitter_spillIfNeeded(e, fn_value, copy_CodegenOperand(instr.Dst), dst);
}

// emitArraySet: arr[index] = val. Dst = arrPtr, Src1 = index, Src2 = val.
fn codegen_arm64Emitter_emitArraySet(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let arrPtr: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Dst), "x11");
    let idx: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src1), "x12");
    let val: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src2), "x13");
    w.append(("    ldr x14, [" + arrPtr + ", #0]\n"));
    w.append(("    str " + val + ", [x14, " + idx + ", lsl #3]\n"));
}

// emitArrayAppend: append val to arr. Dst = arrPtr, Src1 = val.
// If len == cap, grow the array (allocate new data, copy, update header).
fn codegen_arm64Emitter_emitArrayAppend(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let arrPtr: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Dst), "x11");
    let val: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src1), "x12");
    let id: i32 = codegen_arm64Emitter_uniqueID(e);
    let noGrowLabel: str = (".Laang_" + runtime_string_i32(id));
    let capOkLabel: str = (".Laaco_" + runtime_string_i32(id));
    let copyLabel: str = (".Laacp_" + runtime_string_i32(id));
    let copyDoneLabel: str = (".Laacd_" + runtime_string_i32(id));
    let allocSym: str = codegen_Target_Sym(e.target, "_novus_gc_alloc");
    if ((arrPtr != "x11")) {
        w.append(("    mov x11, " + arrPtr + "\n"));
    }
    w.append("    ldr x13, [x11, #8]\n");
    w.append("    ldr x14, [x11, #16]\n");
    w.append("    cmp x13, x14\n");
    w.append(("    b.lt " + noGrowLabel + "\n"));
    w.append("    lsl x14, x14, #1\n");
    w.append("    cmp x14, #4\n");
    w.append(("    b.ge " + capOkLabel + "\n"));
    w.append("    mov x14, #4\n");
    w.append((capOkLabel + ":\n"));
    w.append("    stp x11, x12, [sp, #-16]!\n");
    w.append("    stp x13, x14, [sp, #-16]!\n");
    w.append("    lsl x0, x14, #3\n");
    w.append(("    bl " + allocSym + "\n"));
    w.append("    mov x17, x0\n");
    w.append("    ldp x13, x14, [sp], #16\n");
    w.append("    ldp x11, x12, [sp], #16\n");
    w.append("    ldr x16, [x11, #0]\n");
    w.append("    mov x9, #0\n");
    w.append((copyLabel + ":\n"));
    w.append("    cmp x9, x13\n");
    w.append(("    b.ge " + copyDoneLabel + "\n"));
    w.append("    ldr x18, [x16, x9, lsl #3]\n");
    w.append("    str x18, [x17, x9, lsl #3]\n");
    w.append("    add x9, x9, #1\n");
    w.append(("    b " + copyLabel + "\n"));
    w.append((copyDoneLabel + ":\n"));
    w.append("    str x17, [x11, #0]\n");
    w.append("    str x14, [x11, #16]\n");
    w.append((noGrowLabel + ":\n"));
    w.append("    ldr x16, [x11, #0]\n");
    if ((val != "x12")) {
        w.append(("    mov x12, " + val + "\n"));
    }
    w.append("    str x12, [x16, x13, lsl #3]\n");
    w.append("    add x13, x13, #1\n");
    w.append("    str x13, [x11, #8]\n");
}

// emitArrayPop: dst = pop(arr). Src1 = arrPtr.
fn codegen_arm64Emitter_emitArrayPop(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let arrPtr: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src1), "x11");
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, copy_CodegenOperand(instr.Dst), "x10");
    w.append(("    ldr x13, [" + arrPtr + ", #8]\n"));
    w.append("    sub x13, x13, #1\n");
    w.append(("    str x13, [" + arrPtr + ", #8]\n"));
    w.append(("    ldr x14, [" + arrPtr + ", #0]\n"));
    w.append(("    ldr " + dst + ", [x14, x13, lsl #3]\n"));
    codegen_arm64Emitter_spillIfNeeded(e, fn_value, copy_CodegenOperand(instr.Dst), dst);
}

// emitArrayLen: dst = len(arr). Src1 = arrPtr.
fn codegen_arm64Emitter_emitArrayLen(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let arrPtr: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src1), "x11");
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, copy_CodegenOperand(instr.Dst), "x10");
    w.append(("    ldr " + dst + ", [" + arrPtr + ", #8]\n"));
    codegen_arm64Emitter_spillIfNeeded(e, fn_value, copy_CodegenOperand(instr.Dst), dst);
}

fn codegen_arm64Emitter_usesHeap(e: CodegenArm64Emitter) -> bool {
    {
        let items_189: []CodegenIRFunc = e.mod.Functions;
        let count_191: i32 = len(items_189);
        for (let index_190: i32 = 0; index_190 < count_191; index_190++) {
            let fn_value: CodegenIRFunc = items_189[index_190];
            {
                let items_192: []CodegenIRInstr = fn_value.Instrs;
                let count_194: i32 = len(items_192);
                for (let index_193: i32 = 0; index_193 < count_194; index_193++) {
                    let instr: CodegenIRInstr = copy_CodegenIRInstr(items_192[index_193]);
                    {
                        let choice_195: i32 = instr.Op;
                        if ((choice_195 == 74) || (choice_195 == 40) || (choice_195 == 48) || (choice_195 == 51) || (choice_195 == 73)) {
                            return true;
                        }
                    }
                }
            }
        }
    }
    return false;
}

// emitSPAdj emits "add sp, sp, #N" or "sub sp, sp, #N", handling the ARM64
// immediate limit of 4095 by falling back to a scratch register for larger
// values.
fn codegen_arm64Emitter_emitSPAdj(e: CodegenArm64Emitter, mnemonic: str, size: i32) -> void {
    let w: StringBuilder = e.b;
    if ((size <= 4095)) {
        w.append(("    " + mnemonic + " sp, sp, #" + runtime_string_i32(size) + "\n"));
    } else {
        codegen_arm64Emitter_loadImm(e, "x17", runtime_to_i64(size));
        w.append(("    " + mnemonic + " sp, sp, x17\n"));
    }
}

fn codegen_arm64Emitter_emitFlagOp(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let flagName: str = "";
    if ((instr.Op == 39)) {
        if ((instr.Src1.Kind == 2)) {
            flagName = instr.Src1.PhysReg;
        } else {
            if ((instr.Src1.Kind == 5)) {
                flagName = instr.Src1.Label;
            }
        }
    } else {
        if ((instr.Dst.Kind == 2)) {
            flagName = instr.Dst.PhysReg;
        } else {
            if ((instr.Dst.Kind == 5)) {
                flagName = instr.Dst.Label;
            }
        }
    }
    if ((instr.Op == 39)) {
        let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, copy_CodegenOperand(instr.Dst), "x10");
        let cond: str = codegen_flagNameToCondition(flagName);
        if ((cond != "")) {
            w.append(("    cset " + dst + ", " + cond + "\n"));
        } else {
            w.append(("    // getflag: unrecognised flag " + runtime_quote(flagName) + "\n"));
            w.append(("    mov " + dst + ", #0\n"));
        }
        codegen_arm64Emitter_spillIfNeeded(e, fn_value, copy_CodegenOperand(instr.Dst), dst);
    } else {
        w.append(("    // setflag " + runtime_quote(flagName) + " not directly supported on ARM64\n"));
    }
}

// flagNameToCondition maps Novus flag names to ARM64 condition suffixes
// usable with cset. The condition is TRUE when the flag IS set.
fn codegen_flagNameToCondition(name: str) -> str {
    {
        let choice_196: str = name;
        if ((choice_196 == "c") || (choice_196 == "carry") || (choice_196 == "cs") || (choice_196 == "cf")) {
            return "cs";
        } else if ((choice_196 == "z") || (choice_196 == "zero") || (choice_196 == "zero_flag")) {
            return "eq";
        } else if ((choice_196 == "n") || (choice_196 == "negative") || (choice_196 == "negative_flag")) {
            return "mi";
        } else if ((choice_196 == "v") || (choice_196 == "overflow") || (choice_196 == "overflow_flag")) {
            return "vs";
        }
    }
    return "";
}

// emitStrCmpEq emits an inline byte-by-byte string comparison.
// dst = 1 if strings are equal, 0 otherwise.
fn codegen_arm64Emitter_emitStrCmpEq(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let src1: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src1), "x13");
    let src2: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src2), "x14");
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, copy_CodegenOperand(instr.Dst), "x10");
    let id: i32 = codegen_arm64Emitter_uniqueID(e);
    let loopLabel: str = (".Lstrcmp_loop_" + runtime_string_i32(id));
    let neLabel: str = (".Lstrcmp_ne_" + runtime_string_i32(id));
    let eqLabel: str = (".Lstrcmp_eq_" + runtime_string_i32(id));
    let endLabel: str = (".Lstrcmp_end_" + runtime_string_i32(id));
    if ((src1 != "x13")) {
        w.append(("    mov x13, " + src1 + "\n"));
    }
    if ((src2 != "x14")) {
        w.append(("    mov x14, " + src2 + "\n"));
    }
    w.append((loopLabel + ":\n"));
    w.append("    ldrb w15, [x13], #1\n");
    w.append("    ldrb w16, [x14], #1\n");
    w.append("    cmp w15, w16\n");
    w.append(("    b.ne " + neLabel + "\n"));
    w.append(("    cbz w15, " + eqLabel + "\n"));
    w.append(("    b " + loopLabel + "\n"));
    w.append((neLabel + ":\n"));
    w.append(("    mov " + dst + ", #0\n"));
    w.append(("    b " + endLabel + "\n"));
    w.append((eqLabel + ":\n"));
    w.append(("    mov " + dst + ", #1\n"));
    w.append((endLabel + ":\n"));
    codegen_arm64Emitter_spillIfNeeded(e, fn_value, copy_CodegenOperand(instr.Dst), dst);
}

fn codegen_arm64Emitter_emitLoadMem(e: CodegenArm64Emitter, dst: str, baseName: str, offset: i32) -> void {
    let w: StringBuilder = e.b;
    let base: str = codegen_arm64Emitter_armBaseReg(e, baseName);
    if (((offset >= -256) && (offset <= 255))) {
        w.append(("    ldur " + dst + ", [" + base + ", #" + runtime_string_i32(offset) + "]\n"));
    } else {
        if ((((offset >= 0) && (offset <= 32760)) && ((offset % 8) == 0))) {
            w.append(("    ldr " + dst + ", [" + base + ", #" + runtime_string_i32(offset) + "]\n"));
        } else {
            codegen_arm64Emitter_loadImm(e, "x17", runtime_to_i64(offset));
            w.append(("    ldr " + dst + ", [" + base + ", x17]\n"));
        }
    }
}

fn codegen_arm64Emitter_emitStoreMem(e: CodegenArm64Emitter, src: str, baseName: str, offset: i32) -> void {
    let w: StringBuilder = e.b;
    let base: str = codegen_arm64Emitter_armBaseReg(e, baseName);
    if (((offset >= -256) && (offset <= 255))) {
        w.append(("    stur " + src + ", [" + base + ", #" + runtime_string_i32(offset) + "]\n"));
    } else {
        if ((((offset >= 0) && (offset <= 32760)) && ((offset % 8) == 0))) {
            w.append(("    str " + src + ", [" + base + ", #" + runtime_string_i32(offset) + "]\n"));
        } else {
            codegen_arm64Emitter_loadImm(e, "x17", runtime_to_i64(offset));
            w.append(("    str " + src + ", [" + base + ", x17]\n"));
        }
    }
}

fn codegen_arm64Emitter_loadStringAddr(e: CodegenArm64Emitter, dst: str, idx: i32) -> void {
    codegen_arm64Emitter_emitLoadGlobal(e, dst, codegen_Target_Sym(e.target, e.mod.Strings[idx].Label));
}

// emitMove avoids using an unrelated physical register as an intermediate
// when the destination is itself a physical register. This keeps values that
// raw syscall/API setup code has already placed in x9-x17 intact.
fn codegen_arm64Emitter_emitMove(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, dst: CodegenOperand, src: CodegenOperand) -> void {
    if ((dst.Kind != 2)) {
        let dstReg: str = codegen_arm64Emitter_dstReg(e, fn_value, copy_CodegenOperand(dst), "x10");
        if ((src.Kind == 3)) {
            codegen_arm64Emitter_loadImm(e, dstReg, src.Imm);
        } else {
            let srcReg: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(src), "x11");
            e.b.append(("    mov " + dstReg + ", " + srcReg + "\n"));
        }
        codegen_arm64Emitter_spillIfNeeded(e, fn_value, copy_CodegenOperand(dst), dstReg);
        return;
    }
    let dstReg: str = codegen_arm64Emitter_mapPhysReg(e, dst.PhysReg);
    {
        let choice_197: i32 = src.Kind;
        if ((choice_197 == 2)) {
            let srcReg: str = codegen_arm64Emitter_mapPhysReg(e, src.PhysReg);
            if ((srcReg != dstReg)) {
                e.b.append(("    mov " + dstReg + ", " + srcReg + "\n"));
            }
        } else if ((choice_197 == 3)) {
            codegen_arm64Emitter_loadImm(e, dstReg, src.Imm);
        } else if ((choice_197 == 1)) {
            codegen_arm64Emitter_emitLoadMem(e, dstReg, "x29", codegen_arm64Emitter_vregOffset(e, fn_value, src.Reg));
        } else if ((choice_197 == 4)) {
            codegen_arm64Emitter_loadStringAddr(e, dstReg, runtime_to_i32(src.Imm));
        } else if ((choice_197 == 6)) {
            codegen_arm64Emitter_emitLoadMem(e, dstReg, src.MemBase, runtime_to_i32(src.MemOffset));
        } else if ((choice_197 == 5)) {
            e.b.append(("    mov " + dstReg + ", " + src.Label + "\n"));
        }
    }
}

// ensureReg returns the register name for an operand.
// For VRegs: loads from stack into scratch; for imm: loads into scratch.
fn codegen_arm64Emitter_ensureReg(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, op: CodegenOperand, scratch: str) -> str {
    {
        let choice_198: i32 = op.Kind;
        if ((choice_198 == 2)) {
            return codegen_arm64Emitter_mapPhysReg(e, op.PhysReg);
        } else if ((choice_198 == 1)) {
            let off: i32 = codegen_arm64Emitter_vregOffset(e, fn_value, op.Reg);
            codegen_arm64Emitter_emitLoadMem(e, scratch, "x29", off);
            return scratch;
        } else if ((choice_198 == 3)) {
            codegen_arm64Emitter_loadImm(e, scratch, op.Imm);
            return scratch;
        } else if ((choice_198 == 4)) {
            codegen_arm64Emitter_loadStringAddr(e, scratch, runtime_to_i32(op.Imm));
            return scratch;
        } else if ((choice_198 == 6)) {
            codegen_arm64Emitter_emitLoadMem(e, scratch, op.MemBase, runtime_to_i32(op.MemOffset));
            return scratch;
        } else if ((choice_198 == 5)) {
            return op.Label;
        }
    }
    return scratch;
}

fn codegen_arm64Emitter_loadToReg(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, op: CodegenOperand, scratch: str) -> str {
    return codegen_arm64Emitter_ensureReg(e, fn_value, copy_CodegenOperand(op), scratch);
}

fn codegen_arm64Emitter_spillIfNeeded(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, op: CodegenOperand, reg: str) -> void {
    if ((op.Kind == 1)) {
        let off: i32 = codegen_arm64Emitter_vregOffset(e, fn_value, op.Reg);
        codegen_arm64Emitter_emitStoreMem(e, reg, "x29", off);
    }
}

fn codegen_arm64Emitter_loadImm(e: CodegenArm64Emitter, reg: str, val: i64) -> void {
    let w: StringBuilder = e.b;
    if (((val >= 0) && (val <= 65535))) {
        w.append(("    mov " + reg + ", #" + runtime_string_i64(val) + "\n"));
    } else {
        if (((val >= -65536) && (val < 0))) {
            w.append(("    mov " + reg + ", #" + runtime_string_i64(val) + "\n"));
        } else {
            let uval: u64 = runtime_to_u64(val);
            w.append(("    movz " + reg + ", #" + runtime_string_u64((uval & 65535)) + ", lsl #0\n"));
            if (((((uval >> 16)) & 65535) != 0)) {
                w.append(("    movk " + reg + ", #" + runtime_string_u64((((uval >> 16)) & 65535)) + ", lsl #16\n"));
            }
            if (((((uval >> 32)) & 65535) != 0)) {
                w.append(("    movk " + reg + ", #" + runtime_string_u64((((uval >> 32)) & 65535)) + ", lsl #32\n"));
            }
            if (((((uval >> 48)) & 65535) != 0)) {
                w.append(("    movk " + reg + ", #" + runtime_string_u64((((uval >> 48)) & 65535)) + ", lsl #48\n"));
            }
        }
    }
}

fn codegen_arm64Emitter_mapPhysReg(e: CodegenArm64Emitter, name: str) -> str {
    if ((((e.target != null) && (e.target.OS == 1)) && (name == "r8"))) {
        return "x16";
    }
    let map_199: MapStrStr = new MapStrStr();
    MapStrStr_put(map_199, "eax", "x0");
    MapStrStr_put(map_199, "ebx", "x1");
    MapStrStr_put(map_199, "ecx", "x2");
    MapStrStr_put(map_199, "edx", "x3");
    MapStrStr_put(map_199, "esi", "x4");
    MapStrStr_put(map_199, "edi", "x5");
    MapStrStr_put(map_199, "ebp", "x29");
    MapStrStr_put(map_199, "esp", "sp");
    MapStrStr_put(map_199, "rax", "x0");
    MapStrStr_put(map_199, "rbx", "x1");
    MapStrStr_put(map_199, "rcx", "x2");
    MapStrStr_put(map_199, "rdx", "x3");
    MapStrStr_put(map_199, "rsi", "x4");
    MapStrStr_put(map_199, "rdi", "x5");
    MapStrStr_put(map_199, "rbp", "x29");
    MapStrStr_put(map_199, "rsp", "sp");
    MapStrStr_put(map_199, "r8", "x8");
    MapStrStr_put(map_199, "r9", "x9");
    MapStrStr_put(map_199, "r10", "x10");
    MapStrStr_put(map_199, "r11", "x11");
    MapStrStr_put(map_199, "r12", "x12");
    MapStrStr_put(map_199, "r13", "x13");
    MapStrStr_put(map_199, "r14", "x14");
    MapStrStr_put(map_199, "r15", "x15");
    let mapping: MapStrStr = map_199;
    {
        let mapped: str = MapStrStr_get(mapping, name);
        let ok: bool = MapStrStr_has(mapping, name);
        if (ok) {
            return mapped;
        }
    }
    return name;
}

fn codegen_arm64Emitter_armBaseReg(e: CodegenArm64Emitter, name: str) -> str {
    if ((name == "")) {
        return "x29";
    }
    return codegen_arm64Emitter_mapPhysReg(e, name);
}

// dstReg returns the register name for a destination operand WITHOUT
// pre-loading the current value.  Use this for output operands that are
// about to be overwritten — avoids a useless memory load per instruction.
fn codegen_arm64Emitter_dstReg(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, op: CodegenOperand, scratch: str) -> str {
    {
        let choice_200: i32 = op.Kind;
        if ((choice_200 == 2)) {
            return codegen_arm64Emitter_mapPhysReg(e, op.PhysReg);
        } else if ((choice_200 == 1)) {
            return scratch;
        }
    }
    return scratch;
}

fn codegen_isCmpOp(op: i32) -> bool {
    {
        let choice_201: i32 = op;
        if ((choice_201 == 21) || (choice_201 == 22) || (choice_201 == 23) || (choice_201 == 24) || (choice_201 == 25) || (choice_201 == 26) || (choice_201 == 75) || (choice_201 == 76) || (choice_201 == 77) || (choice_201 == 78)) {
            return true;
        }
    }
    return false;
}

fn codegen_canFuseCmpBranch(cmpInstr: CodegenIRInstr, brInstr: CodegenIRInstr, vregUses: MapI32I32) -> bool {
    if (((brInstr.Op != 28) && (brInstr.Op != 29))) {
        return false;
    }
    if (((cmpInstr.Dst.Kind != 1) || (brInstr.Src1.Kind != 1))) {
        return false;
    }
    if ((cmpInstr.Dst.Reg != brInstr.Src1.Reg)) {
        return false;
    }
    return (MapI32I32_get(vregUses, cmpInstr.Dst.Reg) == 1);
}

// cmpCondForOp returns the ARM64 condition code for a comparison opcode.
fn codegen_cmpCondForOp(op: i32) -> str {
    {
        let choice_202: i32 = op;
        if ((choice_202 == 21)) {
            return "eq";
        } else if ((choice_202 == 22)) {
            return "ne";
        } else if ((choice_202 == 23)) {
            return "lt";
        } else if ((choice_202 == 24)) {
            return "le";
        } else if ((choice_202 == 25)) {
            return "gt";
        } else if ((choice_202 == 26)) {
            return "ge";
        } else if ((choice_202 == 75)) {
            return "lo";
        } else if ((choice_202 == 76)) {
            return "ls";
        } else if ((choice_202 == 77)) {
            return "hi";
        } else if ((choice_202 == 78)) {
            return "hs";
        }
    }
    return "eq";
}

// invertCond flips an ARM64 condition code.
fn codegen_invertCond(cond: str) -> str {
    {
        let choice_203: str = cond;
        if ((choice_203 == "eq")) {
            return "ne";
        } else if ((choice_203 == "ne")) {
            return "eq";
        } else if ((choice_203 == "lt")) {
            return "ge";
        } else if ((choice_203 == "le")) {
            return "gt";
        } else if ((choice_203 == "gt")) {
            return "le";
        } else if ((choice_203 == "ge")) {
            return "lt";
        } else if ((choice_203 == "lo")) {
            return "hs";
        } else if ((choice_203 == "hs")) {
            return "lo";
        } else if ((choice_203 == "ls")) {
            return "hi";
        } else if ((choice_203 == "hi")) {
            return "ls";
        }
    }
    return cond;
}

// emitFusedCmpBranch emits a compare instruction followed directly by a
// conditional branch, eliminating the cset / spill / reload / cbz overhead.
fn codegen_arm64Emitter_emitFusedCmpBranch(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, cmpInstr: CodegenIRInstr, brInstr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let src1: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(cmpInstr.Src1), "x11");
    if ((((cmpInstr.Src2.Kind == 3) && (cmpInstr.Src2.Imm >= 0)) && (cmpInstr.Src2.Imm <= 4095))) {
        w.append(("    cmp " + src1 + ", #" + runtime_string_i64(cmpInstr.Src2.Imm) + "\n"));
    } else {
        let src2: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(cmpInstr.Src2), "x12");
        w.append(("    cmp " + src1 + ", " + src2 + "\n"));
    }
    let cond: str = codegen_cmpCondForOp(cmpInstr.Op);
    if ((brInstr.Op == 29)) {
        cond = codegen_invertCond(cond);
    }
    w.append(("    b." + cond + " " + brInstr.Dst.Label + "\n"));
}

// peepholeARM64 performs a single pass over the emitted assembly lines and
// eliminates (or replaces) redundant store-then-load sequences:
//
//	stur xN, [x29, #-K]    →  (keep store)
//	ldur xN, [x29, #-K]    →  (eliminate — xN already has the value)
//
//	stur xN, [x29, #-K]    →  (keep store)
//	ldur xM, [x29, #-K]    →  mov xM, xN  (cheaper than a memory load)
fn codegen_peepholeARM64(asm: str) -> str {
    let lines: []str = runtime_strings_Split(asm, "\n");
    let result: []str = array_Str(0);
    {
        let i: i32 = 0;
        for (; (i < len(lines)); i++) {
            if (((i + 1) < len(lines))) {
                let result_204: ResultStrStrBool = codegen_parseARM64MemOp(lines[i], true);
                let stReg: str = result_204.value0;
                let stMem: str = result_204.value1;
                let isSt: bool = result_204.value2;
                let result_205: ResultStrStrBool = codegen_parseARM64MemOp(lines[(i + 1)], false);
                let ldReg: str = result_205.value0;
                let ldMem: str = result_205.value1;
                let isLd: bool = result_205.value2;
                if (((isSt && isLd) && (stMem == ldMem))) {
                    result = append_Str(result, lines[i]);
                    if ((stReg != ldReg)) {
                        result = append_Str(result, ("    mov " + ldReg + ", " + stReg));
                    }
                    i++;
                    continue;
                }
            }
            result = append_Str(result, lines[i]);
        }
    }
    return runtime_strings_Join(result, "\n");
}

// parseARM64MemOp extracts register and memory-reference from a store or load
// instruction.  isStore=true matches stur/str, isStore=false matches ldur/ldr.
fn codegen_parseARM64MemOp(line: str, isStore: bool) -> ResultStrStrBool {
    let reg: str = "";
    let mem: str = "";
    let ok: bool = false;
    let trimmed: str = runtime_strings_TrimSpace(line);
    let prefixes: []str = [];
    if (isStore) {
        prefixes = ["stur ", "str "];
    } else {
        prefixes = ["ldur ", "ldr "];
    }
    {
        let items_206: []str = prefixes;
        let count_208: i32 = len(items_206);
        for (let index_207: i32 = 0; index_207 < count_208; index_207++) {
            let prefix: str = items_206[index_207];
            if (runtime_strings_HasPrefix(trimmed, prefix)) {
                let rest: str = runtime_substring(trimmed, len(prefix), len(trimmed));
                let idx: i32 = runtime_strings_Index(rest, ", [");
                if ((idx >= 0)) {
                    reg = runtime_strings_TrimSpace(runtime_substring(rest, 0, idx));
                    mem = runtime_strings_TrimSpace(runtime_substring(rest, (idx + 2), len(rest)));
                    return make_ResultStrStrBool(reg, mem, true);
                }
            }
        }
    }
    return make_ResultStrStrBool("", "", false);
}

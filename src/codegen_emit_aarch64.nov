fn codegen_arm64Emitter_emitBinOp(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr, mnemonic: str) -> void {
    let w: StringBuilder = e.b;
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, copy_CodegenOperand(instr.Dst), "x10");
    let src1: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src1), "x11");
    if ((instr.Src2.Kind == 3)) {
        let imm: i64 = instr.Src2.Imm;
        let mn: str = mnemonic;
        if (((mn == "sub") && (imm < 0))) {
            imm = -(imm);
            mn = "add";
        } else {
            if (((mn == "add") && (imm < 0))) {
                imm = -(imm);
                mn = "sub";
            }
        }
        if ((((((mn == "add") || (mn == "sub"))) && (imm >= 0)) && (imm <= 4095))) {
            w.append(("    " + mn + " " + dst + ", " + src1 + ", #" + runtime_string_i64(imm) + "\n"));
            codegen_arm64Emitter_spillIfNeeded(e, fn_value, copy_CodegenOperand(instr.Dst), dst);
            return;
        }
    }
    let src2: str = codegen_arm64Emitter_loadToReg(e, fn_value, copy_CodegenOperand(instr.Src2), "x12");
    w.append(("    " + mnemonic + " " + dst + ", " + src1 + ", " + src2 + "\n"));
    codegen_arm64Emitter_spillIfNeeded(e, fn_value, copy_CodegenOperand(instr.Dst), dst);
}


// emitLoadGlobal emits an adrp+add pair to load the address of a global
// symbol into dstReg, handling Darwin vs Linux page-offset syntax.
fn codegen_arm64Emitter_emitLoadGlobal(e: CodegenArm64Emitter, dstReg: str, sym: str) -> void {
    let w: StringBuilder = e.b;
    if ((e.target.OS == 1)) {
        w.append("    adrp ");
        w.append(dstReg);
        w.append(", ");
        w.append(sym);
        w.append("@PAGE\n    add ");
        w.append(dstReg);
        w.append(", ");
        w.append(dstReg);
        w.append(", ");
        w.append(sym);
        w.append("@PAGEOFF\n");
    } else {
        w.append("    adrp ");
        w.append(dstReg);
        w.append(", ");
        w.append(sym);
        w.append("\n    add ");
        w.append(dstReg);
        w.append(", ");
        w.append(dstReg);
        w.append(", :lo12:");
        w.append(sym);
        w.append("\n");
    }
}

// emitMmapSyscall emits an mmap(NULL, 256MB, PROT_READ|PROT_WRITE,
// MAP_PRIVATE|MAP_ANON, -1, 0) system call.  Result in x0.
// Clobbers x0-x5 and the syscall-number register (x16 Darwin, x8 Linux).
fn codegen_arm64Emitter_emitMmapSyscall(e: CodegenArm64Emitter) -> void {
    let w: StringBuilder = e.b;
    w.append("    mov x0, #0\n    mov x1, #256\n    lsl x1, x1, #20\n    mov x2, #3\n");
    if ((e.target.OS == 1)) {
        w.append("    mov x3, #0x1002\n    mov x4, #-1\n    mov x5, #0\n    mov x16, #197\n    svc #0x80\n");
    } else {
        w.append("    mov x3, #0x22\n    mov x4, #-1\n    mov x5, #0\n    mov x8, #222\n    svc #0\n");
    }
}

// emitHeapAllocator emits the _novus_heap_alloc runtime function.
// It provides a mmap-backed bump allocator that automatically grows by
// requesting new 256 MB virtual-memory regions from the kernel when the
// current region is exhausted.  Only pages actually touched consume
// physical RAM (demand-paged by the OS), so reserving a large region is
// essentially free.
//
//	Input:  x0 = requested size in bytes
//	Output: x0 = pointer to allocated block (8-byte aligned)
//	Clobbers: x0-x5, x9-x16 (caller-saved)
fn codegen_arm64Emitter_emitHeapAllocator(e: CodegenArm64Emitter) -> void {
    if ((e.target.OS == 2)) {
        codegen_arm64Emitter_emitWindowsHeapAllocator(e);
        return;
    }
    let w: StringBuilder = e.b;
    let allocSym: str = codegen_Target_Sym(e.target, "_novus_heap_alloc");
    let heapPtrSym: str = codegen_Target_Sym(e.target, "_novus_heap_ptr");
    let heapEndSym: str = codegen_Target_Sym(e.target, "_novus_heap_end");
    w.append("\n// ---- Runtime: mmap-backed heap allocator ----\n.p2align 2\n");
    w.append(allocSym);
    w.append(":\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n    add x0, x0, #7\n    bic x0, x0, #7\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x9", heapPtrSym);
    w.append("    ldr x10, [x9]\n    cbz x10, .Lhalloc_init\n.Lhalloc_try:\n    add x11, x10, x0\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x12", heapEndSym);
    w.append("    ldr x13, [x12]\n    cmp x11, x13\n    b.hi .Lhalloc_grow\n    str x11, [x9]\n    mov x0, x10\n    ldp x29, x30, [sp], #16\n    ret\n.Lhalloc_init:\n    stp x0, x9, [sp, #-16]!\n");
    codegen_arm64Emitter_emitMmapSyscall(e);
    w.append("    mov x10, x0\n    ldp x0, x9, [sp], #16\n    str x10, [x9]\n    mov x14, #256\n    lsl x14, x14, #20\n    add x14, x10, x14\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x12", heapEndSym);
    w.append("    str x14, [x12]\n    b .Lhalloc_try\n.Lhalloc_grow:\n    str x0, [sp, #-16]!\n");
    codegen_arm64Emitter_emitMmapSyscall(e);
    w.append("    mov x10, x0\n    ldr x0, [sp], #16\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x9", heapPtrSym);
    w.append("    str x10, [x9]\n    mov x14, #256\n    lsl x14, x14, #20\n    add x14, x10, x14\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x12", heapEndSym);
    w.append("    str x14, [x12]\n    b .Lhalloc_try\n\n");
}

// emitGCRuntime emits the garbage collector runtime:
//   - _novus_gc_register: register an allocation in the GC table
//   - _novus_gc_collect: conservative mark-sweep collection
//   - _novus_gc_alloc: allocate with GC integration (free-list + auto-collect)
//
// GC table entry layout (24 bytes each):
//
//	[0]  ptr  — pointer to allocated block
//	[8]  size — allocation size in bytes
//	[16] mark — 0 = unmarked, 1 = marked
//
// Free list: singly-linked list of freed blocks. Each freed block has:
//
//	[0] next_ptr — pointer to next free block (0 = end)
//	[8] size     — size of this free block
fn codegen_arm64Emitter_emitGCRuntime(e: CodegenArm64Emitter) -> void {
    let w: StringBuilder = e.b;
    let gcTable: str = codegen_Target_Sym(e.target, "_novus_gc_table");
    let gcCount: str = codegen_Target_Sym(e.target, "_novus_gc_count");
    let gcThreshold: str = codegen_Target_Sym(e.target, "_novus_gc_threshold");
    let gcFreelist: str = codegen_Target_Sym(e.target, "_novus_gc_freelist");
    let allocSym: str = codegen_Target_Sym(e.target, "_novus_heap_alloc");
    let gcAllocSym: str = codegen_Target_Sym(e.target, "_novus_gc_alloc");
    let gcRegSym: str = codegen_Target_Sym(e.target, "_novus_gc_register");
    let gcCollectSym: str = codegen_Target_Sym(e.target, "_novus_gc_collect");
    w.append("\n// ---- GC: register allocation ----\n.p2align 2\n");
    w.append(gcRegSym);
    w.append(":\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x9", gcCount);
    w.append("    ldr x10, [x9]\n");
    codegen_arm64Emitter_loadImm(e, "x11", runtime_to_i64(e.target.GCEntries));
    w.append("    cmp x10, x11\n    b.lt .Lgcreg_space\n    brk #1\n.Lgcreg_space:\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x12", gcTable);
    w.append("    mov x13, #24\n    mul x14, x10, x13\n    add x12, x12, x14\n    str x0, [x12, #0]\n    str x1, [x12, #8]\n    str xzr, [x12, #16]\n    add x10, x10, #1\n    str x10, [x9]\n.Lgcreg_done:\n    ldp x29, x30, [sp], #16\n    ret\n");
    codegen_arm64Emitter_emitFastCollector(e);
    w.append("\n// ---- GC: allocator with free-list and auto-collection ----\n.p2align 2\n");
    w.append(gcAllocSym);
    w.append(":\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n    stp x19, x20, [sp, #-16]!\n    add x0, x0, #7\n    bic x0, x0, #7\n    cmp x0, #16\n    b.ge .Lgca_size_ok\n    mov x0, #16\n.Lgca_size_ok:\n    bl ");
    w.append(codegen_Target_Sym(e.target, "_novus_gc_round"));
    w.append("\n    mov x19, x0\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x9", gcCount);
    w.append("    ldr x10, [x9]\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x9", gcThreshold);
    w.append("    ldr x11, [x9]\n    cmp x10, x11\n    b.ge .Lgca_collect\n");
    codegen_arm64Emitter_loadImm(e, "x12", runtime_to_i64(e.target.GCEntries));
    w.append("    cmp x10, x12\n    b.lt .Lgca_try_free\n.Lgca_collect:\n    bl ");
    w.append(gcCollectSym);
    w.append("\n.Lgca_try_free:\n");
    codegen_arm64Emitter_emitLoadGlobal(e, "x0", gcFreelist);
    w.append("    mov x1, x19\n    bl ");
    w.append(codegen_Target_Sym(e.target, "_novus_gc_take"));
    w.append("\n    cbz x0, .Lgca_bump\n    mov x20, x0\n    mov x1, x19\n    bl ");
    w.append(gcRegSym);
    w.append("\n    mov x0, x20\n    b .Lgca_ret\n.Lgca_bump:\n    mov x0, x19\n    bl ");
    w.append(allocSym);
    w.append("\n    mov x20, x0\n    mov x1, x19\n    bl ");
    w.append(gcRegSym);
    w.append("\n    mov x0, x20\n.Lgca_ret:\n    ldp x19, x20, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n");
}

// emitArrayNew allocates a new array header + data on the heap.
// Dst = pointer to header. Src1 = elem_size (imm, always 8). Src2 = initial cap (imm).
fn codegen_arm64Emitter_emitArrayNew(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, instr.Dst, "x10");
    let cap: i64 = instr.Src2.Imm;

    w.append(len2Label);
    w.append("\n");
    w.append(len2Done);
    w.append(":\n    add x0, x9, x15\n    add x0, x0, #1\n    stp x13, x14, [sp, #-16]!\n    stp x9, x15, [sp, #-16]!\n    bl ");
    w.append(allocSym);
    w.append("\n    ldp x9, x15, [sp], #16\n    ldp x13, x14, [sp], #16\n    mov x12, x0\n    mov x11, x0\n");
    w.append(copy1Label);
    w.append(":\n    ldrb w16, [x13], #1\n    cbz w16, ");
    w.append(copy2Label);
    w.append("\n    strb w16, [x11], #1\n    b ");
    w.append(copy1Label);
    w.append("\n");
    w.append(copy2Label);
    w.append(":\n    ldrb w16, [x14], #1\n    strb w16, [x11], #1\n    cbnz w16, ");
    w.append(copy2Label);
    w.append("\n    mov ");

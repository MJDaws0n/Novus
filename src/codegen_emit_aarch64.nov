fn codegen_arm64Emitter_emitStrConcat(e: CodegenArm64Emitter, fn_value: CodegenIRFunc, instr: CodegenIRInstr) -> void {
    let w: StringBuilder = e.b;
    let src1: str = codegen_arm64Emitter_loadToReg(e, fn_value, instr.Src1, "x13");
    let src2: str = codegen_arm64Emitter_loadToReg(e, fn_value, instr.Src2, "x14");
    let dst: str = codegen_arm64Emitter_dstReg(e, fn_value, instr.Dst, "x10");
    let id: i32 = codegen_arm64Emitter_uniqueID(e);
    let len1Label: str = (".Lscl1_" + runtime_string_i32(id));
    let len1Done: str = (".Lscl1d_" + runtime_string_i32(id));
    let len2Label: str = (".Lscl2_" + runtime_string_i32(id));
    let len2Done: str = (".Lscl2d_" + runtime_string_i32(id));
    let copy1Label: str = (".Lsc1_" + runtime_string_i32(id));
    let copy2Label: str = (".Lsc2_" + runtime_string_i32(id));
    let allocSym: str = codegen_Target_Sym(e.target, "_novus_gc_alloc");
    if ((src1 != "x13")) {
        w.append("    mov x13, ");
        w.append(src1);
        w.append("\n");
    }
    if ((src2 != "x14")) {
        w.append("    mov x14, ");
        w.append(src2);
        w.append("\n");
    }
    w.append("    mov x15, #0\n");
    w.append(len1Label);
    w.append(":\n    ldrb w16, [x13, x15]\n    cbz w16, ");
    w.append(len1Done);
    w.append("\n    add x15, x15, #1\n    b ");
    w.append(len1Label);
    w.append("\n");
    w.append(len1Done);
    w.append(":\n    mov x9, x15\n    mov x15, #0\n");
    w.append(len2Label);
    w.append(":\n    ldrb w16, [x14, x15]\n    cbz w16, ");
    w.append(len2Done);
